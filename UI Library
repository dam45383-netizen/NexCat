-- ---------- Slider ----------
function Container:Slider(cfg)
	cfg = cfg or {}
	local v = cfg.Value
	local min, max, default
	if type(v) == "table" then
		min, max, default = v.Min, v.Max, v.Default
	else
		min, max, default = cfg.Min, cfg.Max, v or cfg.Default
	end
	min = min or 0
	max = max or 100
	if max < min then
		min, max = max, min
	end
	default = default or min
	local step = cfg.Step or cfg.Increment or 1
	if step <= 0 then
		step = 1
	end
	local suffix = cfg.Suffix or ""

	local decimals = 0
	local stepText = tostring(step)
	local dot = stepText:find("%.")
	local exponent = stepText:match("e%-(%d+)")
	if exponent then
		decimals = tonumber(exponent)
	elseif dot then
		decimals = #stepText - dot
	end

	local function snap(x)
		x = math.clamp(x, min, max)
		x = math.floor((x - min) / step + 0.5) * step + min
		x = math.clamp(x, min, max)
		return tonumber(string.format("%." .. decimals .. "f", x))
	end
	local function format(x)
		return string.format("%." .. decimals .. "f", x) .. suffix
	end

	local row, inner, header, title, desc, lock = Card(self, cfg, 64)
	local box = New("TextBox", {
		Name = "Value",
		Size = UDim2.fromOffset(64, 26),
		LayoutOrder = 2,
		Text = "",
		Font = FontOf("Medium"),
		TextSize = 13,
		ClearTextOnFocus = false,
		Theme = { TextColor3 = "Text" },
		Parent = header,
	})
	FieldStyle(box, 8)

	local barHolder = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 20),
		LayoutOrder = 2,
		Parent = inner,
	})
	local track = New("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(1, 0, 0, 6),
		Theme = { BackgroundColor3 = "Button" },
		Parent = barHolder,
	})
	Corner(track, 3)
	local fill = New("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		Theme = { BackgroundColor3 = "Toggle" },
		Parent = track,
	})
	Corner(fill, 3)
	local knob = New("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(14, 14),
		Theme = { BackgroundColor3 = "White" },
		Parent = track,
	})
	Corner(knob, 9)
	Stroke(knob, "Outline", 1, 0.75)

	local obj = { Type = "Slider", Min = min, Max = max }
	local value = snap(default)
	obj.Value = value

	local function render(duration)
		local alpha = (max == min) and 0 or (value - min) / (max - min)
		Tween(fill, { Size = UDim2.fromScale(alpha, 1) }, duration or 0.1)
		Tween(knob, { Position = UDim2.fromScale(alpha, 0.5) }, duration or 0.1)
		box.Text = format(value)
	end
	render(0)

	function obj:Set(x, silent)
		value = snap(tonumber(x) or value)
		obj.Value = value
		render()
		if not silent then
			Fire(cfg.Callback, value)
		end
	end
	function obj:Get()
		return value
	end

	box.FocusLost:Connect(function()
		local n = tonumber(box.Text:match("-?%d+%.?%d*"))
		if n then
			obj:Set(n)
		else
			render()
		end
	end)

	local scroll = self._scroll
	local hit = New("TextButton", {
		Name = "Hit",
		Size = UDim2.new(1, 16, 1, 0),
		Position = UDim2.fromOffset(-8, 0),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 3,
		Parent = barHolder,
	})
	Drag(hit, function(pos)
		local alpha = math.clamp((pos.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local new = snap(min + (max - min) * alpha)
		if new ~= value then
			value = new
			obj.Value = value
			render(0.06)
			Fire(cfg.Callback, value)
		end
	end, function()
		Tween(knob, { Size = UDim2.fromOffset(18, 18) }, 0.12)
		if scroll then
			scroll.ScrollingEnabled = false
		end
	end, function()
		Tween(knob, { Size = UDim2.fromOffset(14, 14) }, 0.12)
		if scroll then
			scroll.ScrollingEnabled = true
		end
	end, true)

	return Finish(self, cfg, obj, row, title, desc, lock)
end

-- ---------- Input (Type = "Input" | "Textarea") ----------
function Container:Input(cfg)
	cfg = cfg or {}
	local row, inner, _, title, desc, lock = Card(self, cfg, nil, false)
	local multiline = cfg.Type == "Textarea" or cfg.Multiline == true

	local holder = New("Frame", {
		Name = "Field",
		Size = UDim2.new(1, 0, 0, multiline and 90 or 34),
		LayoutOrder = 2,
		Parent = inner,
	})
	local stroke = FieldStyle(holder, 8)

	local iconSpace = 0
	if cfg.InputIcon then
		local inputIcon = MakeIcon(holder, cfg.InputIcon, 16, "Icon", cfg.IconThemed)
		if inputIcon then
			inputIcon.AnchorPoint = Vector2.new(0, multiline and 0 or 0.5)
			inputIcon.Position = UDim2.new(0, 10, multiline and 0 or 0.5, multiline and 9 or 0)
			iconSpace = 26
		end
	end

	local box = New("TextBox", {
		Name = "Input",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = cfg.Value or cfg.Default or "",
		PlaceholderText = cfg.Placeholder or cfg.PlaceholderText or "Ketik di sini...",
		ClearTextOnFocus = cfg.ClearTextOnFocus == true,
		MultiLine = multiline,
		TextWrapped = multiline,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = multiline and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
		Font = FontOf("Regular"),
		TextSize = 14,
		Theme = { TextColor3 = "Text", PlaceholderColor3 = "Placeholder" },
		Parent = holder,
	})
	Pad(box, multiline and 8 or 0, 10, multiline and 8 or 0, 10 + iconSpace)

	local obj = { Type = "Input", Value = box.Text }
	box.Focused:Connect(function()
		Tween(stroke, { Transparency = 0.55 }, 0.15)
	end)
	box.FocusLost:Connect(function()
		Tween(stroke, { Transparency = 0.9 }, 0.15)
		obj.Value = box.Text
		if not cfg.Live then
			Fire(cfg.Callback, box.Text)
		end
	end)
	box:GetPropertyChangedSignal("Text"):Connect(function()
		if cfg.Numeric then
			local cleaned = box.Text:gsub("[^%d%.%-]", "")
			if cleaned ~= box.Text then
				box.Text = cleaned
				return
			end
		end
		obj.Value = box.Text
		if cfg.Live then
			Fire(cfg.Callback, box.Text)
		end
	end)
	function obj:Set(value, silent)
		box.Text = tostring(value or "")
		obj.Value = box.Text
		if not silent and not cfg.Live then
			Fire(cfg.Callback, box.Text)
		end
	end
	function obj:Get()
		return box.Text
	end
	return Finish(self, cfg, obj, row, title, desc, lock)
end

-- ---------- Dropdown ----------
-- Values = { "A", "B" } atau { { Title = "A", Icon = "home", Callback = fn }, ... }
local function NormalizeValues(values)
	local list = {}
	for _, item in ipairs(values or {}) do
		if type(item) == "table" then
			local name = item.Title or item.Name or item.Value
			list[#list + 1] = {
				Value = name,
				Title = tostring(name),
				Icon = item.Icon,
				Callback = item.Callback,
			}
		else
			list[#list + 1] = { Value = item, Title = tostring(item) }
		end
	end
	return list
end

function Container:Dropdown(cfg)
	cfg = cfg or {}
	local window = self._window
	local multi = cfg.Multi == true
	local entries = NormalizeValues(cfg.Values)
	local sel = {}
	local init = cfg.Value
	if init == nil then
		init = cfg.Default
	end
	if multi then
		if type(init) == "table" then
			for _, item in ipairs(init) do
				sel[item] = true
			end
		end
	elseif init ~= nil then
		sel[init] = true
	end

	local row, _, header, title, desc, lock = Card(self, cfg, 150)
	local button = New("TextButton", {
		Name = "Select",
		Size = UDim2.fromOffset(150, 30),
		LayoutOrder = 2,
		Text = "",
		AutoButtonColor = false,
		Parent = header,
	})
	FieldStyle(button, 8)
	local label = Text(button, "", {
		Size = UDim2.new(1, -32, 1, 0),
		Position = UDim2.fromOffset(10, 0),
		TextSize = 14,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	Text(button, "▾", {
		Size = UDim2.fromOffset(18, 30),
		Position = UDim2.new(1, -24, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		Theme = { TextColor3 = "Icon" },
	})

	local obj = { Type = "Dropdown", Values = cfg.Values or {} }

	local function getValue()
		if multi then
			local out = {}
			for _, entry in ipairs(entries) do
				if sel[entry.Value] then
					out[#out + 1] = entry.Value
				end
			end
			return out
		end
		for _, entry in ipairs(entries) do
			if sel[entry.Value] then
				return entry.Value
			end
		end
		return nil
	end

	local function updateLabel()
		local current = getValue()
		local textValue
		if multi then
			local names = {}
			for _, item in ipairs(current) do
				names[#names + 1] = tostring(item)
			end
			textValue = #names > 0 and table.concat(names, ", ") or "Pilih..."
		else
			textValue = current ~= nil and tostring(current) or "Pilih..."
		end
		label.Text = textValue
		obj.Value = current
	end
	updateLabel()

	local function open()
		local count = #entries
		if count == 0 then
			return
		end
		local showSearch = cfg.Search == true or cfg.SearchBarEnabled == true or (cfg.Search == nil and count > 8)
		local top = showSearch and 44 or 0
		local listHeight = math.min(count * 36 + 8, 220)
		local width = math.max(button.AbsoluteSize.X, cfg.MenuWidth or 170)
		local popup = window:_OpenPopup(button, width, listHeight + top, true)

		local options = {}
		local function paint(option, hover)
			local selected = sel[option.entry.Value] == true
			option.check.Visible = selected
			option.button.BackgroundTransparency = selected and (hover and 0.84 or 0.9) or (hover and 0.93 or 1)
		end

		if showSearch then
			local search = New("TextBox", {
				Size = UDim2.new(1, -16, 0, 30),
				Position = UDim2.fromOffset(8, 7),
				Text = "",
				PlaceholderText = "Cari...",
				ClearTextOnFocus = false,
				Font = FontOf("Regular"),
				TextSize = 14,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 52,
				Theme = { TextColor3 = "Text", PlaceholderColor3 = "Placeholder" },
				Parent = popup,
			})
			FieldStyle(search, 8)
			Pad(search, 0, 10, 0, 10)
			search:GetPropertyChangedSignal("Text"):Connect(function()
				local q = search.Text:lower()
				for _, option in ipairs(options) do
					option.button.Visible = q == "" or option.entry.Title:lower():find(q, 1, true) ~= nil
				end
			end)
		end

		local scroller = New("ScrollingFrame", {
			Position = UDim2.fromOffset(0, top),
			Size = UDim2.new(1, 0, 1, -top),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			ScrollBarImageTransparency = 0.5,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ZIndex = 52,
			Theme = { ScrollBarImageColor3 = "Icon" },
			Parent = popup,
		})
		Pad(scroller, 4, 4, 4, 4)
		List(scroller, 2)

		for i, entry in ipairs(entries) do
			local optionButton = New("TextButton", {
				Size = UDim2.new(1, 0, 0, 34),
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				LayoutOrder = i,
				ZIndex = 53,
				Theme = { BackgroundColor3 = "Text" },
				Parent = scroller,
			})
			Corner(optionButton, 8)
			local textOffset = 10
			local optionIcon = MakeIcon(optionButton, entry.Icon, 16, "Icon")
			if optionIcon then
				optionIcon.AnchorPoint = Vector2.new(0, 0.5)
				optionIcon.Position = UDim2.new(0, 10, 0.5, 0)
				optionIcon.ZIndex = 54
				textOffset = 34
			end
			Text(optionButton, entry.Title, {
				Size = UDim2.new(1, -(textOffset + 28), 1, 0),
				Position = UDim2.fromOffset(textOffset, 0),
				TextSize = 14,
				TextTruncate = Enum.TextTruncate.AtEnd,
				ZIndex = 54,
			})
			local check = Text(optionButton, "✓", {
				Size = UDim2.fromOffset(20, 34),
				Position = UDim2.new(1, -26, 0, 0),
				TextXAlignment = Enum.TextXAlignment.Center,
				Weight = "Bold",
				ZIndex = 54,
				Visible = false,
			})
			local option = { entry = entry, button = optionButton, check = check }
			options[#options + 1] = option
			paint(option, false)

			optionButton.MouseEnter:Connect(function()
				paint(option, true)
			end)
			optionButton.MouseLeave:Connect(function()
				paint(option, false)
			end)
			optionButton.MouseButton1Click:Connect(function()
				local key = entry.Value
				if multi then
					sel[key] = not sel[key] or nil
				elseif sel[key] and cfg.AllowNone then
					sel = {}
				else
					sel = { [key] = true }
				end
				updateLabel()
				Fire(cfg.Callback, obj.Value)
				Fire(entry.Callback)
				if multi then
					for _, o in ipairs(options) do
						paint(o, o == option)
					end
				else
					window:_ClosePopup()
				end
			end)
		end
	end

	button.MouseButton1Click:Connect(open)

	function obj:Set(value, silent)
		sel = {}
		if multi then
			if type(value) == "table" then
				for _, item in ipairs(value) do
					sel[item] = true
				end
			end
		elseif value ~= nil then
			sel[value] = true
		end
		updateLabel()
		if not silent then
			Fire(cfg.Callback, obj.Value)
		end
	end
	function obj:Select(value, silent)
		obj:Set(value, silent)
	end
	function obj:Get()
		return obj.Value
	end
	function obj:Refresh(newValues, keepSelection)
		entries = NormalizeValues(newValues)
		obj.Values = newValues or {}
		if not keepSelection then
			local valid = {}
			for _, entry in ipairs(entries) do
				if sel[entry.Value] then
					valid[entry.Value] = true
				end
			end
			sel = valid
		end
		updateLabel()
	end
	return Finish(self, cfg, obj, row, title, desc, lock)
end

-- ---------- Keybind ----------
local function ToKeyCode(value)
	if typeof(value) == "EnumItem" then
		return value
	end
	if type(value) == "string" then
		local ok, key = pcall(function()
			return Enum.KeyCode[value]
		end)
		if ok then
			return key
		end
	end
	return nil
end

function Container:Keybind(cfg)
	cfg = cfg or {}
	local row, _, header, title, desc, lock = Card(self, cfg, 96)
	local key = ToKeyCode(cfg.Value or cfg.Default)
	local listening = false

	local button = New("TextButton", {
		Name = "Key",
		Size = UDim2.fromOffset(96, 30),
		LayoutOrder = 2,
		Text = "",
		AutoButtonColor = false,
		Parent = header,
	})
	local stroke = FieldStyle(button, 8)
	local label = Text(button, key and key.Name or "None", {
		Size = UDim2.fromScale(1, 1),
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})

	local obj = { Type = "Keybind", Value = key }
	local function render()
		label.Text = listening and "..." or (key and key.Name or "None")
		Tween(stroke, { Transparency = listening and 0.5 or 0.9 }, 0.15)
	end

	button.MouseButton1Click:Connect(function()
		listening = true
		render()
	end)

	self._window:_Connect(UserInputService.InputBegan, function(input, processed)
		if listening then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				listening = false
				if input.KeyCode == Enum.KeyCode.Backspace then
					key = nil
				elseif input.KeyCode ~= Enum.KeyCode.Escape then
					key = input.KeyCode
				end
				obj.Value = key
				render()
				Fire(cfg.Changed, key)
			end
			return
		end
		if not processed and key and input.KeyCode == key then
			Fire(cfg.Callback, key)
		end
	end)

	function obj:Set(value, silent)
		key = ToKeyCode(value)
		obj.Value = key
		render()
		if not silent then
			Fire(cfg.Changed, key)
		end
	end
	function obj:Get()
		return key
	end
	return Finish(self, cfg, obj, row, title, desc, lock)
end

-- ---------- Colorpicker (opsional: Transparency = 0..1 untuk slider alpha) ----------
local function ColorToHex(color)
	return string.format(
		"#%02X%02X%02X",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5)
	)
end

local function HexToColor(text)
	local hex = tostring(text):gsub("#", ""):match("^(%x%x%x%x%x%x)$")
	if not hex then
		return nil
	end
	return Color3.fromRGB(
		tonumber(hex:sub(1, 2), 16),
		tonumber(hex:sub(3, 4), 16),
		tonumber(hex:sub(5, 6), 16)
	)
end

function Container:Colorpicker(cfg)
	cfg = cfg or {}
	local window = self._window
	local row, _, header, title, desc, lock = Card(self, cfg, 46)
	local color = cfg.Value or cfg.Default or Color3.fromRGB(255, 255, 255)
	local hasAlpha = cfg.Transparency ~= nil
	local transparency = cfg.Transparency or 0
	local h, s, v = color:ToHSV()

	local swatch = New("TextButton", {
		Name = "Swatch",
		Size = UDim2.fromOffset(46, 26),
		LayoutOrder = 2,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = color,
		BackgroundTransparency = transparency,
		Parent = header,
	})
	Corner(swatch, 8)
	Stroke(swatch, "Outline", 1, 0.8)

	local obj = { Type = "Colorpicker", Value = color, Transparency = transparency }
	local ui -- referensi UI popup, nil kalau popup tertutup

	local function apply(fire)
		color = Color3.fromHSV(h, s, v)
		obj.Value = color
		obj.Transparency = transparency
		swatch.BackgroundColor3 = color
		swatch.BackgroundTransparency = transparency
		if ui then
			ui.sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
			ui.svCursor.Position = UDim2.fromScale(s, 1 - v)
			ui.hueCursor.Position = UDim2.fromScale(h, 0.5)
			ui.preview.BackgroundColor3 = color
			ui.preview.BackgroundTransparency = transparency
			if ui.alphaBar then
				ui.alphaBar.BackgroundColor3 = color
				ui.alphaCursor.Position = UDim2.fromScale(1 - transparency, 0.5)
			end
			if not ui.hex:IsFocused() then
				ui.hex.Text = ColorToHex(color)
			end
		end
		if fire then
			if hasAlpha then
				Fire(cfg.Callback, color, transparency)
			else
				Fire(cfg.Callback, color)
			end
		end
	end

	local function open()
		local hexY = hasAlpha and 184 or 166
		local popup = window:_OpenPopup(swatch, 236, hexY + 38, true)
		local scroll = self._scroll

		local sv = New("Frame", {
			Name = "SV",
			Position = UDim2.fromOffset(10, 10),
			Size = UDim2.fromOffset(216, 120),
			BorderSizePixel = 0,
			ZIndex = 52,
			Parent = popup,
		})
		Corner(sv, 8)
		local white = New("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 53,
			Parent = sv,
		})
		Corner(white, 8)
		New("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = white })
		local black = New("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
			ZIndex = 54,
			Parent = sv,
		})
		Corner(black, 8)
		New("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = black })
		local svCursor = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(12, 12),
			BackgroundTransparency = 1,
			ZIndex = 56,
			Parent = sv,
		})
		Corner(svCursor, 6)
		New("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = svCursor })
		local svHit = New("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 57,
			Parent = sv,
		})

		local hue = New("Frame", {
			Name = "Hue",
			Position = UDim2.fromOffset(10, 140),
			Size = UDim2.fromOffset(216, 12),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 52,
			Parent = popup,
		})
		Corner(hue, 6)
		New("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
				ColorSequenceKeypoint.new(1 / 6, Color3.fromRGB(255, 255, 0)),
				ColorSequenceKeypoint.new(2 / 6, Color3.fromRGB(0, 255, 0)),
				ColorSequenceKeypoint.new(3 / 6, Color3.fromRGB(0, 255, 255)),
				ColorSequenceKeypoint.new(4 / 6, Color3.fromRGB(0, 0, 255)),
				ColorSequenceKeypoint.new(5 / 6, Color3.fromRGB(255, 0, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
			}),
			Parent = hue,
		})
		local hueCursor = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(6, 18),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 54,
			Parent = hue,
		})
		Corner(hueCursor, 3)
		New("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1, Transparency = 0.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = hueCursor })
		local hueHit = New("TextButton", {
			Size = UDim2.new(1, 0, 1, 12),
			Position = UDim2.fromOffset(0, -6),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 57,
			Parent = hue,
		})

		local alphaTrack, alphaBar, alphaCursor, alphaHit
		if hasAlpha then
			alphaTrack = New("Frame", {
				Name = "Alpha",
				Position = UDim2.fromOffset(10, 160),
				Size = UDim2.fromOffset(216, 12),
				BorderSizePixel = 0,
				ZIndex = 52,
				Theme = { BackgroundColor3 = "Button" },
				Parent = popup,
			})
			Corner(alphaTrack, 6)
			alphaBar = New("Frame", {
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = color,
				BorderSizePixel = 0,
				ZIndex = 53,
				Parent = alphaTrack,
			})
			Corner(alphaBar, 6)
			New("UIGradient", { Transparency = NumberSequence.new(1, 0), Parent = alphaBar })
			alphaCursor = New("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(6, 18),
				BackgroundColor3 = Color3.new(1, 1, 1),
				ZIndex = 54,
				Parent = alphaTrack,
			})
			Corner(alphaCursor, 3)
			New("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1, Transparency = 0.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = alphaCursor })
			alphaHit = New("TextButton", {
				Size = UDim2.new(1, 0, 1, 12),
				Position = UDim2.fromOffset(0, -6),
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				ZIndex = 57,
				Parent = alphaTrack,
			})
		end

		local hex = New("TextBox", {
			Name = "Hex",
			Position = UDim2.fromOffset(10, hexY),
			Size = UDim2.fromOffset(104, 28),
			Text = "",
			Font = FontOf("Medium"),
			TextSize = 13,
			ClearTextOnFocus = false,
			ZIndex = 52,
			Theme = { TextColor3 = "Text" },
			Parent = popup,
		})
		FieldStyle(hex, 8)
		local preview = New("Frame", {
			Position = UDim2.fromOffset(122, hexY),
			Size = UDim2.fromOffset(104, 28),
			ZIndex = 52,
			Parent = popup,
		})
		Corner(preview, 8)
		Stroke(preview, "Outline", 1, 0.8)

		ui = {
			sv = sv,
			svCursor = svCursor,
			hueCursor = hueCursor,
			hex = hex,
			preview = preview,
			alphaBar = alphaBar,
			alphaCursor = alphaCursor,
		}
		popup.Destroying:Connect(function()
			ui = nil
			if scroll then
				scroll.ScrollingEnabled = true
			end
		end)

		local function freeze()
			if scroll then
				scroll.ScrollingEnabled = false
			end
		end
		local function unfreeze()
			if scroll then
				scroll.ScrollingEnabled = true
			end
		end

		Drag(svHit, function(pos)
			s = math.clamp((pos.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
			v = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
			apply(true)
		end, freeze, unfreeze, true)
		Drag(hueHit, function(pos)
			h = math.clamp((pos.X - hue.AbsolutePosition.X) / math.max(hue.AbsoluteSize.X, 1), 0, 1)
			apply(true)
		end, freeze, unfreeze, true)
		if alphaHit then
			Drag(alphaHit, function(pos)
				local a = math.clamp((pos.X - alphaTrack.AbsolutePosition.X) / math.max(alphaTrack.AbsoluteSize.X, 1), 0, 1)
				transparency = 1 - a
				apply(true)
			end, freeze, unfreeze, true)
		end

		hex.FocusLost:Connect(function()
			local parsed = HexToColor(hex.Text)
			if parsed then
				h, s, v = parsed:ToHSV()
				apply(true)
			else
				hex.Text = ColorToHex(color)
			end
		end)
		apply(false)
	end

	swatch.MouseButton1Click:Connect(open)

	function obj:Set(value, silent)
		if typeof(value) == "string" then
			value = HexToColor(value)
		end
		if typeof(value) ~= "Color3" then
			return
		end
		h, s, v = value:ToHSV()
		apply(not silent)
	end
	function obj:Get()
		return color
	end
	return Finish(self, cfg, obj, row, title, desc, lock)
end

