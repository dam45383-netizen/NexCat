    local pageVeil = new("Frame", {Name = "PageVeil", Position = UDim2.fromOffset(0, TOP0), Size = UDim2.new(1, 0, 1, -TOP0), BackgroundColor3 = T.bg, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 30, Visible = false}, main)
