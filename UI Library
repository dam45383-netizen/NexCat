function NexCat:SetTheme(name)
	local theme = self.Themes[name]
	if not theme then
		return false
	end
	self.Theme = theme
	self.ThemeName = name
	local alive = {}
	for _, entry in ipairs(Bound) do
		local inst = entry[1]
		if inst.Parent ~= nil then
			alive[#alive + 1] = entry
			Tween(inst, { [entry[2]] = Resolve(entry[3]) }, 0.25)
		end
	end
	Bound = alive
	return true
end

-- sama seperti WindUI: key = nama theme. Cocok untuk `for name in pairs(NexCat:GetThemes())`
function NexCat:GetThemes()
	return self.Themes
end

function NexCat:GetThemeNames()
	local names = {}
	for name in pairs(self.Themes) do
		names[#names + 1] = name
	end
	table.sort(names)
	return names
end

function NexCat:GetCurrentTheme()
	return self.ThemeName
end

-- NexCat:AddTheme({ Name = "X", Accent = ..., ... })  atau  NexCat:AddTheme("X", { ... })
function NexCat:AddTheme(nameOrTheme, maybeTheme)
	local name, theme
	if type(nameOrTheme) == "table" then
		theme = nameOrTheme
		name = theme.Name
	else
		name = nameOrTheme
		theme = maybeTheme
	end
	if type(name) ~= "string" or type(theme) ~= "table" then
		return false
	end
	local merged = {}
	for key, value in pairs(self.Themes.Dark) do
		merged[key] = value
	end
	for key, value in pairs(theme) do
		merged[key] = value
	end
	merged.Name = name
	self.Themes[name] = Complete(merged)
	return true
end

function NexCat:SetFont(regular, medium, bold)
	if regular then
		self.Fonts.Regular = regular
	end
	self.Fonts.Medium = medium or regular or self.Fonts.Medium
	self.Fonts.Bold = bold or medium or regular or self.Fonts.Bold
end

function NexCat:SetParent(parent)
	self._parent = parent
end

function NexCat:GetTransparency()
	return self.Windows[1] ~= nil and self.Windows[1].Transparent == true
end

function NexCat:GetWindowSize()
	local window = self.Windows[1]
	if window and window.Frame then
		return window.Frame.AbsoluteSize
	end
	return Vector2.new(0, 0)
end

