-- ============================================================
-- Base64 decoder + loader gambar (base64 -> file -> asset)
-- ============================================================

local AssetFolder = "NexCat/assets"

local Base64Chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local Base64Lookup = {}
for i = 1, #Base64Chars do
	Base64Lookup[Base64Chars:byte(i)] = i - 1
end

local function Base64Decode(data)
	data = tostring(data):gsub("^data:[^,]*,", ""):gsub("[^%w%+/=]", "")
	local padding = 0
	if data:sub(-2) == "==" then
		padding = 2
	elseif data:sub(-1) == "=" then
		padding = 1
	end
	data = data:gsub("=", "A")
	local out, count = {}, 0
	for i = 1, #data, 4 do
		local a = Base64Lookup[data:byte(i)] or 0
		local b = Base64Lookup[data:byte(i + 1)] or 0
		local c = Base64Lookup[data:byte(i + 2)] or 0
		local d = Base64Lookup[data:byte(i + 3)] or 0
		local n = a * 262144 + b * 4096 + c * 64 + d
		count = count + 1
		out[count] = string.char(math.floor(n / 65536) % 256, math.floor(n / 256) % 256, n % 256)
	end
	local result = table.concat(out)
	if padding > 0 then
		result = result:sub(1, #result - padding)
	end
	return result
end

local function FSAvailable()
	return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
end

local function EnsureFolder(path)
	if type(isfolder) == "function" and type(makefolder) == "function" then
		local built = ""
		for part in path:gmatch("[^/\\]+") do
			built = built == "" and part or (built .. "/" .. part)
			if not isfolder(built) then
				pcall(makefolder, built)
			end
		end
	end
end

local AssetCache = {}

-- tulis PNG dari base64 ke file lalu ambil asset-nya. return nil kalau environment tidak mendukung.
local function LoadBase64Image(name, base64)
	if AssetCache[name] ~= nil then
		return AssetCache[name] or nil
	end
	local getAsset
	if type(getcustomasset) == "function" then
		getAsset = getcustomasset
	elseif type(getsynasset) == "function" then
		getAsset = getsynasset
	end
	if not getAsset or not FSAvailable() then
		AssetCache[name] = false
		return nil
	end
	local ok, result = pcall(function()
		EnsureFolder(AssetFolder)
		local safe = tostring(name):gsub("[^%w_%-]", "_")
		local path = AssetFolder .. "/" .. safe .. "_" .. #base64 .. ".png"
		if not isfile(path) then
			writefile(path, Base64Decode(base64))
		end
		return getAsset(path)
	end)
	if ok and result and result ~= "" then
		AssetCache[name] = result
		return result
	end
	AssetCache[name] = false
	return nil
end

