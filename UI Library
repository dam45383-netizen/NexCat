function WindowClass:OnOpen(callback)
	self._openCallbacks[#self._openCallbacks + 1] = callback
end

function WindowClass:OnClose(callback)
	self._closeCallbacks[#self._closeCallbacks + 1] = callback
end

function WindowClass:OnDestroy(callback)
	self._destroyCallbacks[#self._destroyCallbacks + 1] = callback
end

function WindowClass:Show()
	if self.Opened or self.Destroyed then
		return
	end
	self.Opened = true
	self.Frame.Visible = true
	if self.OpenButton then
		self.OpenButton.Visible = false
	end
	Tween(self._scale, { Scale = self._baseScale }, 0.25, Enum.EasingStyle.Back)
	for _, callback in ipairs(self._openCallbacks) do
		Fire(callback)
	end
end

function WindowClass:Hide()
	if not self.Opened or self.Destroyed then
		return
	end
	self.Opened = false
	self:_ClosePopup()
	Tween(self._scale, { Scale = self._baseScale * 0.9 }, 0.15)
	if self.OpenButton then
		self.OpenButton.Visible = self._openEnabled
	end
	task.delay(0.15, function()
		if not self.Opened and not self.Destroyed then
			self.Frame.Visible = false
		end
	end)
	for _, callback in ipairs(self._closeCallbacks) do
		Fire(callback)
	end
end

function WindowClass:Toggle()
	if self.Opened then
		self:Hide()
	else
		self:Show()
	end
end

-- alias gaya WindUI
function WindowClass:Open()
	self:Show()
end

function WindowClass:Close()
	local window = self
	self:Hide()
	return {
		Destroy = function()
			window:Destroy()
		end,
	}
end

function WindowClass:ToggleFullscreen()
	if self.Destroyed then
		return
	end
	local main = self.Frame
	self:_ClosePopup()
	if not self.Fullscreen then
		self._restore = { Size = main.Size, Position = main.Position }
		self.Fullscreen = true
		Tween(main, { Size = UDim2.new(1, -24, 1, -24), Position = UDim2.fromScale(0.5, 0.5) }, 0.25)
	else
		self.Fullscreen = false
		local restore = self._restore
		if restore then
			Tween(main, { Size = restore.Size, Position = restore.Position }, 0.25)
		end
	end
	if self._grip then
		self._grip.Visible = not self.Fullscreen
	end
end

function WindowClass:Destroy()
	if self.Destroyed then
		return
	end
	if self.AutoSave and self._configReady then
		pcall(function()
			self:_AutoSaveStep()
		end)
	end
	self.Destroyed = true
	for _, connection in ipairs(self._conns) do
		connection:Disconnect()
	end
	for _, callback in ipairs(self._destroyCallbacks) do
		Fire(callback)
	end
	for i, w in ipairs(NexCat.Windows) do
		if w == self then
			table.remove(NexCat.Windows, i)
			break
		end
	end
	self.Gui:Destroy()
end

