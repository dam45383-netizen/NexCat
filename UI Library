	theme.Text = text
	theme.Outline = theme.Outline or text
	theme.Dialog = theme.Dialog or background:Lerp(text, 0.04)
	theme.Accent = theme.Accent or background:Lerp(text, 0.08)
	theme.Placeholder = theme.Placeholder or text:Lerp(background, 0.5)
	theme.Button = theme.Button or background:Lerp(text, 0.25)
	theme.Icon = theme.Icon or text:Lerp(background, 0.35)
	theme.Toggle = theme.Toggle or Hex("#315dff")
	theme.KnobOn = theme.KnobOn or Hex("#FFFFFF")
	theme.Success = theme.Success or Hex("#34d399")
	theme.Warning = theme.Warning or Hex("#fbbf24")
	theme.Danger = theme.Danger or Hex("#f85151")
	theme.White = Hex("#FFFFFF")
	return theme
end

