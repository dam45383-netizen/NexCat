	})
	List(items, 4)

	local section = { Type = "WindowSection", Opened = cfg.Opened ~= false }
	local function render()
		items.Visible = section.Opened
		arrow.Text = section.Opened and "▾" or "▸"
	end
	function section:Tab(tabCfg)
		return CreateTab(window, items, tabCfg)
	end
	function section:Toggle()
		section.Opened = not section.Opened
		render()
	end
	head.MouseButton1Click:Connect(function()
		if cfg.Collapsible ~= false then
			section:Toggle()
		end
	end)
	render()
	return section
end

function WindowClass:Divider()
	New("Frame", {
		Name = "Divider",
		Size = UDim2.new(1, 0, 0, 1),
		BorderSizePixel = 0,
		BackgroundTransparency = 0.4,
		LayoutOrder = NextOrder(self._tabList),
		Theme = { BackgroundColor3 = "Stroke" },
		Parent = self._tabList,
	})
end

function WindowClass:SetTheme(name)
	return NekoUI:SetTheme(name)
end

function WindowClass:SetTitle(value)
	self.Title = tostring(value)
	self._titleLabel.Text = self.Title
end

function WindowClass:SetToggleKey(key)
	self.ToggleKey = key
end

function WindowClass:OnDestroy(callback)
	self._destroyCallbacks[#self._destroyCallbacks + 1] = callback
end

function WindowClass:Show()
	if self.Opened or self.Destroyed then
		return
	end
	self.Opened = true
	self.Frame.Visible = true
	if self.OpenButton then
		self.OpenButton.Visible = false
	end
	Tween(self._scale, { Scale = 1 }, 0.25, Enum.EasingStyle.Back)
end

function WindowClass:Hide()
	if not self.Opened or self.Destroyed then
		return
	end
	self.Opened = false
	self:_ClosePopup()
	Tween(self._scale, { Scale = 0.9 }, 0.15)
	if self.OpenButton then
		self.OpenButton.Visible = self._openEnabled
	end
	task.delay(0.15, function()
		if not self.Opened and not self.Destroyed then
			self.Frame.Visible = false
		end
	end)
end

function WindowClass:Toggle()
	if self.Opened then
		self:Hide()
	else
		self:Show()
	end
end

function WindowClass:Destroy()
	if self.Destroyed then
		return
	end
	self.Destroyed = true
	for _, connection in ipairs(self._conns) do
		connection:Disconnect()
	end
	for _, callback in ipairs(self._destroyCallbacks) do
		Fire(callback)
	end
	for i, w in ipairs(NekoUI.Windows) do
		if w == self then
			table.remove(NekoUI.Windows, i)
			break
		end
	end
	self.Gui:Destroy()
end

-- tombol bulat/pill untuk buka window saat disembunyikan
function WindowClass:EditOpenButton(cfg)
	cfg = cfg or {}
	local window = self
	if self.OpenButton then
		self.OpenButton:Destroy()
		self.OpenButton = nil
	end
	self._openEnabled = cfg.Enabled ~= false

	local button = New("TextButton", {
		Name = "OpenButton",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = self._openPosition or UDim2.new(0.5, 0, 0, 14),
		Size = UDim2.fromOffset(0, 38),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "",
		AutoButtonColor = false,
		Visible = (not self.Opened) and self._openEnabled,
		ZIndex = 30,
		Theme = { BackgroundColor3 = "Surface" },
		Parent = self.Gui,
	})
	Corner(button, 19)
	Stroke(button, "Accent", 1, 0.3)
	Pad(button, 0, 14, 0, 12)
	List(button, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local icon = MakeIcon(button, cfg.Icon or self._iconName or "cat", 20)
	if icon then
		icon.LayoutOrder = 1
	end
	if cfg.Title ~= false then
		Text(button, cfg.Title or self.Title, {
			Size = UDim2.fromOffset(0, 38),
			AutomaticSize = Enum.AutomaticSize.X,
			Font = Enum.Font.GothamBold,
			LayoutOrder = 2,
		})
	end

	local startPos, startOffset, moved
	Drag(button, function(pos)
		if cfg.Draggable == false then
			return
		end
		local d = pos - startPos
		if d.Magnitude > 6 then
			moved = true
		end
		if moved then
			local position = UDim2.new(startOffset.X.Scale, startOffset.X.Offset + d.X, startOffset.Y.Scale, startOffset.Y.Offset + d.Y)
			button.Position = position
			window._openPosition = position
		end
	end, function(pos)
		startPos = pos
		startOffset = button.Position
		moved = false
	end, function()
		if not moved then
			window:Show()
		end
	end)

	self.OpenButton = button
	return button
end

-- ============================================================
-- CreateWindow
-- ============================================================

function NekoUI:CreateWindow(cfg)
	cfg = cfg or {}
	if cfg.Theme and self.Themes[cfg.Theme] then
		self:SetTheme(cfg.Theme)
	end

	local window = setmetatable({
		Title = tostring(cfg.Title or "NekoUI"),
		Flags = {},
		Tabs = {},
		Opened = true,
		Destroyed = false,
		Transparent = cfg.Transparent == true,
		Folder = cfg.Folder or "NekoUI",
		ToggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift,
		_conns = {},
		_surfaces = {},
		_destroyCallbacks = {},
		_iconName = cfg.Icon or "cat",
		_openEnabled = true,
	}, WindowClass)
	window.ConfigManager = NewConfigManager(window)

	local viewport = ViewportSize()
	local size = cfg.Size or UDim2.fromOffset(620, 440)
	local width = math.min(size.X.Offset, viewport.X - 40)
	local height = math.min(size.Y.Offset, viewport.Y - 40)
	local minSize = cfg.MinSize or Vector2.new(460, 320)
	local maxSize = cfg.MaxSize or Vector2.new(1000, 700)
	local minW = math.min(minSize.X, width)
	local minH = math.min(minSize.Y, height)
	local sideWidth = math.min(cfg.SideBarWidth or 190, math.floor(width * 0.34))

	local gui = NewGui("NekoUI", 100)
	window.Gui = gui

	local main = New("Frame", {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(width, height),
		Theme = { BackgroundColor3 = "Background" },
		Parent = gui,
	})
	Corner(main, 12)
	Stroke(main, "Stroke", 1, 0)
	window:_Surface(main, 0.12)
	window.Frame = main
	window._scale = New("UIScale", { Scale = 0.9, Parent = main })
	Tween(window._scale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)

	-- ---------- Topbar ----------
	local top = New("Frame", {
		Name = "Topbar",
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundTransparency = 1,
		Parent = main,
	})
	local dragHandle = New("TextButton", {
		Name = "DragHandle",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = top,
	})
	New("Frame", {
		Name = "Line",
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 1),
		BorderSizePixel = 0,
		BackgroundTransparency = 0.3,
		Theme = { BackgroundColor3 = "Stroke" },
		Parent = top,
	})

	local titleHolder = New("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(1, -110, 1, 0),
		Parent = top,
	})
	List(titleHolder, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local titleIcon = MakeIcon(titleHolder, cfg.Icon or "cat", 22)
	if titleIcon then
		titleIcon.LayoutOrder = 1
	end
	window._titleLabel = Text(titleHolder, window.Title, {
		Size = UDim2.fromOffset(0, 20),
		AutomaticSize = Enum.AutomaticSize.X,
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		LayoutOrder = 2,
	})
	if cfg.Author and cfg.Author ~= "" then
		Text(titleHolder, tostring(cfg.Author), {
			Size = UDim2.fromOffset(0, 20),
			AutomaticSize = Enum.AutomaticSize.X,
			Font = Enum.Font.Gotham,
			TextSize = 12,
			LayoutOrder = 3,
			Theme = { TextColor3 = "SubText" },
		})
	end

	local controls = New("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 0),
		Size = UDim2.fromOffset(70, 46),
		Parent = top,
	})
	List(controls, 6, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)

	local function ControlButton(order)
		local b = New("TextButton", {
			Size = UDim2.fromOffset(30, 30),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = order,
			ZIndex = 3,
			Theme = { BackgroundColor3 = "ElementHover" },
			Parent = controls,
		})
		Corner(b, 8)
		b.MouseEnter:Connect(function()
			Tween(b, { BackgroundTransparency = 0 }, 0.12)
		end)
		b.MouseLeave:Connect(function()
			Tween(b, { BackgroundTransparency = 1 }, 0.12)
		end)
		return b
	end

	local minimize = ControlButton(1)
	local minLine = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(12, 2),
		BorderSizePixel = 0,
		Theme = { BackgroundColor3 = "SubText" },
		Parent = minimize,
	})
	Corner(minLine, 1)

	local close = ControlButton(2)
	for _, rotation in ipairs({ 45, -45 }) do
		local bar = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(14, 2),
			Rotation = rotation,
			BorderSizePixel = 0,
			Theme = { BackgroundColor3 = "SubText" },
			Parent = close,
		})
		Corner(bar, 1)
	end

	minimize.MouseButton1Click:Connect(function()
		window:Hide()
	end)
	close.MouseButton1Click:Connect(function()
		if cfg.CloseConfirm == false then
			window:Destroy()
		else
			window:Dialog({
				Title = "Tutup window?",
				Content = "Interface ini akan dihapus dari layar.",
				Buttons = {
					{ Title = "Batal" },
					{
						Title = "Tutup",
						Variant = "Danger",
						Callback = function()
							window:Destroy()
						end,
					},
				},
			})
		end
	end)

	-- geser window
	local dragStart, dragOrigin
	if cfg.Draggable ~= false then
		Drag(dragHandle, function(pos)
			local d = pos - dragStart
			local vp = gui.AbsoluteSize
			local x = math.clamp(dragOrigin.X.Offset + d.X, -vp.X / 2, vp.X / 2)
			local y = math.clamp(dragOrigin.Y.Offset + d.Y, -vp.Y / 2, vp.Y / 2)
			main.Position = UDim2.new(dragOrigin.X.Scale, x, dragOrigin.Y.Scale, y)
		end, function(pos)
			dragStart = pos
			dragOrigin = main.Position
			window:_ClosePopup()
		end)
	end

	-- ---------- Body ----------
	local body = New("Frame", {
		Name = "Body",
		Position = UDim2.fromOffset(0, 47),
		Size = UDim2.new(1, 0, 1, -47),
		BackgroundTransparency = 1,
		Parent = main,
	})

	local sidebar = New("Frame", {
		Name = "Sidebar",
		Size = UDim2.new(0, sideWidth, 1, 0),
		BackgroundTransparency = 1,
		Parent = body,
	})
	New("Frame", {
		Name = "Divider",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, 1, 1, 0),
		BorderSizePixel = 0,
		BackgroundTransparency = 0.3,
		Theme = { BackgroundColor3 = "Stroke" },
		Parent = sidebar,
	})
	local sideInner = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -1, 1, 0),
		Parent = sidebar,
	})
	Pad(sideInner, 8)
	List(sideInner, 8)

	local reserved = 0
	if cfg.HideSearchBar ~= true then
		reserved = reserved + 40
		local searchHolder = New("Frame", {
			Name = "Search",
			Size = UDim2.new(1, 0, 0, 32),
			LayoutOrder = 1,
			Theme = { BackgroundColor3 = "Element" },
			Parent = sideInner,
		})
		Corner(searchHolder, 8)
		Stroke(searchHolder, "Stroke", 1, 0.4)
		local searchBox = New("TextBox", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			PlaceholderText = "Cari tab...",
			ClearTextOnFocus = false,
			Font = Enum.Font.Gotham,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			Theme = { TextColor3 = "Text", PlaceholderColor3 = "SubText" },
			Parent = searchHolder,
		})
		Pad(searchBox, 0, 10, 0, 10)
		searchBox:GetPropertyChangedSignal("Text"):Connect(function()
			local q = searchBox.Text:lower()
			for _, tab in ipairs(window.Tabs) do
				tab.Button.Visible = q == "" or tab.Title:lower():find(q, 1, true) ~= nil
			end
		end)
	end

	local userCfg = cfg.User
	if userCfg == true then
		userCfg = {}
	end
	if userCfg then
		reserved = reserved + 52
	end

	local tabList = New("ScrollingFrame", {
		Name = "Tabs",
		Size = UDim2.new(1, 0, 1, -reserved),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		LayoutOrder = 2,
		Parent = sideInner,
	})
	List(tabList, 4)
	window._tabList = tabList

	if userCfg then
		local card = New("Frame", {
			Name = "User",
			Size = UDim2.new(1, 0, 0, 44),
			LayoutOrder = 3,
			Theme = { BackgroundColor3 = "Element" },
			Parent = sideInner,
		})
		Corner(card, 8)
		Stroke(card, "Stroke", 1, 0.4)
		window:_Surface(card, 0.3)
		local avatar = New("ImageLabel", {
			Position = UDim2.fromOffset(7, 7),
			Size = UDim2.fromOffset(30, 30),
			Theme = { BackgroundColor3 = "ElementHover" },
			Parent = card,
		})
		Corner(avatar, 15)
		local anonymous = userCfg.Anonymous == true
		local display = anonymous and "Guest" or (LocalPlayer and LocalPlayer.DisplayName or "Player")
		local username = anonymous and "@hidden" or (LocalPlayer and "@" .. LocalPlayer.Name or "")
		Text(card, display, {
			Position = UDim2.fromOffset(44, 5),
			Size = UDim2.new(1, -50, 0, 16),
			TextSize = 13,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		Text(card, username, {
			Position = UDim2.fromOffset(44, 22),
			Size = UDim2.new(1, -50, 0, 14),
			TextSize = 11,
			Font = Enum.Font.Gotham,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Theme = { TextColor3 = "SubText" },
		})
		if not anonymous and LocalPlayer then
			task.spawn(function()
				local ok, image = pcall(function()
					return Players:GetUserThumbnailAsync(
						LocalPlayer.UserId,
						Enum.ThumbnailType.HeadShot,
						Enum.ThumbnailSize.Size100x100
					)
				end)
				if ok and avatar.Parent then
					avatar.Image = image
				end
			end)
		end
		if type(userCfg.Callback) == "function" then
			local click = New("TextButton", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Text = "",
				ZIndex = 5,
				Parent = card,
			})
			click.MouseButton1Click:Connect(function()
				Fire(userCfg.Callback)
			end)
		end
	end

	window._content = New("Frame", {
		Name = "Content",
		Position = UDim2.fromOffset(sideWidth, 0),
		Size = UDim2.new(1, -sideWidth, 1, 0),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = body,
	})

	-- ---------- Resize ----------
	if cfg.Resizable ~= false then
		local grip = New("TextButton", {
			Name = "ResizeGrip",
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.fromScale(1, 1),
			Size = UDim2.fromOffset(20, 20),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 20,
			Parent = main,
		})
		for _, spec in ipairs({ { 9, 14 }, { 13, 8 } }) do
			local line = New("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(spec[1] + 1, spec[1] + 1),
				Size = UDim2.fromOffset(spec[2], 1),
				Rotation = -45,
				BorderSizePixel = 0,
				BackgroundTransparency = 0.3,
				Theme = { BackgroundColor3 = "SubText" },
				Parent = grip,
			})
			line.ZIndex = 21
		end
		local startPos, startSize, startPosition
		Drag(grip, function(pos)
			local d = pos - startPos
			local vp = gui.AbsoluteSize
			local nw = math.clamp(startSize.X + d.X, minW, math.max(minW, math.min(maxSize.X, vp.X - 20)))
			local nh = math.clamp(startSize.Y + d.Y, minH, math.max(minH, math.min(maxSize.Y, vp.Y - 20)))
			main.Size = UDim2.fromOffset(nw, nh)
			main.Position = UDim2.new(
				startPosition.X.Scale,
				startPosition.X.Offset + (nw - startSize.X) / 2,
				startPosition.Y.Scale,
				startPosition.Y.Offset + (nh - startSize.Y) / 2
			)
		end, function(pos)
			startPos = pos
			startSize = Vector2.new(main.Size.X.Offset, main.Size.Y.Offset)
			startPosition = main.Position
			window:_ClosePopup()
		end)
	end

	-- ---------- Toggle key + open button ----------
	window:_Connect(UserInputService.InputBegan, function(input, processed)
		if not processed and window.ToggleKey and input.KeyCode == window.ToggleKey then
			window:Toggle()
		end
	end)

	local openCfg = type(cfg.OpenButton) == "table" and cfg.OpenButton or {}
	if cfg.OpenButton == false then
		openCfg.Enabled = false
	end
	window:EditOpenButton(openCfg)

	NekoUI.Windows[#NekoUI.Windows + 1] = window
	return window
end

function NekoUI:Destroy()
	for i = #self.Windows, 1, -1 do
		self.Windows[i]:Destroy()
	end
	if self._notifGui then
		self._notifGui:Destroy()
		self._notifGui = nil
	end
end

return NekoUI
