-- ---------- ConfigSection: tombol Save / Load / Delete + Auto Save siap pakai ----------
-- cfg: Title, Desc, Icon, Box, Opened, Notify (default true)
function Container:ConfigSection(cfg)
	cfg = cfg or {}
	local window = self._window
	local notify = cfg.Notify ~= false

	local function report(ok, message)
		if not notify then
			return
		end
		window:Notify({
			Title = "Config",
			Content = tostring(message),
			Type = ok and "Success" or "Error",
			Duration = 4,
		})
	end

	local section = self:Section({
		Title = cfg.Title or "Config",
		Desc = cfg.Desc,
		Icon = cfg.Icon or "save",
		Box = cfg.Box,
		Opened = cfg.Opened,
	})

	local info = section:Paragraph({ Title = "File config", Desc = "..." })
	task.spawn(function()
		info:SetDesc(window:GetConfigPath())
	end)

	section:Button({
		Title = "Save Config",
		Desc = "Simpan semua pengaturan sekarang",
		Icon = "save",
		Callback = function()
			local ok, err = window:SaveConfig()
			report(ok, ok and "Config tersimpan" or err)
		end,
	})
	section:Button({
		Title = "Load Config",
		Desc = "Muat pengaturan dari file",
		Icon = "folder",
		Callback = function()
			local ok, result = window:LoadConfig()
			report(ok, ok and ("Config dimuat (" .. tostring(result) .. " pengaturan)") or result)
		end,
	})
	section:Button({
		Title = "Delete Config",
		Desc = "Hapus file config game ini",
		Icon = "trash",
		Callback = function()
			window:Dialog({
				Title = "Hapus config?",
				Content = "File config game ini akan dihapus permanen.",
				Icon = "trash",
				Buttons = {
					{ Title = "Batal", Variant = "Secondary" },
					{
						Title = "Hapus",
						Variant = "Danger",
						Callback = function()
							local ok = window:DeleteConfig()
							report(ok, ok and "Config dihapus" or "File config tidak ditemukan")
						end,
					},
				},
			})
		end,
	})
	section:Toggle({
		Title = "Auto Save",
		Desc = "Simpan otomatis kalau ada perubahan",
		Value = window.AutoSave == true,
		Callback = function(value)
			window:SetAutoSave(value)
		end,
	})
	return section
end

