local function CreateTab(window, parent, cfg)
	cfg = cfg or {}
	local tab = setmetatable({}, TabClass)
	tab.Type = "Tab"
	tab.Title = tostring(cfg.Title or "Tab")
	tab._window = window

	local button = New("TextButton", {
		Name = tab.Title,
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = NextOrder(parent),
		Theme = { BackgroundColor3 = "Accent" },
		Parent = parent,
	})
	Corner(button, 8)

	local indicator = New("Frame", {
		Name = "Indicator",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 2, 0.5, 0),
		Size = UDim2.fromOffset(3, 0),
		Theme = { BackgroundColor3 = "Accent" },
		Parent = button,
	})
	Corner(indicator, 2)

	local holder = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = button,
	})
	Pad(holder, 0, 8, 0, 12)
	List(holder, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local icon = MakeIcon(holder, cfg.Icon, 18)
	if icon then
		icon.LayoutOrder = 1
	end
	local label = Text(holder, tab.Title, {
		Size = UDim2.new(1, icon and -26 or 0, 1, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
		LayoutOrder = 2,
		Theme = { TextColor3 = "SubText" },
	})

	local page = New("ScrollingFrame", {
		Name = tab.Title,
		Position = UDim2.fromOffset(0, 6),
		Size = UDim2.new(1, 0, 1, -12),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Visible = false,
		Theme = { ScrollBarImageColor3 = "SubText" },
		Parent = window._content,
	})
	Pad(page, 4, 14, 4, 14)
	List(page, 8)

	tab.Button = button
	tab.Page = page
	tab._content = page
	tab._scroll = page

	local selected = false
	function tab:_SetActive(active)
		selected = active
		page.Visible = active
		if active then
			page.Position = UDim2.fromOffset(0, 18)
			Tween(page, { Position = UDim2.fromOffset(0, 6) }, 0.25)
		end
		Tween(button, { BackgroundTransparency = active and 0.88 or 1 }, 0.18)
		Tween(indicator, { Size = UDim2.fromOffset(3, active and 16 or 0) }, 0.2)
		Tween(label, { TextColor3 = active and NekoUI.Theme.Text or NekoUI.Theme.SubText }, 0.18)
		-- biar warna label ikut theme: ganti binding kalau status berubah
		for _, entry in ipairs(Bound) do
			if entry[1] == label then
				entry[3] = active and "Text" or "SubText"
			end
		end
	end

	function tab:Select()
		window:SelectTab(tab)
	end
	function tab:SetTitle(value)
		tab.Title = tostring(value)
		label.Text = tab.Title
	end
	function tab:Destroy()
		for i, t in ipairs(window.Tabs) do
			if t == tab then
				table.remove(window.Tabs, i)
				break
			end
		end
		if window._selected == tab then
			window._selected = nil
			if window.Tabs[1] then
				window:SelectTab(window.Tabs[1])
			end
		end
		button:Destroy()
		page:Destroy()
	end

	button.MouseEnter:Connect(function()
		if not selected then
			Tween(button, { BackgroundTransparency = 0.94 }, 0.12)
		end
	end)
	button.MouseLeave:Connect(function()
		if not selected then
			Tween(button, { BackgroundTransparency = 1 }, 0.12)
		end
	end)
	button.MouseButton1Click:Connect(function()
		window:SelectTab(tab)
	end)

	window.Tabs[#window.Tabs + 1] = tab
	if #window.Tabs == 1 then
		window:SelectTab(tab)
	end
	return tab
end

