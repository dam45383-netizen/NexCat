            if r3dOff then pcall(function() RunService:Set3dRenderingEnabled(true) end) end
        end)

        ---------------- FPS BOOST: dunia abu-abu polos (tanpa tekstur / efek), karakter tetap berwarna ----------------
        -- v4 (anti lag / anti fps loncat):
        --  * GOVERNOR: jumlah objek per frame menyesuaikan waktu frame ASLI (Heartbeat dt), bukan waktu Lua. Biaya sisi engine (render / fisika setelah
        --    Material / Color diganti) ikut terhitung. Frame mulai berat -> jatah langsung dipotong, ada jeda; frame ringan -> jatah naik cepat.
        --    Berlaku untuk proses ON, scan, dan proses OFF (restore).
        --  * Tidak ada tabel per objek: nilai asli part dipadatkan jadi 1 angka (bayangan, reflectance, material, warna 8-bit). Tanpa tabel "seen".
        --    Objek yang sudah beres terdeteksi dari nilai propertinya (nol tulis), jadi part yang keluar-masuk workspace tidak diproses ulang.
        --  * Filter kelas di muka (cache per ClassName): Script / Attachment / Value dll langsung dilewati, tidak masuk antrean.
        --  * Scan awal DFS bertahap (tanpa satu panggilan GetDescendants raksasa). Perubahan dunia (bayangan / kualitas / terrain) diberi jeda, tidak sekaligus.
        --  * RenderFidelity tidak lagi diubah (memaksa mesh dibangun ulang = penyebab hitch besar).
        local function newWeak() return setmetatable({}, {__mode = "k"}) end
        local Boost = {on = false, level = "Ultra", keep = true, tok = 0, restoring = false, rank = 3,
            op = newWeak(), og = newWeak(), ot = newWeak(), removed = {}, -- op: nilai asli part (angka) | og: Enabled / Transparency asli | ot: tekstur asli (string)
            q = {}, qh = 1, qt = 0, count = 0, conns = {}, scan = nil, chars = newWeak(),
            gov = {n = 30, max = 450, base = 1 / 60, cool = 0, used = 0}, status = function() end}
        local GRAY = Color3.fromRGB(163, 165, 172)
        local SMOOTH = Enum.Material.SmoothPlastic
        local TCAP = 0.006 -- batas waktu Lua per frame (pengaman tambahan di luar governor)
        local EXPAND, LEAF = 2, 99 -- scan: 2 tingkat pertama diperluas lewat GetChildren, tingkat berikutnya GetDescendants per objek
        local FX_CLASS = {ParticleEmitter = true, Trail = true, Beam = true, Fire = true, Smoke = true, Sparkles = true,
            BloomEffect = true, BlurEffect = true, ColorCorrectionEffect = true, DepthOfFieldEffect = true, SunRaysEffect = true}
        local LIGHT_CLASS = {PointLight = true, SpotLight = true, SurfaceLight = true}
        local function rankOf(l) return (l == "Ultra") and 3 or ((l == "Medium") and 2 or 1) end
        local function kfmt(n) return (n >= 1000) and (string.format("%.1fk", n / 1000)) or tostring(n) end
        local function getp(i, p) return i[p] end
        local function putp(i, p, v) i[p] = v end
        local function putMat(i, v) i.Material = Enum.Material:FromValue(v) end

        -- kategori per kelas (di-cache): 0 abaikan | 1 part | 7 MeshPart | 2 efek (Enabled) | 3 lampu | 4 Decal/Texture | 5 SpecialMesh | 6 SurfaceAppearance
        local CAT = {}
        local function catOf(inst)
            local cn = inst.ClassName
            local c = CAT[cn]
            if c == nil then
                if cn == "Terrain" then c = 0
                elseif FX_CLASS[cn] then c = 2
                elseif inst:IsA("MeshPart") then c = 7
                elseif inst:IsA("BasePart") then c = 1
                elseif LIGHT_CLASS[cn] then c = 3
                elseif cn == "Decal" or cn == "Texture" then c = 4
                elseif cn == "SpecialMesh" then c = 5
                elseif cn == "SurfaceAppearance" then c = 6
                else c = 0 end
                CAT[cn] = c
            end
            return c
        end
        local function isChar(inst) -- bagian dari karakter pemain? (lookup cache, bukan GetPlayerFromCharacter)
            local set, p = Boost.chars, inst.Parent
            while p and p ~= workspace do
                if set[p] then return true end
                p = p.Parent
            end
            return false
        end

        -- nilai asli part dipadatkan jadi 1 angka: bayangan (1 bit) | reflectance (8 bit) | material (12 bit) | warna RGB (24 bit)
        local function packO(shadow, refl, mat, col)
            local rq = math.clamp(math.floor((refl or 0) * 255 + 0.5), 0, 255)
            local mv = mat and math.clamp(mat.Value, 0, 4095) or 0
            local r, g, b = 0, 0, 0
            if col then r, g, b = math.floor(col.R * 255 + 0.5), math.floor(col.G * 255 + 0.5), math.floor(col.B * 255 + 0.5) end
            return (shadow and 1 or 0) + 2 * rq + 512 * mv + 2097152 * (r + 256 * g + 65536 * b)
        end
        local function unpackO(v)
            local s = v % 2
            v = (v - s) / 2
            local rq = v % 256
            v = (v - rq) / 256
            local mv = v % 4096
            v = (v - mv) / 4096
            local r = v % 256
            v = (v - r) / 256
            local g = v % 256
            local b = (v - g) / 256
            return s == 1, rq / 255, mv, r, g, b
        end

        -- GOVERNOR: jatah objek per frame mengikuti waktu frame asli
        local function govTick(dt)
            local G = Boost.gov
            if G.used <= 8 then G.base = G.base + (math.min(dt, G.base * 3) - G.base) * 0.05 end -- baseline dari frame ringan saja
            local target = G.base * 1.35 + 0.003
            if dt > math.max(0.1, G.base * 5) then
                G.n, G.cool = 8, 3 -- freeze besar: jatah minimum + jeda 3 frame
            elseif dt > target * 1.6 then
                G.n = math.max(8, math.floor(G.n * 0.5))
            elseif dt > target then
                G.n = math.max(8, math.floor(G.n * 0.8))
            else
                G.n = math.min(G.max, G.n + math.max(6, math.floor(G.n * 0.15)))
            end
            G.used = 0
        end

        -- APPLY: 1 objek. true = ada yang diubah. Properti yang sudah sesuai tidak ditulis ulang.
        local function boostApply(inst, cat, rank)
            if cat == 1 or cat == 7 then
                if Boost.keep and isChar(inst) then return false end
                local shadow = inst.CastShadow
                local refl, tex, mat, col
                local need = shadow
                if rank >= 2 then
                    refl = inst.Reflectance
                    if refl ~= 0 then need = true end
                    if cat == 7 then
                        tex = inst.TextureID
                        if tex ~= "" then need = true end
                    end
                end
                if rank >= 3 then
                    mat, col = inst.Material, inst.Color
                    if mat ~= SMOOTH or col ~= GRAY then need = true end
                end
                if not need then return false end
                if Boost.op[inst] == nil then
                    Boost.op[inst] = packO(shadow, refl, mat, col)
                    if tex and tex ~= "" then Boost.ot[inst] = tex end
                end
                if shadow then inst.CastShadow = false end
                if refl and refl ~= 0 then inst.Reflectance = 0 end
                if tex and tex ~= "" then pcall(putp, inst, "TextureID", "") end
                if mat and mat ~= SMOOTH then inst.Material = SMOOTH end
                if col and col ~= GRAY then inst.Color = GRAY end
                return true
            elseif cat == 2 or cat == 3 then
                if not inst.Enabled then return false end
                if Boost.og[inst] == nil then Boost.og[inst] = 1 end
                inst.Enabled = false
                return true
            elseif cat == 4 then
                if Boost.keep and isChar(inst) then return false end
                local t = inst.Transparency
                if t >= 1 then return false end
                if Boost.og[inst] == nil then Boost.og[inst] = t end
                inst.Transparency = 1
                return true
            elseif cat == 5 then
                if Boost.keep and isChar(inst) then return false end
                local t = inst.TextureId
                if t == "" then return false end
                if Boost.ot[inst] == nil then Boost.ot[inst] = t end
                inst.TextureId = ""
                return true
            elseif cat == 6 then
                if Boost.keep and isChar(inst) then return false end
                local par = inst.Parent
                if not par then return false end
                Boost.removed[#Boost.removed + 1] = {inst, par}
                inst.Parent = nil
                return true
            end
            return false
        end
        local function work(d, rank, cat) -- mengembalikan "bobot" kerja untuk governor (objek yang tidak berubah murah)
            cat = cat or catOf(d)
            if cat == 0 or (rank < 2 and cat >= 3 and cat <= 6) then return 0 end
            if not d.Parent then return 0 end
            local ok, ch = pcall(boostApply, d, cat, rank)
            if ok and ch then
                Boost.count = Boost.count + 1
                return (cat == 6) and 4 or 1
            end
            return 0.2
        end

        -- RESTORE: 1 objek, dari tabel asli yang diberikan
        local function restoreInst(inst, op, og, ot, rank)
            local cat = catOf(inst)
            if cat == 1 or cat == 7 then
                local v = op[inst]
                if not v then return 0 end
                op[inst] = nil
                local sh, rf, mv, r, g, b = unpackO(v)
                pcall(putp, inst, "CastShadow", sh)
                if rank >= 2 then pcall(putp, inst, "Reflectance", rf) end
                if rank >= 3 then
                    pcall(putMat, inst, mv)
                    pcall(putp, inst, "Color", Color3.fromRGB(r, g, b))
                end
                local tx = ot[inst]
                if tx then
                    ot[inst] = nil
                    pcall(putp, inst, "TextureID", tx)
                    return 2
                end
                return 1
            elseif cat == 2 or cat == 3 then
                if og[inst] then og[inst] = nil pcall(putp, inst, "Enabled", true) return 1 end
            elseif cat == 4 then
                local v = og[inst]
                if v then og[inst] = nil pcall(putp, inst, "Transparency", v) return 1 end
            elseif cat == 5 then
                local tx = ot[inst]
                if tx then ot[inst] = nil pcall(putp, inst, "TextureId", tx) return 2 end
            end
            return 0
        end
        local function unboostChar(ch) -- karakter yang sempat ikut abu-abu (Character belum ter-set saat objeknya masuk) -> kembalikan
            local ok, list = pcall(ch.GetDescendants, ch)
            if ok then
                for i = 1, #list do
                    local c = list[i]
                    local cat = catOf(c)
                    if cat == 1 or cat == 7 or cat == 4 or cat == 5 then restoreInst(c, Boost.op, Boost.og, Boost.ot, Boost.rank) end -- partikel / lampu tetap mati
                end
            end
            local rem = Boost.removed
            for i = #rem, 1, -1 do
                local e = rem[i]
                if e[2] and (e[2] == ch or e[2]:IsDescendantOf(ch)) then
                    pcall(function() e[1].Parent = e[2] end)
                    table.remove(rem, i)
                end
            end
        end
        local function hookPlayer(plr)
            if plr.Character then Boost.chars[plr.Character] = true end
            Boost.conns[#Boost.conns + 1] = plr.CharacterAdded:Connect(function(ch)
                Boost.chars[ch] = true
                if Boost.on and Boost.keep then task.defer(unboostChar, ch) end
            end)
        end

        -- PERUBAHAN DUNIA: diberi jeda antar langkah supaya hitch-nya tidak menumpuk di satu frame
        local function worldOn(my, rank)
            if not Boost.fx then
                Boost.fx = {shadows = Lighting.GlobalShadows}
                pcall(function() Boost.fx.quality = settings().Rendering.QualityLevel end)
            end
            local fx = Boost.fx
            Lighting.GlobalShadows = false
            task.wait(0.5)
            if Boost.tok ~= my then return end
            pcall(function() settings().Rendering.QualityLevel = (rank >= 2) and Enum.QualityLevel.Level01 or Enum.QualityLevel.Level03 end)
            if rank < 2 then return end
            task.wait(0.5)
            if Boost.tok ~= my then return end
            local t = workspace.Terrain
            pcall(function()
                fx.water = fx.water or {t.WaterWaveSize, t.WaterWaveSpeed, t.WaterReflectance, t.WaterTransparency}
                t.WaterWaveSize, t.WaterWaveSpeed, t.WaterReflectance, t.WaterTransparency = 0, 0, 0, 0.9
            end)
            task.wait(0.3)
            if Boost.tok ~= my then return end
            pcall(function() if fx.deco == nil then fx.deco = gethiddenproperty(t, "Decoration") end sethiddenproperty(t, "Decoration", false) end)
        end
        local function worldOff()
            local fx = Boost.fx
            if not fx then return end
            Lighting.GlobalShadows = fx.shadows
            task.wait(0.4)
            if fx.quality then pcall(function() settings().Rendering.QualityLevel = fx.quality end) end
            task.wait(0.4)
            if fx.water then pcall(function() local t = workspace.Terrain t.WaterWaveSize, t.WaterWaveSpeed, t.WaterReflectance, t.WaterTransparency = fx.water[1], fx.water[2], fx.water[3], fx.water[4] end) end
            if fx.deco ~= nil then pcall(function() sethiddenproperty(workspace.Terrain, "Decoration", fx.deco) end) end
            Boost.fx = nil
        end
        local function pruneRemoved() -- SurfaceAppearance yang induknya sudah hilang (streaming) dibuang dari daftar restore
            local rem = Boost.removed
            if #rem < 2000 then return end
            local keep = {}
            for i = 1, #rem do
                local e = rem[i]
                if e[2] and e[2].Parent then keep[#keep + 1] = e end
            end
            Boost.removed = keep
        end
        local function guardWorld() -- game kadang menyalakan lagi bayangan / efek layar (mis. setelah teleport atau ganti map)
            if Lighting.GlobalShadows then Lighting.GlobalShadows = false end
            for _, e in ipairs(Lighting:GetChildren()) do
                if FX_CLASS[e.ClassName] and e.Enabled then
                    if Boost.og[e] == nil then Boost.og[e] = 1 end
                    e.Enabled = false
                end
            end
        end

        -- SCAN AWAL: DFS dengan tumpukan frame { list, i, lv }, dikerjakan bertahap mengikuti jatah governor
        local function posOf(c)
            if c:IsA("BasePart") then return c.Position end
            if c:IsA("Model") then return c:GetPivot().Position end
        end
        local function sortNear(list, lv) -- yang terdekat dari kamera dikerjakan lebih dulu (daftar kecil saja, supaya tidak hitch)
            local n = #list
            if n < 2 or n > 800 or lv > 3 then return end
            local cam = workspace.CurrentCamera
            if not cam then return end
            local o = cam.CFrame.Position
            local dist = {}
            for i = 1, n do
                local ok, pos = pcall(posOf, list[i])
                dist[list[i]] = (ok and pos) and (pos - o).Magnitude or 1e9
            end
            table.sort(list, function(a, b) return dist[a] < dist[b] end)
        end
        local function startScan(manual)
            Boost.count = 0
            local wsKids = workspace:GetChildren()
            sortNear(wsKids, 1)
            Boost.scan = {manual = manual, ui = 0, stack = {
                {list = Lighting:GetChildren(), i = 1, lv = EXPAND + 1},
                {list = wsKids, i = 1, lv = 1},
            }}
        end
        local function finishScan(s)
            Boost.scan = nil
            Boost.status()
            local msg
            if s.manual then
                msg = (Boost.count > 0) and ("+" .. kfmt(Boost.count) .. " objects") or "Nothing new"
            else
                msg = Boost.level .. " \194\183 " .. kfmt(Boost.count) .. " objects" -- "Ultra · 12.4k objects"
            end
            notify("FPS Boost", msg, T.accent, 2.5, "zap")
        end
        local function scanStep(s, rank, t0, used, cap) -- return used, selesai?
            local st, it = s.stack, 0
            while used < cap do
                local f = st[#st]
                if not f then return used, true end
                local c = f.list[f.i]
                if c == nil then
                    st[#st] = nil -- frame habis
                else
                    f.i = f.i + 1
                    used = used + work(c, rank)
                    local lv = f.lv
                    if lv ~= LEAF then
                        if lv <= EXPAND then
                            local ok, ch = pcall(c.GetChildren, c)
                            if ok and #ch > 0 then sortNear(ch, lv + 1) st[#st + 1] = {list = ch, i = 1, lv = lv + 1} end
                        else
                            local ok, ds = pcall(c.GetDescendants, c)
                            if ok and #ds > 0 then st[#st + 1] = {list = ds, i = 1, lv = LEAF} end
                        end
                    end
                end
                it = it + 1
                if it % 64 == 0 and os.clock() - t0 > TCAP then break end
            end
            return used, false
        end

        -- OBJEK BARU (streaming / teleport / spawn): langsung di-apply kalau jatah frame masih ada, sisanya antre
        local function push(d)
            local rank = Boost.rank
            local cat = catOf(d)
            if cat == 0 or (rank < 2 and cat >= 3 and cat <= 6) then return end
            local G = Boost.gov
            if Boost.qh > Boost.qt and G.cool == 0 and G.used < G.n then
                G.used = G.used + work(d, rank, cat)
            else
                local n = Boost.qt + 1
                Boost.qt = n
                Boost.q[n] = d
            end
        end
        local function drain() -- tiap Heartbeat: antrean live dulu (prioritas), sisa jatah untuk scan awal
            local G = Boost.gov
            if G.cool > 0 then G.cool = G.cool - 1 return end
            local s = Boost.scan
            if Boost.qh > Boost.qt and not s then return end
            local t0, rank, cap, it = os.clock(), Boost.rank, G.n, 0
            while Boost.qh <= Boost.qt and G.used < cap do
                local h = Boost.qh
                local d = Boost.q[h]
                Boost.q[h] = nil
                Boost.qh = h + 1
                if d then G.used = G.used + work(d, rank) end
                it = it + 1
                if it % 32 == 0 and os.clock() - t0 > TCAP then break end
            end
            if Boost.qh > Boost.qt then Boost.qh, Boost.qt = 1, 0 end
            if s and Boost.scan == s and G.used < cap and os.clock() - t0 < TCAP then
                local used, done = scanStep(s, rank, t0, G.used, cap)
                G.used = used
                if done then
                    finishScan(s)
                elseif t0 - s.ui > 0.6 then -- status di deskripsi toggle (tanpa toast)
                    s.ui = t0
                    Boost.status("Optimizing... " .. kfmt(Boost.count))
                end
            end
        end

        function Boost.enable()
            if Boost.on then return end
            Boost.on = true
            Boost.tok = Boost.tok + 1
            local my = Boost.tok
            Boost.rank = rankOf(Boost.level)
            Boost.q, Boost.qh, Boost.qt, Boost.scan = {}, 1, 0, nil
            local G = Boost.gov
            G.n, G.cool, G.used = 30, 0, 0
            task.spawn(function()
                while Boost.restoring do task.wait() end
                if Boost.tok ~= my then return end
                for _, plr in ipairs(Players:GetPlayers()) do hookPlayer(plr) end -- cache karakter dulu, baru scan
                local cs = Boost.conns
                cs[#cs + 1] = Players.PlayerAdded:Connect(hookPlayer)
                cs[#cs + 1] = workspace.DescendantAdded:Connect(push)
                cs[#cs + 1] = Lighting.DescendantAdded:Connect(push)
                cs[#cs + 1] = RunService.Heartbeat:Connect(function(dt) govTick(dt) drain() end)
                task.spawn(function() worldOn(my, Boost.rank) end)
                task.spawn(function() -- penjaga: bayangan / efek layar yang dinyalakan ulang game
                    local tick = 0
                    while Boost.on and Boost.tok == my do
                        task.wait(1.5)
                        if Boost.tok ~= my then break end
                        pcall(guardWorld)
                        tick = tick + 1
                        if tick % 20 == 0 then pcall(pruneRemoved) end
                    end
                end)
                startScan(false)
                Boost.status("Optimizing...")
            end)
        end
        function Boost.rescan() -- scan ulang tanpa restore: yang sudah beres cuma dibaca, tidak ditulis
            if not Boost.on or Boost.restoring then return end
            startScan(true)
        end

        local function pace(list, fn) -- jalankan fn(item) bertahap mengikuti governor (dipakai proses OFF)
            local G, i, n = Boost.gov, 1, #list
            while i <= n do
                govTick(RunService.Heartbeat:Wait())
                if G.cool > 0 then
                    G.cool = G.cool - 1
                else
                    local t0, used, it = os.clock(), 0, 0
                    while i <= n and used < G.n do
                        local e = list[i]
                        list[i] = false
                        i = i + 1
                        if e then used = used + fn(e) end
                        it = it + 1
                        if it % 32 == 0 and os.clock() - t0 > TCAP then break end
                    end
                    G.used = used
                end
            end
        end
        function Boost.disable()
            if not Boost.on then return end
            Boost.on = false
            Boost.tok = Boost.tok + 1
            for _, c in ipairs(Boost.conns) do pcall(function() c:Disconnect() end) end
            Boost.conns = {}
            Boost.q, Boost.qh, Boost.qt, Boost.scan = {}, 1, 0, nil
            Boost.restoring = true
            Boost.status("Restoring...")
            local op, og, ot, removed, rank = Boost.op, Boost.og, Boost.ot, Boost.removed, Boost.rank
            Boost.op, Boost.og, Boost.ot, Boost.removed = newWeak(), newWeak(), newWeak(), {}
            local G = Boost.gov
            G.n, G.cool, G.used = 30, 0, 0
            task.spawn(function()
                local function each(tbl)
                    local keys = {}
                    for k in pairs(tbl) do keys[#keys + 1] = k end
                    pace(keys, function(inst)
                        if inst.Parent then return restoreInst(inst, op, og, ot, rank) end
                        return 0
                    end)
                end
                each(op) -- part (bayangan / reflectance / material / warna / tekstur mesh)
                each(og) -- efek, lampu, decal
                each(ot) -- sisa (SpecialMesh)
                pace(removed, function(e) -- SurfaceAppearance dipasang kembali
                    pcall(function() if e[2] and e[2].Parent then e[1].Parent = e[2] end end)
                    return 4
                end)
                worldOff()
                Boost.restoring = false
                Boost.status()
                notify("FPS Boost", "Off", T.accent, 1.8, "zap")
            end)
        end
        function Boost.reapply()
            if not Boost.on then return end
            Boost.disable()
            task.spawn(function()
                while Boost.restoring do task.wait() end
                Boost.enable()
            end)
        end
        local bst = pf:Accordion({Title = "FPS Boost", Icon = "zap", Column = 2})
        local boostFlag = false
        local BOOST_IDLE = "Flat gray world, no effects. Characters stay colored"
        local boostTg = bst:Toggle({Title = "FPS Boost", Desc = BOOST_IDLE, Flag = "FpsBoost", Default = false,
            Callback = function(v)
                boostFlag = v and true or false
                if booting then
                    if v then -- saat load config (mis. setelah teleport): tunggu game selesai load + pilihan level & karakter terbaca dulu
                        task.spawn(function()
                            if not game:IsLoaded() then game.Loaded:Wait() end
                            task.wait(1.5)
                            if boostFlag then Boost.enable() end
                        end)
                    end
                    return
                end
                if v then Boost.enable() else Boost.disable() end
            end})
        Boost.status = function(msg) pcall(function() boostTg:SetDesc(msg or BOOST_IDLE) end) end -- progres tampil di deskripsi toggle
        bst:Dropdown({Title = "Boost level", Desc = "Light = effects off, Medium = no textures, Ultra = gray potato", Flag = "BoostLevel", Options = {"Light", "Medium", "Ultra"}, Default = "Ultra",
            Callback = function(v) Boost.level = v if not booting then Boost.reapply() end end})
        bst:Toggle({Title = "Keep characters colored", Desc = "Players stay normal while the world turns gray", Flag = "BoostChars", Default = true,
            Callback = function(v) Boost.keep = v and true or false if not booting then Boost.reapply() end end})
        bst:Button({Title = "Re-scan world", Desc = "Optimize objects that loaded after boosting", Callback = function()
            if Boost.on then Boost.rescan() else notify("FPS Boost", "Turn it on first", T.warn, 2, "zap") end
        end})
        gui.Destroying:Connect(function() if Boost.on then Boost.disable() end end)

        ---------------- GRAPHICS & AUDIO ----------------
        local gx = pf:Accordion({Title = "Graphics & Audio", Icon = "gauge", Column = 1})
        local qOrig
        local qOpts = {"Default"}
        for i = 1, 10 do qOpts[#qOpts + 1] = tostring(i) end
        gx:Dropdown({Title = "Graphics quality", Desc = "Roblox graphics level (1 = lowest)", Flag = "GfxQuality", Options = qOpts, Default = "Default",
            Callback = function(v)
                pcall(function()
                    local r = settings().Rendering
                    if v == "Default" then
                        if qOrig then r.QualityLevel = qOrig qOrig = nil end
                    else
                        qOrig = qOrig or r.QualityLevel
                        r.QualityLevel = Enum.QualityLevel[string.format("Level%02d", tonumber(v))]
                    end
                end)
            end})
        local focusConns = {}
        gx:Toggle({Title = "Unfocused FPS limit", Desc = "Drops to 15 FPS while Roblox is in the background", Flag = "UnfocusFps", Default = false,
            Callback = function(v)
                for _, c in ipairs(focusConns) do c:Disconnect() end
                focusConns = {}
                if not v or not setfpscap then return end
                focusConns[1] = UIS.WindowFocusReleased:Connect(function() pcall(setfpscap, 15) end)
                focusConns[2] = UIS.WindowFocused:Connect(function()
                    local c = F.FpsCap
                    pcall(setfpscap, (c == "Unlimited") and 0 or (tonumber(c) or 60))
                end)
            end})
        local volOrig
        gx:Toggle({Title = "Mute game audio", Desc = "Sets the Roblox master volume to 0", Flag = "MuteGame", Default = false,
            Callback = function(v)
                pcall(function()
                    local ugs = UserSettings():GetService("UserGameSettings")
                    if v then
                        volOrig = volOrig or ugs.MasterVolume
                        ugs.MasterVolume = 0
                    elseif volOrig then
                        ugs.MasterVolume = volOrig
                        volOrig = nil
                    end
                end)
            end})
        local fbConn, fbOrig
        gx:Toggle({Title = "Fullbright", Desc = "Bright, shadowless lighting at all times", Flag = "Fullbright", Default = false,
            Callback = function(v)
                if fbConn then fbConn:Disconnect() fbConn = nil end
                if v then
                    fbOrig = fbOrig or {Lighting.Brightness, Lighting.ClockTime, Lighting.FogEnd, Lighting.GlobalShadows, Lighting.Ambient, Lighting.OutdoorAmbient}
                    fbConn = RunService.Heartbeat:Connect(function()
                        Lighting.Brightness, Lighting.ClockTime, Lighting.FogEnd, Lighting.GlobalShadows = 2, 14, 9e9, false
                        Lighting.Ambient, Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178), Color3.fromRGB(178, 178, 178)
                    end)
                elseif fbOrig then
                    Lighting.Brightness, Lighting.ClockTime, Lighting.FogEnd, Lighting.GlobalShadows, Lighting.Ambient, Lighting.OutdoorAmbient = table.unpack(fbOrig)
                    fbOrig = nil
                end
            end})
        local fovConn, fovOrig, fovVal = nil, nil, 70
        local function fovApply(on)
            if fovConn then fovConn:Disconnect() fovConn = nil end
            local cam = workspace.CurrentCamera
            if on and cam then
                fovOrig = fovOrig or cam.FieldOfView
                fovConn = RunService.RenderStepped:Connect(function()
                    local c = workspace.CurrentCamera
                    if c then c.FieldOfView = fovVal end
                end)
            elseif fovOrig and cam then
                cam.FieldOfView = fovOrig
                fovOrig = nil
            end
        end
        gx:Toggle({Title = "Custom field of view", Desc = "Keep the camera FOV at the value below", Flag = "FovOn", Default = false,
            Callback = function(v) fovApply(v) end})
        gx:Slider({Title = "Field of view", Flag = "FovVal", Min = 40, Max = 120, Step = 1, Default = 70, Suffix = "°",
            Callback = function(v) fovVal = tonumber(v) or 70 end})
        gui.Destroying:Connect(function()
            if fbConn then fbConn:Disconnect() end
            if fbOrig then pcall(function() Lighting.Brightness, Lighting.ClockTime, Lighting.FogEnd, Lighting.GlobalShadows, Lighting.Ambient, Lighting.OutdoorAmbient = table.unpack(fbOrig) end) end
            fovApply(false)
            if volOrig then pcall(function() UserSettings():GetService("UserGameSettings").MasterVolume = volOrig end) end
        end)

        ---------------- NOTIFICATIONS ----------------
        local nf = S:SubTab({Title = "Notifications", Icon = "bell"})
        local n1 = nf:Accordion({Title = "Toasts", Icon = "bell", Column = 1})
        n1:Toggle({Title = "Show toasts", Desc = "Pop-ups at the corner of the screen", Flag = "NotifToasts", Default = true})
        n1:Dropdown({Title = "Toast position", Desc = "Where the pop-ups appear", Flag = "NotifPos",
            Options = {"Bottom right", "Bottom left", "Top right", "Top left"}, Default = "Bottom right",
            Callback = function(v) Toast.setPos(v) end})
        n1:Slider({Title = "Toast duration", Desc = "How long each toast stays", Flag = "NotifDurPct", Min = 50, Max = 200, Step = 10, Suffix = "%", Default = 100})
        n1:Toggle({Title = "Notify on load", Desc = "Toast when the script finishes loading", Flag = "NotifLoad", Default = true})

        local n2 = nf:Accordion({Title = "History", Icon = "list", Column = 2})
        n2:Button({Title = "Send test toast", Desc = "Preview the position and duration", Callback = function()
            notify("Test", "This is how a toast looks", T.accent, 3)
        end})
        n2:Button({Title = "Clear history", Desc = "Empty the list behind the bell", Callback = function()
            notifs = {}
            unread = 0
            updateBadge()
            rebuildNotifs()
        end})

        ---------------- ACCOUNT ----------------
        local ac = S:SubTab({Title = "Account", Icon = "user"})
        local c1 = ac:Accordion({Title = "Profile", Icon = "user", Column = 1})
        Stream.infos[1] = c1:Info({Title = "Username", Value = LPS.Name, Copy = true})
        Stream.infos[2] = c1:Info({Title = "Display name", Value = LPS.DisplayName, Copy = true})
        Stream.infos[3] = c1:Info({Title = "User ID", Value = tostring(LPS.UserId), Copy = true})
        c1:Info({Title = "Account age", Value = tostring(LPS.AccountAge) .. " days"})
        c1:Info({Title = "Membership", Value = (LPS.MembershipType == Enum.MembershipType.Premium) and "Premium" or "Standard"})
        c1:Info({Title = "Role", Value = tostring(C.Role or "OWNER")})
        c1:Info({Title = "Plan", Value = tostring(C.Plan or "Lifetime")})

        local c2 = ac:Accordion({Title = "Session", Icon = "activity", Column = 2})
        c2:Info({Title = "Place ID", Value = tostring(game.PlaceId), Copy = true})
        c2:Info({Title = "Server ID", Value = (#game.JobId > 0) and (game.JobId:sub(1, 8) .. "...") or "Studio",
            Callback = function()
                if #game.JobId > 0 then
                    copy(game.JobId)
                    notify("Copied", "Server ID copied", T.accent, 1.4)
                end
            end})
        local plInfo = c2:Info({Title = "Players", Value = #Players:GetPlayers() .. " / " .. Players.MaxPlayers})
        c2:Buttons({
            {Title = "Rejoin server", Callback = function()
                local TS = game:GetService("TeleportService")
                notify("Rejoin", "Teleporting...", T.accent, 2)
                pcall(function()
                    if #game.JobId > 0 then TS:TeleportToPlaceInstance(game.PlaceId, game.JobId, LPS) else TS:Teleport(game.PlaceId, LPS) end
                end)
            end},
            {Title = "Refresh", Callback = function()
                plInfo:Set(#Players:GetPlayers() .. " / " .. Players.MaxPlayers)
            end},
        })

        ---------------- ABOUT ----------------
        local ab = S:SubTab({Title = "About", Icon = "info"})
        local exeName = "Unknown"
        pcall(function()
            if identifyexecutor then
                local n, v = identifyexecutor()
                exeName = tostring(n) .. (v and (" " .. tostring(v)) or "")
            end
        end)
        local b1 = ab:Accordion({Title = SX.Name, Icon = "info", Column = 1})
        b1:Info({Title = "Version", Value = "v" .. VERSION})
        b1:Info({Title = "Executor", Value = exeName})
        b1:Info({Title = "Config folder", Value = CFG})
        b1:Paragraph({Title = "About", Desc = "A dark interface with a live FPS pill, 45 accent themes, per-game configs and a full settings page."})

        local b2 = ab:Accordion({Title = "What's new in v" .. VERSION, Icon = "star", Column = 2})
        b2:Paragraph({Title = "FPS Boost", Desc = "Performance > FPS Boost turns the world into flat gray graphics (Light, Medium or Ultra). Characters stay colored."})
        b2:Paragraph({Title = "12 new settings", Desc = "Anti-AFK, auto rejoin, server hop, streamer mode, copy config, animation speed and style, graphics quality, unfocused FPS limit, mute, fullbright and FOV."})
        b2:Paragraph({Title = "Smoother motion", Desc = "Opening and closing, page changes, toggles, buttons and dropdowns were re-animated."})

        local b3 = ab:Accordion({Title = "Actions", Icon = "send", Column = 1})
        b3:Button({Title = "Copy debug info", Desc = "Version, executor, place and user", Callback = function()
            copy(SX.Name .. " v" .. VERSION .. " | " .. exeName .. " | place " .. tostring(game.PlaceId) .. " | " .. LPS.Name)
            notify("Copied", "Debug info copied", T.accent, 1.6)
        end})
        local unRef = {}
        unRef.b = b3:Button({Title = "Unload UI", Desc = "Close and remove " .. SX.Name, Callback = twoTap(unRef, "Close and remove " .. SX.Name, function()
            gui:Destroy()
        end)})

        booting = false
        Stream.apply()
    end
    Window._buildSettings()
    Window._buildSettings = nil
    if F.UIPill == false then launcher.Visible = false end

    ------------------------------------------------------------------
    -- DEMO: tiruan isi video (C.Demo = true). Dashboard / GrowBlox (Farm + 6 sub-tab) / Settings
    ------------------------------------------------------------------
    if C.Demo then
        local dash = Window.Dashboard or Window:Group({Title = "Dashboard", Icon = "grid"}):Tab({Title = "Dashboard", Icon = "grid"}) -- sudah otomatis di grup "Loaded"
        local c1 = dash:Accordion({Title = "Components", Icon = "layers", Column = 1})
        c1:Button({Title = "Button", Desc = "Click me", Callback = function() notify("Button", "Clicked", T.accent, 1.5) end})
        c1:Toggle({Title = "Toggle", Desc = "Switch with a description", Flag = "Demo_Toggle", Default = true})
        c1:Slider({Title = "Slider", Desc = "Drag the knob", Flag = "Demo_Slider", Min = 0, Max = 100, Default = 40, Suffix = "%"})
        c1:Textbox({Title = "Textbox", Flag = "Demo_Text", Placeholder = "Type here..."})
        local c2 = dash:Accordion({Title = "Inputs", Icon = "sliders", Column = 2})
        c2:Dropdown({Title = "Dropdown", Flag = "Demo_DD", Options = {"Alpha", "Beta", "Gamma"}, Default = "Alpha"})
        c2:Keybind({Title = "Keybind", Flag = "Demo_Key", Default = Enum.KeyCode.F})
        c2:ColorPicker({Title = "Color picker", Flag = "Demo_Col", Default = T.accent})
        c2:Info({Title = "Version", Value = "v" .. VERSION})
        local c3 = dash:Accordion({Title = "About", Icon = "info", Column = 1})
        c3:Paragraph({Title = "Sphinx style", Desc = "Dark cards, Sphinx accent, pill launcher at the top. Tap the pill to open or close."})

        local GB = Window:Group({Title = "GrowBlox", Icon = "sprout"})
        local farm = GB:Tab({Title = "Farm", Icon = "pickaxe", Subtitle = "Clear, mine, farm, loot"})
        local cw = farm:SubTab({Title = "Clear World", Icon = "eraser"})
        local a = cw:Accordion({Title = "Clear World", Icon = "eraser", Column = 1})
        a:Toggle({Title = "Auto Clear World", Desc = "Break every tile, row by row", Flag = "CW_Auto", Default = false})
        a:Dropdown({Title = "Targets", Flag = "CW_Targets", Options = {"Everything", "Blocks", "Background", "Hazards"}, Default = "Everything"})
        a:Toggle({Title = "Clear background", Desc = "Also break the cave layer", Flag = "CW_Bg", Default = true})
        a:Toggle({Title = "Break lava / spikes", Desc = "Hit them from a safe distance", Flag = "CW_Lava", Default = true})
        a:Toggle({Title = "Break trees", Desc = "Planted trees are skipped by default", Flag = "CW_Trees", Default = false})
        local pr = cw:Accordion({Title = "Progress", Icon = "activity", Column = 1})
        pr:Section("Clear")
        pr:Label("Idle")
        local pc = cw:Accordion({Title = "Pace", Icon = "gauge", Column = 2})
        pc:Dropdown({Title = "Hit method", Flag = "CW_Method", Options = {"Hold", "Tap", "Burst"}, Default = "Hold"})
        pc:Slider({Title = "Hit interval", Desc = "Act call only, game cooldown 0.22s", Flag = "CW_Interval", Min = 0.05, Max = 1, Step = 0.01, Default = 0.25, Suffix = "s"})
        pc:Button({Title = "Test one hit", Desc = "Checks the server keeps the break", Callback = function() notify("Test", "One hit sent", T.accent, 1.5) end})
        pc:Toggle({Title = "Pick up drops", Desc = "Take drops while clearing", Flag = "CW_Drops", Default = true})
        pc:Slider({Title = "Pickup radius", Desc = "Tiles around you", Flag = "CW_Radius", Min = 1, Max = 8, Step = 0.1, Default = 2.2})

        local mine = farm:SubTab({Title = "Mine", Icon = "pickaxe"})
        local am = mine:Accordion({Title = "Auto Mine", Icon = "pickaxe", Column = 1})
        am:Toggle({Title = "Auto Mine", Desc = "Break matching blocks nearby", Flag = "M_Auto"})
        am:Textbox({Title = "Filter", Flag = "M_Filter", Placeholder = "name or id, comma separated"})
        am:Slider({Title = "Radius", Desc = "Tiles from where you stand", Flag = "M_Radius", Min = 1, Max = 12, Default = 3})
        am:Toggle({Title = "Single block", Desc = "Stop after one block", Flag = "M_Single"})
        am:Toggle({Title = "Whole world", Desc = "Ignore radius, farm until gone", Flag = "M_World"})
        local dd = mine:Accordion({Title = "Auto Dig Down", Icon = "pickaxe", Column = 2})
        dd:Toggle({Title = "Auto Dig Down", Desc = "Break the block below, fall, repeat", Flag = "M_Dig"})
        dd:Toggle({Title = "Stop before hazards", Desc = "Act call only, game cooldown 0.22s", Flag = "M_Haz", Default = true})
        local fs = mine:Accordion({Title = "Farm Selected", Icon = "target", Column = 1})
        fs:Textbox({Title = "Block", Flag = "FS_Block", Default = "Rock"})
        fs:Buttons({{Title = "Add"}, {Title = "Clear"}})
        fs:Section("Targets")
        fs:Label("Lava #4, Rock #10")
        fs:Toggle({Title = "Auto Farm Selected", Desc = "Digs top-down to every target", Flag = "FS_Auto"})
        fs:Toggle({Title = "Collect drops", Desc = "Pick up seeds / gems / blocks after a break", Flag = "FS_Drops", Default = true})
        fs:Slider({Title = "Collect range", Desc = "Tiles to walk for a drop", Flag = "FS_Range", Min = 1, Max = 12, Default = 6})
        fs:Section("Status")
        fs:Label("Off")
        fs:Label("Targets broken 0 | Dug 0 | Left ?")

        for _, nm in ipairs({{"Farm", "sprout"}, {"Loot", "box"}, {"Dirt Farm", "layers"}, {"Harvest", "wheat"}}) do
            local st = farm:SubTab({Title = nm[1], Icon = nm[2]})
            local card = st:Accordion({Title = nm[1], Icon = nm[2], Column = 1})
            card:Toggle({Title = "Auto " .. nm[1], Desc = "Turn the " .. nm[1]:lower() .. " routine on", Flag = "T_" .. nm[1]})
            card:Slider({Title = "Delay", Desc = "Seconds between actions", Flag = "T_" .. nm[1] .. "_D", Min = 0, Max = 2, Step = 0.05, Default = 0.2, Suffix = "s"})
        end
        GB:Tab({Title = "Move", Icon = "zap", Subtitle = "Movement helpers"}):Accordion({Title = "Movement", Icon = "zap"}):Toggle({Title = "Fast walk", Desc = "Move quicker than normal", Flag = "Mv_Fast"})
        GB:Tab({Title = "Utility", Icon = "wrench", Subtitle = "Small tools"}):Accordion({Title = "Utility", Icon = "wrench"}):Toggle({Title = "Anti AFK", Desc = "Prevent the idle kick", Flag = "Ut_AFK", Default = true})

        local SG = Window:Group({Title = "Settings", Icon = "sliders"})
        local cfg = SG:Tab({Title = "Config", Icon = "save", Subtitle = "Save and load your settings"})
        local cc = cfg:Accordion({Title = "Configs", Icon = "save", Column = 1})
        local cname = cc:Textbox({Title = "Config name", Flag = "Cfg_Name", Default = "default"})
        cc:Buttons({
            {Title = "Save", Callback = function() Window:SaveConfig(cname:Get()) notify("Config", "Saved " .. tostring(cname:Get()), T.ok, 2) end},
            {Title = "Load", Callback = function()
                local ok, err = Window:LoadConfig(cname:Get())
                notify("Config", ok and ("Loaded " .. tostring(cname:Get())) or tostring(err), ok and T.ok or T.bad, 2)
            end},
        })
    end

    if F.StartMode ~= "Stay minimized" then openA() end
    if F.NotifLoad ~= false then notify(LOGONAME, "Loaded successfully, press " .. toggleKey.Name .. " to toggle UI", T.ok, 4) end
    return Window
end

