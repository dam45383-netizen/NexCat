function WindowClass:SetSize(size)
	if not self.Frame or not size then
		return false
	end

	local viewport = self.Gui and self.Gui.AbsoluteSize or nil
	if not viewport or viewport.X < 1 or viewport.Y < 1 then
		viewport = ViewportSize()
	end
	local requestedWidth, requestedHeight
	if typeof(size) == "Vector2" then
		requestedWidth, requestedHeight = size.X, size.Y
	elseif typeof(size) == "UDim2" then
		requestedWidth = size.X.Scale * viewport.X + size.X.Offset
		requestedHeight = size.Y.Scale * viewport.Y + size.Y.Offset
	else
		return false
	end

	local limits = self._sizeLimits or {}
	local maxWidth = math.max(160, math.min(tonumber(limits.MaxWidth) or viewport.X - 24, math.max(160, viewport.X - 24)))
	local maxHeight = math.max(180, math.min(tonumber(limits.MaxHeight) or viewport.Y - 24, math.max(180, viewport.Y - 24)))
	local minWidth = math.min(tonumber(limits.MinWidth) or 320, maxWidth)
	local minHeight = math.min(tonumber(limits.MinHeight) or 260, maxHeight)
	local width = math.floor(math.clamp(requestedWidth, minWidth, maxWidth) + 0.5)
	local height = math.floor(math.clamp(requestedHeight, minHeight, maxHeight) + 0.5)
	self.Frame.Size = UDim2.fromOffset(width, height)
	return true
end

function WindowClass:SetUIScale(value)
	local scale = tonumber(value)
	if not scale then
		return false
	end
	self._baseScale = math.clamp(scale, 0.65, 1.5)
	if self._scale then
		if self.Opened then
			Tween(self._scale, { Scale = self._baseScale }, 0.2)
		else
			self._scale.Scale = self._baseScale * 0.9
		end
	end
	return true
end

function WindowClass:_ApplySavedState(state)
	if type(state) ~= "table" or not self.Frame or not self.Frame.Parent then
		return false
	end

	local width = tonumber(state.Width)
	local height = tonumber(state.Height)
	if width and height then
		self:SetSize(Vector2.new(width, height))
	end

	local position = state.Position
	if type(position) == "table" then
		local viewport = self.Gui and self.Gui.AbsoluteSize or nil
		if not viewport or viewport.X < 1 or viewport.Y < 1 then
			viewport = ViewportSize()
		end
		local xScale = tonumber(position.XScale) or 0.5
		local yScale = tonumber(position.YScale) or 0.5
		local xOffset = tonumber(position.XOffset) or 0
		local yOffset = tonumber(position.YOffset) or 0
		local actualX = xScale * viewport.X + xOffset
		local actualY = yScale * viewport.Y + yOffset
		local halfWidth = self.Frame.AbsoluteSize.X / 2
		local halfHeight = self.Frame.AbsoluteSize.Y / 2
		actualX = math.clamp(actualX, math.min(halfWidth + 8, viewport.X / 2), math.max(viewport.X - halfWidth - 8, viewport.X / 2))
		actualY = math.clamp(actualY, math.min(halfHeight + 8, viewport.Y / 2), math.max(viewport.Y - halfHeight - 8, viewport.Y / 2))
		self.Frame.Position = UDim2.new(
			xScale,
			actualX - xScale * viewport.X,
			yScale,
			actualY - yScale * viewport.Y
		)
	end

	local scale = tonumber(state.UIScale)
	if scale then
		self:SetUIScale(scale)
	end
	return true
end

