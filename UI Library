-- kartu dasar: return row, inner, header, title, desc, lock
-- widget kanan taruh di `header` dengan LayoutOrder = 2
-- rightWidth = lebar widget kanan (px), noIcon = jangan pasang icon di kiri
local function Card(container, cfg, rightWidth, noIcon)
	local window = container._window
	local row = New("Frame", {
		Name = tostring(cfg.Title or "Element"),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = NextOrder(container._content),
		BackgroundTransparency = ElementTransparency,
		Theme = { BackgroundColor3 = "Text" },
		Parent = container._content,
	})
	Corner(row, window.ElementRadius)
	Stroke(row, "Outline", 1, 0.92)

	local inner = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = row,
	})
	Pad(inner, 12, 14, 12, 14)
	List(inner, 10)

	local header = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		Parent = inner,
	})
	New("UISizeConstraint", { MinSize = Vector2.new(0, 26), Parent = header })
	List(header, 10, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)

	local leftIcon
	if not noIcon then
		leftIcon = MakeIcon(header, cfg.Icon, 18, "Icon", cfg.IconThemed)
		if leftIcon then
			leftIcon.LayoutOrder = 0
		end
	end

	local offset = (leftIcon and 28 or 0) + (rightWidth and (rightWidth + 10) or 0)
	local left = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -offset, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		Parent = header,
	})
	List(left, 2)

	local title = Text(left, cfg.Title or "", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		RichText = true,
		TextSize = 15,
		LayoutOrder = 1,
	})
	local hasDesc = cfg.Desc ~= nil and cfg.Desc ~= ""
	local desc = Text(left, cfg.Desc or "", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		RichText = true,
		Weight = "Regular",
		TextSize = 13,
		TextTransparency = 0.4,
		Visible = hasDesc,
		LayoutOrder = 2,
	})

	local lock = New("TextButton", {
		Name = "Lock",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 0.45,
		Text = "",
		AutoButtonColor = false,
		Visible = cfg.Locked == true,
		ZIndex = 10,
		Theme = { BackgroundColor3 = "Background" },
		Parent = row,
	})
	Corner(lock, window.ElementRadius)

	return row, inner, header, title, desc, lock
end

-- method umum untuk semua element
local function Finish(container, cfg, obj, row, title, desc, lock)
	obj.Element = row
	local window = container._window
	window._elements[#window._elements + 1] = obj
	function obj:SetTitle(value)
		title.Text = tostring(value)
	end
	function obj:SetDesc(value)
		value = value or ""
		desc.Text = tostring(value)
		desc.Visible = value ~= ""
	end
	function obj:Lock()
		if lock then
			lock.Visible = true
		end
	end
	function obj:Unlock()
		if lock then
			lock.Visible = false
		end
	end
	function obj:SetVisible(visible)
		row.Visible = visible and true or false
	end
	function obj:Destroy()
		if obj.Flag then
			window.Flags[obj.Flag] = nil
		end
		row:Destroy()
	end
	if cfg.Flag then
		obj.Flag = cfg.Flag
		window.Flags[cfg.Flag] = obj
		local pending = window._pendingConfig
		if pending and pending[cfg.Flag] ~= nil then
			local raw = pending[cfg.Flag]
			pending[cfg.Flag] = nil
			task.defer(ApplyValue, obj, raw)
		end
	end
	return obj
end

