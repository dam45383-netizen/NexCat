function WindowClass:SelectTab(target)
	local tab = target
	if type(target) == "number" then
		tab = self.Tabs[target]
	end
	if not tab or self._selected == tab then
		return
	end
	self:_ClosePopup()
	if self._selected then
		self._selected:_SetActive(false)
	end
	self._selected = tab
	tab:_SetActive(true)
end

function WindowClass:Tab(cfg)
	return CreateTab(self, self._tabList, cfg)
end

