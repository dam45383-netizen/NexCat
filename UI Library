local function IsAsset(value)
	return type(value) == "string"
		and (value:find("^rbxassetid://") ~= nil or value:find("^rbxasset://") ~= nil or value:find("^rbxthumb://") ~= nil)
end

-- return: nilai (asset / teks), apakah boleh di-tint mengikuti tema
local function ResolveIcon(icon)
	if icon == nil or icon == "" then
		return nil
	end
	if type(icon) == "number" then
		return "rbxassetid://" .. icon, false
	end
	if type(icon) ~= "string" then
		return tostring(icon), false
	end
	if IsAsset(icon) then
		return icon, false
	end
	if icon:find("^data:image") or icon:find("^base64:") then
		local name = "inline_" .. #icon
		if NexCat.Icons[name] == nil then
			NexCat.Icons[name] = { Base64 = icon:gsub("^base64:", ""), Tint = false, Fallback = "?" }
		end
		icon = name
	end

	local key = icon
	local entry = NexCat.Icons[key]
	if entry == nil then
		local stripped = key:match("^%a+:(.+)$")
		if stripped then
			key = stripped
			entry = NexCat.Icons[key]
		end
	end
	if entry == nil then
		local normalized = key:lower()
		normalized = normalized:gsub("_", "-")
		entry = NexCat.Icons[normalized]
	end

	if type(entry) == "table" then
		local asset = entry.Base64 and LoadBase64Image(key, entry.Base64)
		if asset then
			return asset, entry.Tint ~= false
		end
		return entry.Fallback or "?", false
	end
	if type(entry) == "number" then
		return "rbxassetid://" .. entry, false
	end
	if entry ~= nil then
		return entry, false
	end
	return key, false
end

-- themed = true -> gambar user (rbxassetid) juga di-tint
local function MakeIcon(parent, icon, size, tintSource, themed)
	local resolved, tintable = ResolveIcon(icon)
	if resolved == nil then
		return nil
	end
	size = size or 18
	if IsAsset(resolved) then
		local props = {
			BackgroundTransparency = 1,
			Image = resolved,
			Size = UDim2.fromOffset(size, size),
			Parent = parent,
		}
		if tintSource and (tintable or themed) then
			props.Theme = { ImageColor3 = tintSource }
		end
		return New("ImageLabel", props)
	end
	return New("TextLabel", {
		BackgroundTransparency = 1,
		Text = tostring(resolved),
		TextSize = math.max(size - 3, 8),
		Font = FontOf("Bold"),
		Size = UDim2.fromOffset(size, size),
		Theme = { TextColor3 = tintSource or "Text" },
		Parent = parent,
	})
end

local function IconAlpha(icon, alpha, duration)
	if not icon then
		return
	end
	local prop = icon:IsA("ImageLabel") and "ImageTransparency" or "TextTransparency"
	if duration then
		Tween(icon, { [prop] = alpha }, duration)
	else
		icon[prop] = alpha
	end
end

