-- Config (simpan / muat nilai element)
-- ============================================================

local function Encode(value)
	local t = typeof(value)
	if t == "Color3" then
		return { __t = "C3", r = value.R, g = value.G, b = value.B }
	elseif t == "EnumItem" then
		return { __t = "E", n = value.Name }
	elseif type(value) == "table" then
		local out = {}
		for i, v in ipairs(value) do
			out[i] = v
		end
		return out
	end
	return value
end

local function Decode(value)
	if type(value) == "table" then
		if value.__t == "C3" then
			return Color3.new(value.r, value.g, value.b)
		elseif value.__t == "E" then
			return value.n
		end
	end
	return value
end

local function FSAvailable()
	return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
end

local function EnsureFolder(path)
	if type(isfolder) == "function" and type(makefolder) == "function" then
		local built = ""
		for part in path:gmatch("[^/\\]+") do
			built = built == "" and part or (built .. "/" .. part)
			if not isfolder(built) then
				pcall(makefolder, built)
			end
		end
	end
end

function ConfigClass:Register(flag, element)
	self._extra[flag] = element
	return element
end

function ConfigClass:_Collect()
	local data = {}
	for flag, element in pairs(self.Window.Flags) do
		if element.Get then
			data[flag] = Encode(element:Get())
		end
	end
	for flag, element in pairs(self._extra) do
		if element.Get then
			data[flag] = Encode(element:Get())
		end
	end
	return data
end

function ConfigClass:_Apply(data)
	for flag, raw in pairs(data) do
		local element = self._extra[flag] or self.Window.Flags[flag]
		if element and element.Set then
			pcall(element.Set, element, Decode(raw))
		end
	end
end

-- Export/Import jalan di mana saja (termasuk Studio), Save/Load butuh filesystem executor
function ConfigClass:Export()
	return HttpService:JSONEncode(self:_Collect())
end

function ConfigClass:Import(json)
	local ok, data = pcall(function()
		return HttpService:JSONDecode(json)
	end)
	if not ok or type(data) ~= "table" then
		return false, "JSON tidak valid"
	end
	self:_Apply(data)
	return true
end

function ConfigClass:Save()
	if not FSAvailable() then
		return false, "Filesystem tidak tersedia di environment ini"
	end
	EnsureFolder(self.Manager.Path)
	local ok, err = pcall(writefile, self.Path, self:Export())
	return ok, err
end

function ConfigClass:Load()
	if not FSAvailable() then
		return false, "Filesystem tidak tersedia di environment ini"
	end
	if not isfile(self.Path) then
		return false, "File config belum ada"
	end
	local ok, content = pcall(readfile, self.Path)
	if not ok then
		return false, content
	end
	return self:Import(content)
end

function ConfigClass:Delete()
	if FSAvailable() and type(delfile) == "function" and isfile(self.Path) then
		pcall(delfile, self.Path)
		return true
	end
	return false
end

local function NewConfigManager(window)
	local manager = {
		Window = window,
		Path = window.Folder .. "/configs",
		Configs = {},
	}
	function manager:CreateConfig(name)
		name = tostring(name or "default"):gsub("[^%w_%-]", "_")
		local config = setmetatable({
			Name = name,
			Window = window,
			Manager = manager,
			Path = manager.Path .. "/" .. name .. ".json",
			_extra = {},
		}, ConfigClass)
		manager.Configs[name] = config
		return config
	end
	function manager:GetConfig(name)
		return manager.Configs[name]
	end
	function manager:AllConfigs()
		local names = {}
		if type(listfiles) == "function" and type(isfolder) == "function" and isfolder(manager.Path) then
			local ok, files = pcall(listfiles, manager.Path)
			if ok then
				for _, file in ipairs(files) do
					local name = tostring(file):match("([^/\\]+)%.json$")
					if name then
						names[#names + 1] = name
					end
				end
			end
		end
		return names
	end
	return manager
end

-- ============================================================
-- Popup & Dialog (method Window)
-- ============================================================

function WindowClass:_Surface(inst, amount)
	self._surfaces[#self._surfaces + 1] = { inst, amount }
	if self.Transparent then
		inst.BackgroundTransparency = amount
	end
end

function WindowClass:SetTransparent(enabled)
	self.Transparent = enabled and true or false
	for _, entry in ipairs(self._surfaces) do
		if entry[1].Parent ~= nil then
			Tween(entry[1], { BackgroundTransparency = self.Transparent and entry[2] or 0 }, 0.25)
		end
	end
end

function WindowClass:_Connect(signal, fn)
	local connection = signal:Connect(fn)
	self._conns[#self._conns + 1] = connection
	return connection
end

function WindowClass:_ClosePopup()
	if self._popup then
		local overlay = self._popup
		self._popup = nil
		overlay:Destroy()
	end
end

-- buka popup melayang di bawah/atas anchor. return: frame popup
function WindowClass:_OpenPopup(anchor, width, height, alignRight)
	self:_ClosePopup()
	local overlay = New("TextButton", {
		Name = "PopupOverlay",
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50,
		Parent = self.Gui,
	})
	overlay.MouseButton1Click:Connect(function()
		self:_ClosePopup()
	end)

	local viewport = self.Gui.AbsoluteSize
	if viewport.X < 1 or viewport.Y < 1 then
		viewport = ViewportSize()
	end
	local pos, size = anchor.AbsolutePosition, anchor.AbsoluteSize
	local x = alignRight and (pos.X + size.X - width) or pos.X
	x = math.clamp(x, 8, math.max(8, viewport.X - width - 8))

	local below = viewport.Y - (pos.Y + size.Y) - 12
	local above = pos.Y - 12
	local placeAbove = height > below and above > below
	height = math.min(height, math.max(placeAbove and above or below, 90))

	local popup = New("Frame", {
		Name = "Popup",
		Active = true,
		ClipsDescendants = true,
		AnchorPoint = Vector2.new(0, placeAbove and 1 or 0),
		Position = UDim2.fromOffset(x, placeAbove and (pos.Y - 4) or (pos.Y + size.Y + 4)),
		Size = UDim2.fromOffset(width, 0),
		ZIndex = 51,
		Theme = { BackgroundColor3 = "Surface" },
		Parent = overlay,
	})
	Corner(popup, 10)
	Stroke(popup, "Stroke", 1, 0.1)
	Tween(popup, { Size = UDim2.fromOffset(width, height) }, 0.18)
	self._popup = overlay
	return popup
end

function WindowClass:Dialog(cfg)
	cfg = cfg or {}
	local viewport = ViewportSize()
	local overlay = New("TextButton", {
		Name = "Dialog",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 80,
		Parent = self.Gui,
	})
	Tween(overlay, { BackgroundTransparency = 0.5 }, 0.2)

	local card = New("Frame", {
		Name = "Card",
		Active = true,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(math.min(380, viewport.X - 40), 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 81,
		Theme = { BackgroundColor3 = "Surface" },
		Parent = overlay,
	})
	Corner(card, 12)
	Stroke(card, "Stroke", 1, 0.1)
	local scale = New("UIScale", { Scale = 0.9, Parent = card })
	Tween(scale, { Scale = 1 }, 0.25, Enum.EasingStyle.Back)

	local inner = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = card,
	})
	Pad(inner, 18)
	List(inner, 10)

	local head = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 22),
		LayoutOrder = 1,
		Parent = inner,
	})
	List(head, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local icon = MakeIcon(head, cfg.Icon, 20)
	if icon then
		icon.LayoutOrder = 1
	end
	Text(head, cfg.Title or "Dialog", {
		Size = UDim2.new(1, icon and -28 or 0, 1, 0),
		Font = Enum.Font.GothamBold,
		TextSize = 16,
		LayoutOrder = 2,
	})

	if cfg.Content and cfg.Content ~= "" then
		Text(inner, cfg.Content, {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			Font = Enum.Font.Gotham,
			TextSize = 13,
			RichText = true,
			LayoutOrder = 2,
			Theme = { TextColor3 = "SubText" },
		})
	end

	local buttonRow = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 34),
		LayoutOrder = 3,
		Parent = inner,
	})
	List(buttonRow, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)

	local dialog = {}
	local closed = false
	function dialog:Close()
		if closed then
			return
		end
		closed = true
		Tween(overlay, { BackgroundTransparency = 1 }, 0.15)
		Tween(scale, { Scale = 0.92 }, 0.15)
		task.delay(0.16, function()
			overlay:Destroy()
		end)
	end

	local buttons = cfg.Buttons
	if not buttons or #buttons == 0 then
		buttons = { { Title = "OK", Variant = "Primary" } }
	end
	for i, def in ipairs(buttons) do
		local variant = def.Variant or (i == #buttons and "Primary" or "Secondary")
		local bgKey = variant == "Primary" and "Accent" or variant == "Danger" and "Danger" or "Element"
		local fgKey = variant == "Primary" and "AccentText" or variant == "Danger" and "AccentText" or "Text"
		local button = New("TextButton", {
			Size = UDim2.fromOffset(0, 34),
			AutomaticSize = Enum.AutomaticSize.X,
			Text = def.Title or "OK",
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			AutoButtonColor = false,
			LayoutOrder = i,
			ZIndex = 82,
			Theme = { BackgroundColor3 = bgKey, TextColor3 = fgKey },
			Parent = buttonRow,
		})
		Corner(button, 8)
		Pad(button, 0, 16, 0, 16)
		if variant == "Secondary" then
			Stroke(button, "Stroke", 1, 0.2)
		end
		button.MouseEnter:Connect(function()
			Tween(button, { BackgroundTransparency = 0.15 }, 0.12)
		end)
		button.MouseLeave:Connect(function()
			Tween(button, { BackgroundTransparency = 0 }, 0.12)
		end)
		button.MouseButton1Click:Connect(function()
			Fire(def.Callback)
			if def.Keep ~= true then
				dialog:Close()
			end
		end)
	end

	if cfg.Dismissible then
		overlay.MouseButton1Click:Connect(function()
			dialog:Close()
		end)
	end
	return dialog
end

function WindowClass:Notify(cfg)
	return NekoUI:Notify(cfg)
end

