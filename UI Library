-- Utilities
-- ============================================================

local Bound = {}

local function Tween(inst, props, duration, style, direction)
	local tween = TweenService:Create(
		inst,
		TweenInfo.new(duration or 0.2, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out),
		props
	)
	tween:Play()
	return tween
end

local function Resolve(source)
	if type(source) == "function" then
		return source(NekoUI.Theme)
	end
	return NekoUI.Theme[source]
end

-- ikat properti ke theme: source = nama key theme atau function(theme) -> nilai
local function Bind(inst, prop, source)
	inst[prop] = Resolve(source)
	Bound[#Bound + 1] = { inst, prop, source }
end

local function New(class, props, children)
	local inst = Instance.new(class)
	local parent
	for key, value in pairs(props or {}) do
		if key == "Parent" then
			parent = value
		elseif key == "Theme" then
			for prop, source in pairs(value) do
				Bind(inst, prop, source)
			end
		else
			inst[key] = value
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = inst
		end
	end
	inst.Parent = parent
	return inst
end

local function Corner(parent, radius)
	return New("UICorner", { CornerRadius = UDim.new(0, radius or 8), Parent = parent })
end

local function Stroke(parent, source, thickness, transparency)
	return New("UIStroke", {
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Theme = { Color = source or "Stroke" },
		Parent = parent,
	})
end

local function Pad(parent, top, right, bottom, left)
	right = right or top
	bottom = bottom or top
	left = left or right
	return New("UIPadding", {
		PaddingTop = UDim.new(0, top),
		PaddingRight = UDim.new(0, right),
		PaddingBottom = UDim.new(0, bottom),
		PaddingLeft = UDim.new(0, left),
		Parent = parent,
	})
end

local function List(parent, padding, direction, hAlign, vAlign)
	return New("UIListLayout", {
		Padding = UDim.new(0, padding or 0),
		FillDirection = direction or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		Parent = parent,
	})
end

local function Text(parent, text, props)
	local p = {
		BackgroundTransparency = 1,
		Text = text or "",
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Theme = { TextColor3 = "Text" },
		Parent = parent,
	}
	if props then
		for key, value in pairs(props) do
			p[key] = value
		end
	end
	return New("TextLabel", p)
end

local function MakeIcon(parent, icon, size, tintSource)
	if icon == nil or icon == "" then
		return nil
	end
	icon = NekoUI.Icons[icon] or icon
	size = size or 18
	if type(icon) == "number" then
		icon = "rbxassetid://" .. icon
	end
	if type(icon) == "string" and (icon:find("^rbxassetid://") or icon:find("^rbxasset://")) then
		return New("ImageLabel", {
			BackgroundTransparency = 1,
			Image = icon,
			Size = UDim2.fromOffset(size, size),
			Theme = tintSource and { ImageColor3 = tintSource } or nil,
			Parent = parent,
		})
	end
	return New("TextLabel", {
		BackgroundTransparency = 1,
		Text = tostring(icon),
		TextSize = size - 3,
		Font = Enum.Font.GothamBold,
		Size = UDim2.fromOffset(size, size),
		Theme = { TextColor3 = tintSource or "Text" },
		Parent = parent,
	})
end

local function NextOrder(parent)
	local n = (parent:GetAttribute("_n") or 0) + 1
	parent:SetAttribute("_n", n)
	return n
end

local function Fire(callback, ...)
	if type(callback) ~= "function" then
		return
	end
	local ok, err = pcall(callback, ...)
	if not ok then
		warn("[NekoUI] Callback error: " .. tostring(err))
	end
end

local function IsPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

-- drag generik (mouse + touch). handle sebaiknya TextButton supaya input pasti tertangkap.
local function Drag(handle, onMove, onBegan, onEnded, immediate)
	handle.InputBegan:Connect(function(input)
		if not IsPress(input) then
			return
		end
		if onBegan then
			onBegan(input.Position)
		end
		if immediate then
			onMove(input.Position)
		end
		local moveConn, changedConn
		local function finish()
			if moveConn then
				moveConn:Disconnect()
				moveConn = nil
			end
			if changedConn then
				changedConn:Disconnect()
				changedConn = nil
				if onEnded then
					onEnded(input.Position)
				end
			end
		end
		moveConn = UserInputService.InputChanged:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseMovement or i == input then
				onMove(i.Position)
			end
		end)
		changedConn = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				finish()
			end
		end)
	end)
end

local function MountGui(gui)
	local mounted = false
	if type(gethui) == "function" then
		mounted = pcall(function()
			gui.Parent = gethui()
		end) and gui.Parent ~= nil
	end
	if not mounted and CoreGui then
		mounted = pcall(function()
			gui.Parent = CoreGui
		end) and gui.Parent ~= nil
	end
	if not mounted then
		gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
	end
end

local function NewGui(name, order)
	local gui = New("ScreenGui", {
		Name = name .. "_" .. HttpService:GenerateGUID(false):sub(1, 6),
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true,
		DisplayOrder = order or 100,
	})
	MountGui(gui)
	return gui
end

local function ViewportSize()
	local camera = workspace.CurrentCamera
	return camera and camera.ViewportSize or Vector2.new(1280, 720)
end

-- ============================================================
-- Theme API
-- ============================================================

function NekoUI:SetTheme(name)
	local theme = self.Themes[name]
	if not theme then
		return false
	end
	self.Theme = theme
	self.ThemeName = name
	local alive = {}
	for _, entry in ipairs(Bound) do
		local inst = entry[1]
		if inst.Parent ~= nil then
			alive[#alive + 1] = entry
			Tween(inst, { [entry[2]] = Resolve(entry[3]) }, 0.25)
		end
	end
	Bound = alive
	return true
end

function NekoUI:GetThemes()
	local names = {}
	for name in pairs(self.Themes) do
		names[#names + 1] = name
	end
	table.sort(names)
	return names
end

function NekoUI:AddTheme(name, theme)
	local merged = {}
	for key, value in pairs(self.Themes.Dark) do
		merged[key] = value
	end
	for key, value in pairs(theme) do
		merged[key] = value
	end
	self.Themes[name] = merged
end

