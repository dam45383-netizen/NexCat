-- ---------- Toggle (Type = "Toggle" | "Checkbox") ----------
function Container:Toggle(cfg)
	cfg = cfg or {}
	local checkbox = cfg.Type == "Checkbox" or cfg.Type == "CheckBox"
	local controlWidth = checkbox and 20 or 36
	local row, _, header, title, desc, lock = Card(self, cfg, controlWidth)

	local initial = cfg.Value
	if initial == nil then
		initial = cfg.Default
	end
	local state = initial == true

	local track, knob, box, boxStroke, mark
	if checkbox then
		box = New("Frame", {
			Name = "Checkbox",
			Size = UDim2.fromOffset(18, 18),
			LayoutOrder = 2,
			BackgroundTransparency = state and 0 or 1,
			Theme = {
				BackgroundColor3 = function(theme)
					return state and theme.Toggle or theme.Dialog
				end,
			},
			Parent = header,
		})
		Corner(box, 5)
		boxStroke = Stroke(box, "Outline", 1, state and 1 or 0.72)
		mark = Text(box, "✓", {
			Size = UDim2.fromScale(1, 1),
			Weight = "Bold",
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextTransparency = state and 0 or 1,
			Theme = { TextColor3 = "KnobOn" },
		})
	else
		track = New("Frame", {
			Name = "ToggleTrack",
			Size = UDim2.fromOffset(34, 18),
			LayoutOrder = 2,
			ClipsDescendants = true,
			Theme = {
				BackgroundColor3 = function(theme)
					return state and theme.Toggle or theme.Button
				end,
			},
			Parent = header,
		})
		Corner(track, 9)
		knob = New("Frame", {
			Name = "ToggleKnob",
			Size = UDim2.fromOffset(14, 14),
			AnchorPoint = Vector2.new(0, 0.5),
			Position = state and UDim2.new(1, -16, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
			Theme = { BackgroundColor3 = "White" },
			Parent = track,
		})
		Corner(knob, 7)
	end

	local click = ClickLayer(row)
	Hoverable(click, row)

	local obj = { Type = "Toggle", Value = state }
	local function render(instant)
		local theme = NexCat.Theme
		local duration = instant and 0 or 0.16
		if checkbox then
			Tween(box, {
				BackgroundColor3 = state and theme.Toggle or theme.Dialog,
				BackgroundTransparency = state and 0 or 1,
			}, duration)
			Tween(boxStroke, { Transparency = state and 1 or 0.72 }, duration)
			Tween(mark, { TextTransparency = state and 0 or 1 }, duration)
		else
			Tween(track, { BackgroundColor3 = state and theme.Toggle or theme.Button }, duration)
			Tween(knob, {
				Position = state and UDim2.new(1, -16, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
			}, duration, Enum.EasingStyle.Quad)
		end
	end

	function obj:Set(value, silent)
		local nextState = value == true
		local changed = state ~= nextState
		state = nextState
		obj.Value = state
		render(false)
		if changed and not silent then
			Fire(cfg.Callback, state)
		end
		return state
	end

	function obj:Get()
		return state
	end

	click.Activated:Connect(function()
		if lock and lock.Visible then
			return
		end
		obj:Set(not state)
	end)

	render(true)
	return Finish(self, cfg, obj, row, title, desc, lock)
end

-- Alias kecil supaya pemanggil bisa memilih nama yang lebih eksplisit.
function Container:Switch(cfg)
	return self:Toggle(cfg)
