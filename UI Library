        for _, p in pairs(pages) do
            if not p.hidden then
                p.item.BackgroundColor3 = T.navOn
                p.label.TextColor3 = p.on and WHITE or T.nav
                p.icon.tint(p.on and T.iconOn or T.navIc, 0)
