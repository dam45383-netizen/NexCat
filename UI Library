	Corner(button, 10)
	local outline = Stroke(button, "Outline", 1, 1)

	local holder = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = button,
	})
	Pad(holder, 0, 10, 0, 12)
	List(holder, 10, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local icon = MakeIcon(holder, cfg.Icon, 18, "Text", cfg.IconThemed)
	if icon then
		icon.LayoutOrder = 1
	end
	local label = Text(holder, tab.Title, {
		Size = UDim2.new(1, icon and -28 or 0, 1, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
		LayoutOrder = 2,
		TextTransparency = 0.45,
	})
	IconAlpha(icon, 0.45)

	local page = New("ScrollingFrame", {
		Name = tab.Title,
		Position = UDim2.fromOffset(0, 6),
		Size = UDim2.new(1, 0, 1, -12),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageTransparency = 0.5,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Visible = false,
		Theme = { ScrollBarImageColor3 = "Icon" },
		Parent = window._content,
	})
	Pad(page, 4, 12, 4, 12)
	List(page, 6)

	tab.Button = button
	tab.Page = page
	tab._content = page
	tab._scroll = page

	local selected = false
	local locked = cfg.Locked == true

	local function dim()
		return locked and 0.7 or (selected and 0 or 0.45)
	end

	function tab:_SetActive(active)
		selected = active
		page.Visible = active
		if active then
			page.Position = UDim2.fromOffset(0, 18)
			Tween(page, { Position = UDim2.fromOffset(0, 6) }, 0.25)
		end
		Tween(button, { BackgroundTransparency = active and 0 or 1 }, 0.18)
		Tween(outline, { Transparency = active and 0.88 or 1 }, 0.18)
		Tween(label, { TextTransparency = dim() }, 0.18)
		IconAlpha(icon, dim(), 0.18)
	end

	function tab:Select()
		window:SelectTab(tab)
	end
	function tab:SetTitle(value)
		tab.Title = tostring(value)
		label.Text = tab.Title
	end
	function tab:SetDesc(value)
		tab.Desc = value
	end
	function tab:Lock()
		locked = true
		Tween(label, { TextTransparency = dim() }, 0.15)
		IconAlpha(icon, dim(), 0.15)
	end
	function tab:Unlock()
		locked = false
		Tween(label, { TextTransparency = dim() }, 0.15)
		IconAlpha(icon, dim(), 0.15)
	end
	function tab:ScrollToTheElement(index)
		for _, child in ipairs(page:GetChildren()) do
			if child:IsA("GuiObject") and child.LayoutOrder == index then
				local y = child.AbsolutePosition.Y - page.AbsolutePosition.Y + page.CanvasPosition.Y - 4
				Tween(page, { CanvasPosition = Vector2.new(0, math.max(y, 0)) }, 0.3)
				return true
			end
		end
		return false
	end
	function tab:Destroy()
		for i, t in ipairs(window.Tabs) do
			if t == tab then
				table.remove(window.Tabs, i)
				break
			end
		end
		if window._selected == tab then
			window._selected = nil
			if window.Tabs[1] then
				window:SelectTab(window.Tabs[1])
			end
		end
		button:Destroy()
		page:Destroy()
	end

	button.MouseEnter:Connect(function()
		if not selected and not locked then
			Tween(button, { BackgroundTransparency = 0.55 }, 0.12)
		end
	end)
	button.MouseLeave:Connect(function()
		if not selected then
			Tween(button, { BackgroundTransparency = 1 }, 0.12)
		end
	end)
	button.MouseButton1Click:Connect(function()
		if locked then
			return
		end
		window:SelectTab(tab)
	end)

	if locked then
		Tween(label, { TextTransparency = 0.7 }, 0)
		IconAlpha(icon, 0.7)
	end

	window.Tabs[#window.Tabs + 1] = tab
	if #window.Tabs == 1 and not locked then
		window:SelectTab(tab)
	end
	return tab
end

