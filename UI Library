function NekoUI:_NotifyHolder()
	if self._notifGui and self._notifGui.Parent then
		return self._notifHolder
	end
	local gui = NewGui("NekoUI_Notify", 1000)
	local width = math.min(310, ViewportSize().X - 32)
	local holder = New("Frame", {
		Name = "Holder",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.new(0, width, 1, -32),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	List(holder, 8, Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom)
	self._notifGui = gui
	self._notifHolder = holder
	return holder
end

local NotifyTypes = {
	Info = { color = "Accent", icon = "info" },
	Success = { color = "Success", icon = "check" },
	Warning = { color = "Warning", icon = "warning" },
	Error = { color = "Danger", icon = "error" },
}

function NekoUI:Notify(cfg)
	cfg = cfg or {}
	local holder = self:_NotifyHolder()
	local kind = NotifyTypes[cfg.Type or "Info"] or NotifyTypes.Info
	local duration = cfg.Duration or 4

	local card = New("CanvasGroup", {
		Name = "Notification",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		GroupTransparency = 1,
		LayoutOrder = NextOrder(holder),
		Theme = { BackgroundColor3 = "Surface" },
		Parent = holder,
	})
	Corner(card, 10)
	Stroke(card, "Stroke", 1, 0.2)
	local scale = New("UIScale", { Scale = 0.92, Parent = card })

	New("Frame", {
		Name = "Accent",
		Size = UDim2.new(0, 3, 1, 0),
		BorderSizePixel = 0,
		Theme = { BackgroundColor3 = kind.color },
		Parent = card,
	})

	local inner = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = card,
	})
	Pad(inner, 12, 14, 14, 18)
	List(inner, 5)

	local head = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 20),
		LayoutOrder = 1,
		Parent = inner,
	})
	List(head, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local icon = MakeIcon(head, cfg.Icon or kind.icon, 18)
	if icon then
		icon.LayoutOrder = 1
	end
	Text(head, cfg.Title or "Notification", {
		Size = UDim2.new(1, icon and -26 or 0, 1, 0),
		Font = Enum.Font.GothamBold,
		TextTruncate = Enum.TextTruncate.AtEnd,
		LayoutOrder = 2,
	})

	if cfg.Content and cfg.Content ~= "" then
		Text(inner, cfg.Content, {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			Font = Enum.Font.Gotham,
			TextSize = 13,
			RichText = true,
			LayoutOrder = 2,
			Theme = { TextColor3 = "SubText" },
		})
	end

	local bar
	if duration > 0 then
		bar = New("Frame", {
			Name = "Progress",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.new(1, 0, 0, 2),
			BorderSizePixel = 0,
			BackgroundTransparency = 0.4,
			Theme = { BackgroundColor3 = kind.color },
			Parent = card,
		})
	end

	local closed = false
	local object = {}
	function object:Close()
		if closed then
			return
		end
		closed = true
		Tween(card, { GroupTransparency = 1 }, 0.2)
		Tween(scale, { Scale = 0.92 }, 0.2)
		task.delay(0.22, function()
			card:Destroy()
		end)
	end

	local hit = New("TextButton", {
		Name = "Dismiss",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 5,
		Parent = card,
	})
	hit.MouseButton1Click:Connect(function()
		object:Close()
	end)

	Tween(card, { GroupTransparency = 0 }, 0.25)
	Tween(scale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)
	if bar then
		Tween(bar, { Size = UDim2.new(0, 0, 0, 2) }, duration, Enum.EasingStyle.Linear)
		task.delay(duration, function()
			object:Close()
		end)
	end
	return object
end

