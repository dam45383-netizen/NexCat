-- cfg: Title, Content, Icon, Duration, CanClose, Type ("Info" | "Success" | "Warning" | "Error")
function NexCat:Notify(cfg)
	cfg = cfg or {}
	local holder = self:_NotifyHolder()
	local kind = cfg.Type and (NotifyTypes[cfg.Type] or NotifyTypes.Info) or nil
	local duration = cfg.Duration or 5
	local canClose = cfg.CanClose ~= false

	local card = New("CanvasGroup", {
		Name = "Notification",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		GroupTransparency = 1,
		LayoutOrder = NextOrder(holder),
		Theme = { BackgroundColor3 = "Dialog" },
		Parent = holder,
	})
	Corner(card, 14)
	Stroke(card, "Outline", 1, 0.88)
	local scale = New("UIScale", { Scale = 0.92, Parent = card })

	local inner = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = card,
	})
	Pad(inner, 14, 14, 16, 14)
	List(inner, 6)

	local head = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 22),
		LayoutOrder = 1,
		Parent = inner,
	})
	List(head, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local icon = MakeIcon(head, cfg.Icon or (kind and kind.icon), 20, kind and kind.color or "Icon")
	if icon then
		icon.LayoutOrder = 1
	end
	Text(head, cfg.Title or "Notification", {
		Size = UDim2.new(1, -((icon and 28 or 0) + (canClose and 26 or 0)), 1, 0),
		TextSize = 16,
		TextTruncate = Enum.TextTruncate.AtEnd,
		LayoutOrder = 2,
	})

	if cfg.Content and cfg.Content ~= "" then
		Text(inner, cfg.Content, {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			Weight = "Regular",
			TextSize = 14,
			RichText = true,
			TextTransparency = 0.4,
			LayoutOrder = 2,
		})
	end

	local bar
	if duration > 0 then
		bar = New("Frame", {
			Name = "Progress",
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.new(1, 0, 0, 3),
			BorderSizePixel = 0,
			BackgroundTransparency = 0.55,
			Theme = { BackgroundColor3 = kind and kind.color or "Text" },
			Parent = card,
		})
	end

	local closed = false
	local object = {}
	function object:Close()
		if closed then
			return
		end
		closed = true
		Tween(card, { GroupTransparency = 1 }, 0.2)
		Tween(scale, { Scale = 0.92 }, 0.2)
		task.delay(0.22, function()
			card:Destroy()
		end)
	end

	if canClose then
		local closeButton = New("TextButton", {
			Name = "Close",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -10, 0, 14),
			Size = UDim2.fromOffset(22, 22),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 5,
			Parent = card,
		})
		CloseGlyph(closeButton, 10, "Icon")
		closeButton.MouseButton1Click:Connect(function()
			object:Close()
		end)
	end

	Tween(card, { GroupTransparency = 0 }, 0.25)
	Tween(scale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)
	if bar then
		Tween(bar, { Size = UDim2.new(0, 0, 0, 3) }, duration, Enum.EasingStyle.Linear)
		task.delay(duration, function()
			object:Close()
		end)
	end
	return object
end

-- ============================================================
-- Config (simpan / muat nilai element)
-- ============================================================

local function Encode(value)
	local t = typeof(value)
	if t == "Color3" then
		return { __t = "C3", r = value.R, g = value.G, b = value.B }
	elseif t == "EnumItem" then
		return { __t = "E", n = value.Name }
	elseif type(value) == "table" then
		local out = {}
		for i, v in ipairs(value) do
			out[i] = v
		end
		return out
	end
	return value
end

local function Decode(value)
	if type(value) == "table" then
		if value.__t == "C3" then
			return Color3.new(value.r, value.g, value.b)
		elseif value.__t == "E" then
			return value.n
		end
	end
	return value
end

local function SameValue(a, b)
	if a == b then
		return true
	end
	if type(a) == "table" and type(b) == "table" then
		for key, value in pairs(a) do
			if not SameValue(value, b[key]) then
				return false
			end
		end
		for key in pairs(b) do
			if a[key] == nil then
				return false
			end
		end
		return true
	end
	return false
end

-- terapkan satu nilai ke element. return true kalau element-nya ada.
-- kalau nilainya sudah sama, Set dilewati supaya Callback tidak jalan dua kali.
local function ApplyValue(element, raw)
	if not element or type(element.Set) ~= "function" then
		return false
	end
	if type(element.Get) == "function" then
		local ok, current = pcall(element.Get, element)
		if ok and SameValue(Encode(current), raw) then
			return true
		end
	end
	pcall(element.Set, element, Decode(raw))
	return true
end

-- ---------- Nama game -> nama file ----------
-- File config: <Folder>/<Nama Game> Config.lua   (Folder default "NexCat")
local ConfigFileSuffix = " Config.lua"
local GameNameCache

-- buang tag event [UPDATE], emoji / karakter non-ASCII, dan karakter terlarang di nama file,
-- supaya nama file tetap sama walau judul game berganti tag event.
local function CleanFileName(name)
	name = tostring(name or "")
	name = name:gsub("%b[]", " ")
	name = name:gsub("[\128-\255]", "")
	name = name:gsub('[\\/:*?"<>|%c]', "")
	name = name:gsub("%s+", " ")
	name = name:match("^[%s%.%-_]*(.-)[%s%.]*$") or ""
	return name:sub(1, 60)
end

local function GetGameName()
	if GameNameCache then
		return GameNameCache
	end
	local name
	local ok = pcall(function()
		name = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name
	end)
	if not ok or type(name) ~= "string" or CleanFileName(name) == "" then
		pcall(function()
			name = game.Name
		end)
	end
	name = CleanFileName(name)
	if name == "" then
		name = "Place " .. tostring(game.PlaceId)
	end
	GameNameCache = name
	return name
end

-- Nama game config sengaja tidak bisa dioverride; selalu diambil dari metadata Roblox.

