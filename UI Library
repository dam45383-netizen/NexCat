local function spaced(s, hi, hex)
    local out, used = {}, false
    for i = 1, #s do
        local c = s:sub(i, i)
        if hex and not used and c == hi then
            used = true
            out[#out + 1] = '<font color="#' .. hex .. '">' .. c .. '</font>'
