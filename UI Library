                -- pilihan aktif: kotak gelap + garis putih di kiri (sama seperti tab aktif di sidebar) + centang di kanan
                bar = new("Frame", {AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), Size = UDim2.fromOffset(3, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0}, b)
                corner(bar, "full")
                tick = mkIcon(b, "check", 13, T.accent, {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Visible = false})
            end
            local sc = sp.swatch and sp.swatch(name)
            if sc then
                local dot = new("Frame", {AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, tx, 0.5, 0), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = sc, BorderSizePixel = 0}, b)
                corner(dot, "full")
                tx = tx + 20
            end
            local lb = text(b, {Text = name, Position = UDim2.fromOffset(tx, 0), Size = UDim2.new(1, -(tx + (tick and 30 or 8)), 1, 0), W = 2, TextSize = 11, TextColor3 = T.dim})
            local r = {btn = b, name = name}
            function r.paint()
                local on = sp.isSel(name)
                play(b, {BackgroundColor3 = T.navOn, BackgroundTransparency = on and 0 or 1}, 0.12)
                lb.TextColor3 = on and T.text or T.dim
                lb.FontFace = on and FONT[3] or FONT[2]
                if sp.multi then
                    play(cbox, {BackgroundColor3 = on and T.accent or T.off}, 0.12)
                    cst.Color = on and T.accent or T.swLn
                    mark.Visible = on and true or false
                    markIc.tint(onAcc(), 0)
                else
                    tick.tint(T.accent, 0)
                    tick.inst.Visible = on and true or false
                    play(bar, {Size = UDim2.fromOffset(3, on and 14 or 0)}, 0.15)
                end
            end
            b.MouseEnter:Connect(function()
                if not sp.isSel(name) then
                    lb.TextColor3 = T.text
                    play(b, {BackgroundColor3 = T.hover, BackgroundTransparency = 0.45}, 0.12)
                end
            end)
            b.MouseLeave:Connect(r.paint)
            b.MouseButton1Click:Connect(function()
                sp.pick(name)
                repaint()
                if not sp.multi then D.close() end
            end)
            rows[i] = r
        end
        repaint()
        ov.Visible = true
        play(ov, {BackgroundTransparency = 0.5}, 0.25)
        dr.Position = UDim2.new(1, DW + 20, 0.5, 0)
        play(dr, {Position = UDim2.new(1, -14, 0.5, 0)}, 0.28)
    end
    box:GetPropertyChangedSignal("Text"):Connect(function()
        local q = box.Text:lower()
        local shown = 0
        for _, r in ipairs(rows) do
            local v = (q == "") or (r.name:lower():find(q, 1, true) ~= nil)
            r.btn.Visible = v
            if v then shown = shown + 1 end
        end
        empty.Visible = (shown == 0) and (#rows > 0) -- "No results" saat pencarian kosong
    end)
    ov.MouseButton1Click:Connect(D.close)
    return D
end

local function newCtx(hostF, rad)
    local c = {}
    function c.drawer()
        if not c.d then c.d = makeDrawer(hostF, rad) end
        return c.d
    end
    return c
end

