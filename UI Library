                end
                hit.MouseEnter:Connect(function() hov = true rest() end)
                hit.MouseLeave:Connect(function() hov = false rest() end)
                hit.MouseButton1Click:Connect(function()
                    ripple(c, 220)
                    joinSmall()
                end)
