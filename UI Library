-- kartu dasar: return row, inner, header, title, desc, lock
-- widget kanan taruh di `header` dengan LayoutOrder = 2
local function Card(container, cfg, rightWidth)
	local window = container._window
	local row = New("Frame", {
		Name = tostring(cfg.Title or "Element"),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = NextOrder(container._content),
		Theme = { BackgroundColor3 = "Element" },
		Parent = container._content,
	})
	Corner(row, 8)
	Stroke(row, "Stroke", 1, 0.45)
	window:_Surface(row, 0.3)

	local inner = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = row,
	})
	Pad(inner, 10, 12, 10, 12)
	List(inner, 8)

	local header = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		Parent = inner,
	})
	New("UISizeConstraint", { MinSize = Vector2.new(0, 24), Parent = header })
	List(header, 10, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)

	local left = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, rightWidth and -(rightWidth + 10) or 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		Parent = header,
	})
	List(left, 2)

	local title = Text(left, cfg.Title or "", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		RichText = true,
		LayoutOrder = 1,
	})
	local hasDesc = cfg.Desc ~= nil and cfg.Desc ~= ""
	local desc = Text(left, cfg.Desc or "", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		RichText = true,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		Visible = hasDesc,
		LayoutOrder = 2,
		Theme = { TextColor3 = "SubText" },
	})

	local lock = New("TextButton", {
		Name = "Lock",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 0.4,
		Text = "",
		AutoButtonColor = false,
		Visible = cfg.Locked == true,
		ZIndex = 10,
		Theme = { BackgroundColor3 = "Background" },
		Parent = row,
	})
	Corner(lock, 8)

	return row, inner, header, title, desc, lock
end

-- method umum untuk semua element
local function Finish(container, cfg, obj, row, title, desc, lock)
	obj.Element = row
	function obj:SetTitle(value)
		title.Text = tostring(value)
	end
	function obj:SetDesc(value)
		value = value or ""
		desc.Text = tostring(value)
		desc.Visible = value ~= ""
	end
	function obj:Lock()
		if lock then
			lock.Visible = true
		end
	end
	function obj:Unlock()
		if lock then
			lock.Visible = false
		end
	end
	function obj:SetVisible(visible)
		row.Visible = visible and true or false
	end
	function obj:Destroy()
		if obj.Flag then
			container._window.Flags[obj.Flag] = nil
		end
		row:Destroy()
	end
	if cfg.Flag then
		obj.Flag = cfg.Flag
		container._window.Flags[cfg.Flag] = obj
	end
	return obj
end

local function Hoverable(button, target)
	button.MouseEnter:Connect(function()
		Tween(target, { BackgroundColor3 = NekoUI.Theme.ElementHover }, 0.15)
	end)
	button.MouseLeave:Connect(function()
		Tween(target, { BackgroundColor3 = NekoUI.Theme.Element }, 0.15)
	end)
end

local function ClickLayer(row)
	return New("TextButton", {
		Name = "Click",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 2,
		Parent = row,
	})
end

-- ---------- Button ----------
function Container:Button(cfg)
	cfg = cfg or {}
	local row, _, header, title, desc, lock = Card(self, cfg, 24)
	local icon = MakeIcon(header, cfg.Icon, 18, "SubText")
	if icon then
		icon.LayoutOrder = 2
	else
		Text(header, "›", {
			Size = UDim2.fromOffset(24, 24),
			Font = Enum.Font.GothamBold,
			TextSize = 22,
			TextXAlignment = Enum.TextXAlignment.Center,
			LayoutOrder = 2,
			Theme = { TextColor3 = "SubText" },
		})
	end
	local click = ClickLayer(row)
	Hoverable(click, row)

	local obj = { Type = "Button" }
	function obj:Fire()
		Fire(cfg.Callback)
	end
	click.MouseButton1Click:Connect(function()
		obj:Fire()
	end)
	return Finish(self, cfg, obj, row, title, desc, lock)
end

-- ---------- Toggle ----------
function Container:Toggle(cfg)
	cfg = cfg or {}
	local row, _, header, title, desc, lock = Card(self, cfg, 40)
	local state = (cfg.Value or cfg.Default) == true

	local track = New("Frame", {
		Name = "Track",
		Size = UDim2.fromOffset(40, 22),
		LayoutOrder = 2,
		Theme = {
			BackgroundColor3 = function(theme)
				return state and theme.Accent or theme.ToggleOff
			end,
		},
		Parent = header,
	})
	Corner(track, 11)
	local knob = New("Frame", {
		Name = "Knob",
		Size = UDim2.fromOffset(16, 16),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = state and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		Theme = {
			BackgroundColor3 = function(theme)
				return state and theme.AccentText or theme.Text
			end,
		},
		Parent = track,
	})
	Corner(knob, 8)

	local click = ClickLayer(row)
	Hoverable(click, row)

	local obj = { Type = "Toggle", Value = state }
	local function render()
		Tween(track, { BackgroundColor3 = state and NekoUI.Theme.Accent or NekoUI.Theme.ToggleOff }, 0.15)
		Tween(knob, {
			Position = state and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
			BackgroundColor3 = state and NekoUI.Theme.AccentText or NekoUI.Theme.Text,
		}, 0.15)
	end
	function obj:Set(value, silent)
		state = value and true or false
		obj.Value = state
		render()
		if not silent then
			Fire(cfg.Callback, state)
		end
	end
	function obj:Get()
		return state
	end
	click.MouseButton1Click:Connect(function()
		obj:Set(not state)
	end)
	return Finish(self, cfg, obj, row, title, desc, lock)
end

-- ---------- Slider ----------
function Container:Slider(cfg)
	cfg = cfg or {}
	local v = cfg.Value
	local min, max, default
	if type(v) == "table" then
		min, max, default = v.Min, v.Max, v.Default
	else
		min, max, default = cfg.Min, cfg.Max, v or cfg.Default
	end
	min = min or 0
	max = max or 100
	if max < min then
		min, max = max, min
	end
	default = default or min
	local step = cfg.Step or 1
	if step <= 0 then
		step = 1
	end
	local suffix = cfg.Suffix or ""

	local decimals = 0
	local stepText = tostring(step)
	local dot = stepText:find("%.")
	local exponent = stepText:match("e%-(%d+)")
	if exponent then
		decimals = tonumber(exponent)
	elseif dot then
		decimals = #stepText - dot
	end

	local function snap(x)
		x = math.clamp(x, min, max)
		x = math.floor((x - min) / step + 0.5) * step + min
		x = math.clamp(x, min, max)
		return tonumber(string.format("%." .. decimals .. "f", x))
	end
	local function format(x)
		return string.format("%." .. decimals .. "f", x) .. suffix
	end

	local row, inner, header, title, desc, lock = Card(self, cfg, 64)
	local box = New("TextBox", {
		Name = "Value",
		Size = UDim2.fromOffset(64, 24),
		LayoutOrder = 2,
		Text = "",
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		ClearTextOnFocus = false,
		Theme = { BackgroundColor3 = "Surface", TextColor3 = "Text" },
		Parent = header,
	})
	Corner(box, 6)
	Stroke(box, "Stroke", 1, 0.3)

	local barHolder = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 16),
		LayoutOrder = 2,
		Parent = inner,
	})
	local track = New("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(1, 0, 0, 6),
		Theme = { BackgroundColor3 = "ToggleOff" },
		Parent = barHolder,
	})
	Corner(track, 3)
	local fill = New("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		Theme = { BackgroundColor3 = "Accent" },
		Parent = track,
	})
	Corner(fill, 3)
	local knob = New("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(14, 14),
		Theme = { BackgroundColor3 = "Text" },
		Parent = track,
	})
	Corner(knob, 7)
	Stroke(knob, "Surface", 2, 0)

	local obj = { Type = "Slider", Min = min, Max = max }
	local value = snap(default)
	obj.Value = value

	local function render(duration)
		local alpha = (max == min) and 0 or (value - min) / (max - min)
		Tween(fill, { Size = UDim2.fromScale(alpha, 1) }, duration or 0.1)
		Tween(knob, { Position = UDim2.fromScale(alpha, 0.5) }, duration or 0.1)
		box.Text = format(value)
	end
	render(0)

	function obj:Set(x, silent)
		value = snap(tonumber(x) or value)
		obj.Value = value
		render()
		if not silent then
			Fire(cfg.Callback, value)
		end
	end
	function obj:Get()
		return value
	end

	box.FocusLost:Connect(function()
		local n = tonumber(box.Text:match("-?%d+%.?%d*"))
		if n then
			obj:Set(n)
		else
			render()
		end
	end)

	local scroll = self._scroll
	local hit = New("TextButton", {
		Name = "Hit",
		Size = UDim2.new(1, 16, 1, 0),
		Position = UDim2.fromOffset(-8, 0),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 3,
		Parent = barHolder,
	})
	Drag(hit, function(pos)
		local alpha = math.clamp((pos.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local new = snap(min + (max - min) * alpha)
		if new ~= value then
			value = new
			obj.Value = value
			render(0.06)
			Fire(cfg.Callback, value)
		end
	end, function()
		if scroll then
			scroll.ScrollingEnabled = false
		end
	end, function()
		if scroll then
			scroll.ScrollingEnabled = true
		end
	end, true)

	return Finish(self, cfg, obj, row, title, desc, lock)
end

-- ---------- Input ----------
function Container:Input(cfg)
	cfg = cfg or {}
	local row, inner, _, title, desc, lock = Card(self, cfg)
	local multiline = cfg.Type == "Textarea" or cfg.Multiline == true

	local box = New("TextBox", {
		Name = "Field",
		Size = UDim2.new(1, 0, 0, multiline and 84 or 32),
		LayoutOrder = 2,
		Text = cfg.Value or cfg.Default or "",
		PlaceholderText = cfg.Placeholder or cfg.PlaceholderText or "Ketik di sini...",
		ClearTextOnFocus = cfg.ClearTextOnFocus == true,
		MultiLine = multiline,
		TextWrapped = multiline,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = multiline and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
		Font = Enum.Font.Gotham,
		TextSize = 13,
		Theme = { BackgroundColor3 = "Surface", TextColor3 = "Text", PlaceholderColor3 = "SubText" },
		Parent = inner,
	})
	Corner(box, 6)
	local stroke = Stroke(box, "Stroke", 1, 0.2)
	Pad(box, multiline and 8 or 0, 10, multiline and 8 or 0, 10)

	local obj = { Type = "Input", Value = box.Text }
	box.Focused:Connect(function()
		Tween(stroke, { Color = NekoUI.Theme.Accent }, 0.15)
	end)
	box.FocusLost:Connect(function()
		Tween(stroke, { Color = NekoUI.Theme.Stroke }, 0.15)
		obj.Value = box.Text
		if not cfg.Live then
			Fire(cfg.Callback, box.Text)
		end
	end)
	box:GetPropertyChangedSignal("Text"):Connect(function()
		if cfg.Numeric then
			local cleaned = box.Text:gsub("[^%d%.%-]", "")
			if cleaned ~= box.Text then
				box.Text = cleaned
				return
			end
		end
		obj.Value = box.Text
		if cfg.Live then
			Fire(cfg.Callback, box.Text)
		end
	end)
	function obj:Set(value, silent)
		box.Text = tostring(value or "")
		obj.Value = box.Text
		if not silent and not cfg.Live then
			Fire(cfg.Callback, box.Text)
		end
	end
	function obj:Get()
		return box.Text
	end
	return Finish(self, cfg, obj, row, title, desc, lock)
end

-- ---------- Dropdown ----------
function Container:Dropdown(cfg)
	cfg = cfg or {}
	local window = self._window
	local multi = cfg.Multi == true
	local values = cfg.Values or {}
	local sel = {}
	local init = cfg.Value
	if init == nil then
		init = cfg.Default
	end
	if multi then
		if type(init) == "table" then
			for _, item in ipairs(init) do
				sel[item] = true
			end
		end
	elseif init ~= nil then
		sel[init] = true
	end

	local row, _, header, title, desc, lock = Card(self, cfg, 150)
	local button = New("TextButton", {
		Name = "Select",
		Size = UDim2.fromOffset(150, 28),
		LayoutOrder = 2,
		Text = "",
		AutoButtonColor = false,
		Theme = { BackgroundColor3 = "Surface" },
		Parent = header,
	})
	Corner(button, 6)
	Stroke(button, "Stroke", 1, 0.2)
	local label = Text(button, "", {
		Size = UDim2.new(1, -30, 1, 0),
		Position = UDim2.fromOffset(10, 0),
		TextSize = 13,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	Text(button, "▾", {
		Size = UDim2.fromOffset(18, 28),
		Position = UDim2.new(1, -22, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		Theme = { TextColor3 = "SubText" },
	})

	local obj = { Type = "Dropdown", Values = values }

	local function getValue()
		if multi then
			local out = {}
			for _, item in ipairs(values) do
				if sel[item] then
					out[#out + 1] = item
				end
			end
			return out
		end
		for _, item in ipairs(values) do
			if sel[item] then
				return item
			end
		end
		return nil
	end

	local function updateLabel()
		local current = getValue()
		local textValue
		if multi then
			local names = {}
			for _, item in ipairs(current) do
				names[#names + 1] = tostring(item)
			end
			textValue = #names > 0 and table.concat(names, ", ") or "Pilih..."
		else
			textValue = current ~= nil and tostring(current) or "Pilih..."
		end
		label.Text = textValue
		obj.Value = current
	end
	updateLabel()

	local function open()
		local count = #values
		if count == 0 then
			return
		end
		local showSearch = cfg.Search == true or (cfg.Search == nil and count > 8)
		local top = showSearch and 40 or 0
		local listHeight = math.min(count * 32 + 8, 200)
		local width = math.max(button.AbsoluteSize.X, 170)
		local popup = window:_OpenPopup(button, width, listHeight + top, true)

		local options = {}
		local function paint(option, hover)
			local selected = sel[option.value] == true
			option.check.Visible = selected
			if selected then
				option.button.BackgroundColor3 = NekoUI.Theme.Accent
				option.button.BackgroundTransparency = hover and 0.75 or 0.86
			else
				option.button.BackgroundColor3 = NekoUI.Theme.ElementHover
				option.button.BackgroundTransparency = hover and 0 or 1
			end
		end

		if showSearch then
			local search = New("TextBox", {
				Size = UDim2.new(1, -16, 0, 28),
				Position = UDim2.fromOffset(8, 6),
				Text = "",
				PlaceholderText = "Cari...",
				ClearTextOnFocus = false,
				Font = Enum.Font.Gotham,
				TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 52,
				Theme = { BackgroundColor3 = "Element", TextColor3 = "Text", PlaceholderColor3 = "SubText" },
				Parent = popup,
			})
			Corner(search, 6)
			Pad(search, 0, 8, 0, 8)
			search:GetPropertyChangedSignal("Text"):Connect(function()
				local q = search.Text:lower()
				for _, option in ipairs(options) do
					option.button.Visible = q == "" or tostring(option.value):lower():find(q, 1, true) ~= nil
				end
			end)
		end

		local scroller = New("ScrollingFrame", {
			Position = UDim2.fromOffset(0, top),
			Size = UDim2.new(1, 0, 1, -top),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ZIndex = 52,
			Theme = { ScrollBarImageColor3 = "SubText" },
			Parent = popup,
		})
		Pad(scroller, 4, 4, 4, 4)
		List(scroller, 2)

		for i, item in ipairs(values) do
			local optionButton = New("TextButton", {
				Size = UDim2.new(1, 0, 0, 30),
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				LayoutOrder = i,
				ZIndex = 53,
				Parent = scroller,
			})
			Corner(optionButton, 6)
			Text(optionButton, tostring(item), {
				Size = UDim2.new(1, -32, 1, 0),
				Position = UDim2.fromOffset(10, 0),
				TextSize = 13,
				TextTruncate = Enum.TextTruncate.AtEnd,
				ZIndex = 54,
			})
			local check = Text(optionButton, "✓", {
				Size = UDim2.fromOffset(20, 30),
				Position = UDim2.new(1, -24, 0, 0),
				TextXAlignment = Enum.TextXAlignment.Center,
				Font = Enum.Font.GothamBold,
				ZIndex = 54,
				Visible = false,
				Theme = { TextColor3 = "Accent" },
			})
			local option = { value = item, button = optionButton, check = check }
			options[#options + 1] = option
			paint(option, false)

			optionButton.MouseEnter:Connect(function()
				paint(option, true)
			end)
			optionButton.MouseLeave:Connect(function()
				paint(option, false)
			end)
			optionButton.MouseButton1Click:Connect(function()
				if multi then
					sel[item] = not sel[item] or nil
				elseif sel[item] and cfg.AllowNone then
					sel = {}
				else
					sel = { [item] = true }
				end
				updateLabel()
				Fire(cfg.Callback, obj.Value)
				if multi then
					for _, o in ipairs(options) do
						paint(o, o == option)
					end
				else
					window:_ClosePopup()
				end
			end)
		end
	end

	button.MouseButton1Click:Connect(open)

	function obj:Set(value, silent)
		sel = {}
		if multi then
			if type(value) == "table" then
				for _, item in ipairs(value) do
					sel[item] = true
				end
			end
		elseif value ~= nil then
			sel[value] = true
		end
		updateLabel()
		if not silent then
			Fire(cfg.Callback, obj.Value)
		end
	end
	function obj:Select(value, silent)
		obj:Set(value, silent)
	end
	function obj:Get()
		return obj.Value
	end
	function obj:Refresh(newValues, keepSelection)
		values = newValues or {}
		obj.Values = values
		if not keepSelection then
			local valid = {}
			for _, item in ipairs(values) do
				if sel[item] then
					valid[item] = true
				end
			end
			sel = valid
		end
		updateLabel()
	end
	return Finish(self, cfg, obj, row, title, desc, lock)
end

-- ---------- Keybind ----------
local function ToKeyCode(value)
	if typeof(value) == "EnumItem" then
		return value
	end
	if type(value) == "string" then
		local ok, key = pcall(function()
			return Enum.KeyCode[value]
		end)
		if ok then
			return key
		end
	end
	return nil
end

function Container:Keybind(cfg)
	cfg = cfg or {}
	local row, _, header, title, desc, lock = Card(self, cfg, 90)
	local key = ToKeyCode(cfg.Value or cfg.Default)
	local listening = false

	local button = New("TextButton", {
		Name = "Key",
		Size = UDim2.fromOffset(90, 28),
		LayoutOrder = 2,
		Text = "",
		AutoButtonColor = false,
		Theme = { BackgroundColor3 = "Surface" },
		Parent = header,
	})
	Corner(button, 6)
	local stroke = Stroke(button, "Stroke", 1, 0.2)
	local label = Text(button, key and key.Name or "None", {
		Size = UDim2.fromScale(1, 1),
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})

	local obj = { Type = "Keybind", Value = key }
	local function render()
		label.Text = listening and "..." or (key and key.Name or "None")
		Tween(stroke, { Color = listening and NekoUI.Theme.Accent or NekoUI.Theme.Stroke }, 0.15)
	end

	button.MouseButton1Click:Connect(function()
		listening = true
		render()
	end)

	self._window:_Connect(UserInputService.InputBegan, function(input, processed)
		if listening then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				listening = false
				if input.KeyCode == Enum.KeyCode.Backspace then
					key = nil
				elseif input.KeyCode ~= Enum.KeyCode.Escape then
					key = input.KeyCode
				end
				obj.Value = key
				render()
				Fire(cfg.Changed, key)
			end
			return
		end
		if not processed and key and input.KeyCode == key then
			Fire(cfg.Callback, key)
		end
	end)

	function obj:Set(value, silent)
		key = ToKeyCode(value)
		obj.Value = key
		render()
		if not silent then
			Fire(cfg.Changed, key)
		end
	end
	function obj:Get()
		return key
	end
	return Finish(self, cfg, obj, row, title, desc, lock)
end

-- ---------- Colorpicker ----------
local function ColorToHex(color)
	return string.format(
		"#%02X%02X%02X",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5)
	)
end

local function HexToColor(text)
	local hex = tostring(text):gsub("#", ""):match("^(%x%x%x%x%x%x)$")
	if not hex then
		return nil
	end
	return Color3.fromRGB(
		tonumber(hex:sub(1, 2), 16),
		tonumber(hex:sub(3, 4), 16),
		tonumber(hex:sub(5, 6), 16)
	)
end

function Container:Colorpicker(cfg)
	cfg = cfg or {}
	local window = self._window
	local row, _, header, title, desc, lock = Card(self, cfg, 44)
	local color = cfg.Value or cfg.Default or Color3.fromRGB(255, 255, 255)
	local h, s, v = color:ToHSV()

	local swatch = New("TextButton", {
		Name = "Swatch",
		Size = UDim2.fromOffset(44, 24),
		LayoutOrder = 2,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = color,
		Parent = header,
	})
	Corner(swatch, 6)
	Stroke(swatch, "Stroke", 1, 0)

	local obj = { Type = "Colorpicker", Value = color }
	local ui -- referensi UI popup, nil kalau popup tertutup

	local function apply(fire)
		color = Color3.fromHSV(h, s, v)
		obj.Value = color
		swatch.BackgroundColor3 = color
		if ui then
			ui.sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
			ui.svCursor.Position = UDim2.fromScale(s, 1 - v)
			ui.hueCursor.Position = UDim2.fromScale(h, 0.5)
			ui.preview.BackgroundColor3 = color
			if not ui.hex:IsFocused() then
				ui.hex.Text = ColorToHex(color)
			end
		end
		if fire then
			Fire(cfg.Callback, color)
		end
	end

	local function open()
		local popup = window:_OpenPopup(swatch, 236, 204, true)
		local scroll = self._scroll

		local sv = New("Frame", {
			Name = "SV",
			Position = UDim2.fromOffset(10, 10),
			Size = UDim2.fromOffset(216, 120),
			BorderSizePixel = 0,
			ZIndex = 52,
			Parent = popup,
		})
		Corner(sv, 6)
		local white = New("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 53,
			Parent = sv,
		})
		Corner(white, 6)
		New("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = white })
		local black = New("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
			ZIndex = 54,
			Parent = sv,
		})
		Corner(black, 6)
		New("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = black })
		local svCursor = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(12, 12),
			BackgroundTransparency = 1,
			ZIndex = 56,
			Parent = sv,
		})
		Corner(svCursor, 6)
		New("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = svCursor })
		local svHit = New("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 57,
			Parent = sv,
		})

		local hue = New("Frame", {
			Name = "Hue",
			Position = UDim2.fromOffset(10, 140),
			Size = UDim2.fromOffset(216, 12),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 52,
			Parent = popup,
		})
		Corner(hue, 6)
		New("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
				ColorSequenceKeypoint.new(1 / 6, Color3.fromRGB(255, 255, 0)),
				ColorSequenceKeypoint.new(2 / 6, Color3.fromRGB(0, 255, 0)),
				ColorSequenceKeypoint.new(3 / 6, Color3.fromRGB(0, 255, 255)),
				ColorSequenceKeypoint.new(4 / 6, Color3.fromRGB(0, 0, 255)),
				ColorSequenceKeypoint.new(5 / 6, Color3.fromRGB(255, 0, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
			}),
			Parent = hue,
		})
		local hueCursor = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(6, 18),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 54,
			Parent = hue,
		})
		Corner(hueCursor, 3)
		New("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1, Transparency = 0.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = hueCursor })
		local hueHit = New("TextButton", {
			Size = UDim2.new(1, 0, 1, 12),
			Position = UDim2.fromOffset(0, -6),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 57,
			Parent = hue,
		})

		local hex = New("TextBox", {
			Name = "Hex",
			Position = UDim2.fromOffset(10, 166),
			Size = UDim2.fromOffset(104, 28),
			Text = "",
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			ClearTextOnFocus = false,
			ZIndex = 52,
			Theme = { BackgroundColor3 = "Element", TextColor3 = "Text" },
			Parent = popup,
		})
		Corner(hex, 6)
		local preview = New("Frame", {
			Position = UDim2.fromOffset(122, 166),
			Size = UDim2.fromOffset(104, 28),
			ZIndex = 52,
			Parent = popup,
		})
		Corner(preview, 6)
		Stroke(preview, "Stroke", 1, 0)

		ui = { sv = sv, svCursor = svCursor, hueCursor = hueCursor, hex = hex, preview = preview }
		popup.Destroying:Connect(function()
			ui = nil
			if scroll then
				scroll.ScrollingEnabled = true
			end
		end)

		local function freeze()
			if scroll then
				scroll.ScrollingEnabled = false
			end
		end
		local function unfreeze()
			if scroll then
				scroll.ScrollingEnabled = true
			end
		end

		Drag(svHit, function(pos)
			s = math.clamp((pos.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
			v = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
			apply(true)
		end, freeze, unfreeze, true)
		Drag(hueHit, function(pos)
			h = math.clamp((pos.X - hue.AbsolutePosition.X) / math.max(hue.AbsoluteSize.X, 1), 0, 1)
			apply(true)
		end, freeze, unfreeze, true)

		hex.FocusLost:Connect(function()
			local parsed = HexToColor(hex.Text)
			if parsed then
				h, s, v = parsed:ToHSV()
				apply(true)
			else
				hex.Text = ColorToHex(color)
			end
		end)
		apply(false)
	end

	swatch.MouseButton1Click:Connect(open)

	function obj:Set(value, silent)
		if typeof(value) == "string" then
			value = HexToColor(value)
		end
		if typeof(value) ~= "Color3" then
			return
		end
		h, s, v = value:ToHSV()
		apply(not silent)
	end
	function obj:Get()
		return color
	end
	return Finish(self, cfg, obj, row, title, desc, lock)
end

