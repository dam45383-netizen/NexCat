	})
	Corner(tag, 8)
	Pad(tag, 0, 9, 0, 9)
	List(tag, 5, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	if cfg.Border then
		Stroke(tag, "Outline", 1, 0.8)
	end
	local textColor = Luminance(color) > 0.55 and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)
	local icon = MakeIcon(tag, cfg.Icon, 14, nil)
	if icon then
		icon.LayoutOrder = 1
	end
	local label = Text(tag, cfg.Title or "Tag", {
