    local dtitle = text(body, {Text = "", Position = UDim2.fromOffset(14, 13), Size = UDim2.new(1, -78, 0, 16), W = 3, TextSize = 11})
    local dcount = text(body, {Text = "", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 13), Size = UDim2.fromOffset(60, 16), TextXAlignment = XR, W = 2, TextSize = 10, TextColor3 = T.faint})
    local sbox, box = inputBox(body, {placeholder = "Search...", wrap = {Position = UDim2.fromOffset(10, 38), Size = UDim2.new(1, -20, 0, 30), BackgroundColor3 = T.field}})
    box.Position, box.Size = UDim2.fromOffset(32, 0), UDim2.new(1, -42, 1, 0)
    mkIcon(sbox, "search", 12, T.dim, {AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 11, 0.5, 0)})
    local list = new("ScrollingFrame", {Position = UDim2.fromOffset(6, 76), Size = UDim2.new(1, -12, 1, -84), BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 2, ScrollBarImageTransparency = 0.35, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y}, body)
    skin(list, "ScrollBarImageColor3", "accent")
    new("UIListLayout", {Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder}, list)
    new("UIPadding", {PaddingRight = UDim.new(0, 4)}, list) -- ruang untuk scrollbar
    local empty = text(list, {Text = "No results", Size = UDim2.new(1, 0, 0, 30), TextXAlignment = XC, W = 2, TextSize = 11, TextColor3 = T.faint, Visible = false, LayoutOrder = 999999})

    local function repaint()
        local n = 0
        for _, r in ipairs(rows) do
            r.paint()
            if spec and spec.isSel(r.name) then n = n + 1 end
        end
        if spec then dcount.Text = spec.multi and (n .. "/" .. #rows) or (#rows .. " options") end
    end
    function D.close()
        if not ov.Visible then return end
        spec = nil
        tok = tok + 1
        local my = tok
        play(ov, {BackgroundTransparency = 1}, 0.25)
        play(dr, {Position = UDim2.new(1, DW + 20, 0.5, 0)}, 0.25, QUINT, Enum.EasingDirection.In)
        task.delay(NOANIM and 0 or aT(0.27), function() if tok == my then ov.Visible = false end end)
    end
    function D.open(sp)
        spec = sp
        tok = tok + 1
        box.Text = ""
        dtitle.Text = string.upper(tostring(sp.title or ""))
        list.CanvasPosition = Vector2.new(0, 0)
        for _, r in ipairs(rows) do r.btn:Destroy() end
        rows = {}
        for i, n in ipairs(sp.options) do
            local name = tostring(n)
            local b = new("TextButton", {Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = T.navOn, BackgroundTransparency = 1, Text = "", AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = i}, list)
            corner(b, 8)
            local tx, cbox, cst, mark, tick, markIc, bar = 12, nil, nil, nil, nil, nil, nil
            if sp.multi then
                -- checkbox bergaya toggle: kotak bulat, garis tipis, isi aksen saat dipilih
                cbox = new("Frame", {AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = T.off, BorderSizePixel = 0}, b)
                corner(cbox, 5)
                cst = stroke(cbox, T.swLn, 1, 0)
                markIc = mkIcon(cbox, "check", 11, WHITE, {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Visible = false})
                mark = markIc.inst
                tx = 34
            else
                -- pilihan aktif: kotak gelap + garis putih di kiri (sama seperti tab aktif di sidebar) + centang di kanan
                bar = new("Frame", {AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), Size = UDim2.fromOffset(3, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0}, b)
                corner(bar, "full")
                tick = mkIcon(b, "check", 13, T.accent, {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Visible = false})
            end
            local sc = sp.swatch and sp.swatch(name)
            if sc then
                local dot = new("Frame", {AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, tx, 0.5, 0), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = sc, BorderSizePixel = 0}, b)
                corner(dot, "full")
                tx = tx + 20
            end
            local lb = text(b, {Text = name, Position = UDim2.fromOffset(tx, 0), Size = UDim2.new(1, -(tx + (tick and 30 or 8)), 1, 0), W = 2, TextSize = 11, TextColor3 = T.dim})
            local r = {btn = b, name = name}
            function r.paint()
                local on = sp.isSel(name)
                play(b, {BackgroundColor3 = T.navOn, BackgroundTransparency = on and 0 or 1}, 0.12)
                lb.TextColor3 = on and T.text or T.dim
                lb.FontFace = on and FONT[3] or FONT[2]
                if sp.multi then
                    play(cbox, {BackgroundColor3 = on and T.accent or T.off}, 0.12)
                    cst.Color = on and T.accent or T.swLn
                    mark.Visible = on and true or false
                    markIc.tint(onAcc(), 0)
                else
                    tick.tint(T.accent, 0)
                    tick.inst.Visible = on and true or false
                    play(bar, {Size = UDim2.fromOffset(3, on and 14 or 0)}, 0.15)
                end
            end
            b.MouseEnter:Connect(function()
                if not sp.isSel(name) then
                    lb.TextColor3 = T.text
                    play(b, {BackgroundColor3 = T.hover, BackgroundTransparency = 0.45}, 0.12)
                end
            end)
            b.MouseLeave:Connect(r.paint)
            b.MouseButton1Click:Connect(function()
                sp.pick(name)
                repaint()
                if not sp.multi then D.close() end
            end)
            rows[i] = r
            if not NOANIM and i <= 12 then -- 12 pilihan pertama muncul berurutan
                lb.TextTransparency = 1
                task.delay(aT(0.05 + i * 0.022), function() if rows[i] == r then play(lb, {TextTransparency = 0}, 0.24) end end)
            end
        end
        repaint()
        ov.Visible = true
        play(ov, {BackgroundTransparency = 0.5}, 0.25)
        dr.Position = UDim2.new(1, DW + 20, 0.5, 0)
        play(dr, {Position = UDim2.new(1, -14, 0.5, 0)}, 0.36)
    end
    box:GetPropertyChangedSignal("Text"):Connect(function()
        local q = box.Text:lower()
        local shown = 0
        for _, r in ipairs(rows) do
            local v = (q == "") or (r.name:lower():find(q, 1, true) ~= nil)
            r.btn.Visible = v
            if v then shown = shown + 1 end
        end
        empty.Visible = (shown == 0) and (#rows > 0) -- "No results" saat pencarian kosong
    end)
    ov.MouseButton1Click:Connect(D.close)
    return D
end

local function newCtx(hostF, rad)
    local c = {}
    function c.drawer()
        if not c.d then c.d = makeDrawer(hostF, rad) end
        return c.d
    end
    return c
end

