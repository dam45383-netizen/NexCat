--[[
	NexCat v1.1.0
	Library UI Roblox (Luau) dengan tampilan & API ala WindUI.

	Window, Tab, Section, Button, Toggle (Switch/Checkbox), Slider, Input, Dropdown,
	Keybind, Colorpicker, Paragraph, Code, Divider, Space, Dialog, Popup, Notify,
	Tag, Topbar Button, Theme, ConfigManager.

	Cara pakai:
		local NexCat = loadstring(readfile("NexCat.lua"))()   -- executor
		local NexCat = require(path.to.NexCat)                -- Roblox Studio (ModuleScript)

		local Window = NexCat:CreateWindow({
			Title = "NexCat",
			Author = "by kamu",
			AllowTitleEdit = false, -- default: nama window terkunci setelah dibuat
			Folder = "NexCat",
			Size = UDim2.fromOffset(580, 460),
			Topbar = { Height = 52, ButtonsType = "Default" }, -- atau "Mac"
		})
		local Tab = Window:Tab({ Title = "Main", Icon = "home" })
		Tab:Toggle({ Title = "Auto Farm", Desc = "Enable feature", Flag = "AutoFarm" })
		Tab:Checkbox({ Title = "Extra option", Flag = "ExtraOption" })

	Icon logo kucing disimpan sebagai base64 di bawah (LOGO_BASE64). Di executor yang punya
	writefile + getcustomasset, logo otomatis ditulis jadi PNG lalu dipakai sebagai gambar.
	Kalau tidak tersedia (misal Roblox Studio), otomatis pakai emoji sebagai cadangan.

	Config (folder NexCat, file "<Nama Game> Config.lua"):
		Element yang mau disimpan harus punya Flag, contoh: Tab:Toggle({ Title = "Auto Farm", Flag = "AutoFarm" })
		Window:SaveConfig() / Window:LoadConfig() / Window:DeleteConfig() / Window:GetConfigPath()
		Tab:ConfigSection() -> tombol Save / Load / Delete + toggle Auto Save siap pakai
		CreateWindow({ AutoLoad = true (default), AutoSave = false, AutoSaveInterval = 5 })
	Ukuran, posisi, dan UIScale window ikut masuk ke config. Nama file config diambil otomatis dari nama game.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")

local CoreGui
pcall(function()
	CoreGui = game:GetService("CoreGui")
end)

local LocalPlayer = Players.LocalPlayer

local NexCat = {
	Version = "1.1.0",
	Windows = {},
	TransparencyValue = 0.2,
	Fonts = {
		Regular = Enum.Font.BuilderSans,
		Medium = Enum.Font.BuilderSansMedium,
		Bold = Enum.Font.BuilderSansBold,
	},
	Creator = {},
}

local Container = {}
Container.__index = Container

local TabClass = setmetatable({}, { __index = Container })
TabClass.__index = TabClass

local WindowClass = {}
WindowClass.__index = function(self, key)
	if key == "Title" then
		return rawget(self, "_title")
	end
	return rawget(WindowClass, key)
end
WindowClass.__newindex = function(self, key, value)
	if key == "Title" then
		if rawget(self, "AllowTitleEdit") == true then
			rawset(self, "_title", tostring(value))
		end
		return
	end
	rawset(self, key, value)
end

local ConfigClass = {}
ConfigClass.__index = ConfigClass

