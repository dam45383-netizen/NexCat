local ANIM_SPEED, DEFAULT_STYLE = 1, QUINT -- kecepatan (1 = normal) & gaya easing bawaan; diatur di Settings > Appearance > Motion
local ANIM_STYLES = {Smooth = Enum.EasingStyle.Quint, Snappy = Enum.EasingStyle.Exponential, Soft = Enum.EasingStyle.Sine}
local function aT(t) return t / ANIM_SPEED end -- durasi setelah dipengaruhi kecepatan (untuk task.delay / task.wait yang mengikuti tween)
local function play(o, p, t, style, dir)
    if NOANIM then for k, v in pairs(p) do o[k] = v end return end
    if style == nil or style == QUINT then style = DEFAULT_STYLE end -- QUINT = "gaya bawaan"
    TweenService:Create(o, TweenInfo.new((t or 0.2) / ANIM_SPEED, style, dir or Enum.EasingDirection.Out), p):Play()
end
local function safe(fn, ...)
    if type(fn) ~= "function" then return end
    local ok, err = pcall(fn, ...)
    if not ok then warn("[SPHINX] " .. tostring(err)) end
end
local function copy(s) if setclipboard then setclipboard(s) elseif toclipboard then toclipboard(s) end end
local function toKey(n)
    local ok, v = pcall(function() return Enum.KeyCode[n] end)
    return ok and v or nil
end
local function textW(s, size)
    local ok, v = pcall(function() return TextService:GetTextSize(tostring(s), size, Enum.Font.Montserrat, Vector2.new(1000, 100)).X end)
    return ok and v or (#tostring(s) * size * 0.62)
