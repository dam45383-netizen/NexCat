-- pill untuk buka window saat disembunyikan: badge logo bulat + judul, border gradasi yang berputar,
-- efek hover / tekan, animasi muncul, dan tidak bisa di-drag keluar layar.
-- cfg: Title (false = hanya icon), Subtitle, Icon, Enabled, Draggable, OnlyMobile, Scale, Height,
--      CornerRadius (UDim), StrokeThickness, Color (ColorSequence), Animated (default true), Speed (detik per putaran)
function WindowClass:EditOpenButton(cfg)
	cfg = cfg or {}
	local window = self
	if self.OpenButton then
		self.OpenButton:Destroy()
		self.OpenButton = nil
	end
	local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	self._openEnabled = cfg.Enabled ~= false and (cfg.OnlyMobile ~= true or isMobile)

	local height = cfg.Height or 46
	local badgeSize = height - 12
	local baseScale = cfg.Scale or 1
	local showText = cfg.Title ~= false
	local hasSubtitle = showText and cfg.Subtitle ~= nil and cfg.Subtitle ~= ""

	local button = New("TextButton", {
		Name = "OpenButton",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = self._openPosition or UDim2.new(0.5, 0, 0, 14),
		Size = UDim2.fromOffset(0, height),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "",
		AutoButtonColor = false,
		Visible = (not self.Opened) and self._openEnabled,
		ZIndex = 30,
		Theme = { BackgroundColor3 = "Dialog" },
		Parent = self.Gui,
	})
	New("UICorner", { CornerRadius = cfg.CornerRadius or UDim.new(0, height / 2), Parent = button })

	-- border gradasi: warna ikut tema (Outline), bagian yang "memudar" lewat Transparency gradient.
	-- (ColorSequence tidak bisa di-tween saat ganti tema, jadi tidak di-bind ke tema)
	local stroke
	if cfg.Color then
		stroke = New("UIStroke", {
			Thickness = cfg.StrokeThickness or 2,
			Color = Color3.new(1, 1, 1),
			Transparency = 0.1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = button,
		})
	else
		stroke = Stroke(button, "Outline", cfg.StrokeThickness or 2, 0.1)
	end
	local gradient = New("UIGradient", {
		Rotation = 0,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.5, 0.75),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Parent = stroke,
	})
	if cfg.Color then
		gradient.Color = cfg.Color
	end

	local scale = New("UIScale", { Scale = baseScale, Parent = button })
	Pad(button, 0, showText and 18 or 6, 0, 6)
	List(button, 10, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)

	-- badge bulat berisi logo kucing (base64)
	local badge = New("Frame", {
		Name = "Badge",
		Size = UDim2.fromOffset(badgeSize, badgeSize),
		LayoutOrder = 1,
		Theme = { BackgroundColor3 = "Accent" },
		Parent = button,
	})
	New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = badge })
	Stroke(badge, "Outline", 1, 0.82)
	local icon = MakeIcon(badge, cfg.Icon or self._iconName, badgeSize - 12, "Text")
	if icon then
		icon.AnchorPoint = Vector2.new(0.5, 0.5)
		icon.Position = UDim2.fromScale(0.5, 0.5)
	end

	if showText then
		local textHolder = New("Frame", {
			Name = "Label",
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(0, badgeSize),
			AutomaticSize = Enum.AutomaticSize.X,
			LayoutOrder = 2,
			Parent = button,
		})
		List(textHolder, 0, Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
		Text(textHolder, tostring(cfg.Title or self.Title), {
			Size = UDim2.fromOffset(0, hasSubtitle and 18 or 22),
			AutomaticSize = Enum.AutomaticSize.X,
			TextSize = 15,
			Weight = "Bold",
			LayoutOrder = 1,
		})
		if hasSubtitle then
			Text(textHolder, tostring(cfg.Subtitle), {
				Size = UDim2.fromOffset(0, 14),
				AutomaticSize = Enum.AutomaticSize.X,
				Weight = "Regular",
				TextSize = 12,
				TextTransparency = 0.45,
				LayoutOrder = 2,
			})
		end
	end

	-- border berputar pelan (jalan hanya saat pill terlihat)
	local spin
	if cfg.Animated ~= false then
		spin = TweenService:Create(
			gradient,
			TweenInfo.new(cfg.Speed or 4, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1),
			{ Rotation = 360 }
		)
	end

	local hovering, pressing = false, false
	local function targetScale()
		if pressing then
			return baseScale * 0.94
		end
		if hovering then
			return baseScale * 1.05
		end
		return baseScale
	end
	local function refresh(duration)
		Tween(scale, { Scale = targetScale() }, duration or 0.15, Enum.EasingStyle.Quad)
	end

	button.MouseEnter:Connect(function()
		hovering = true
		refresh()
		Tween(stroke, { Transparency = 0 }, 0.15)
	end)
	button.MouseLeave:Connect(function()
		hovering = false
		refresh()
		Tween(stroke, { Transparency = 0.1 }, 0.15)
	end)

	local function onVisibleChanged()
		if button.Visible then
			scale.Scale = baseScale * 0.7
			Tween(scale, { Scale = targetScale() }, 0.4, Enum.EasingStyle.Back)
			if spin then
				spin:Play()
			end
		else
			hovering, pressing = false, false
			stroke.Transparency = 0.1
			if spin then
				spin:Pause()
			end
		end
	end
	button:GetPropertyChangedSignal("Visible"):Connect(onVisibleChanged)
	button.Destroying:Connect(function()
		if spin then
			spin:Cancel()
		end
	end)
	if button.Visible then
		onVisibleChanged()
	end

	-- drag (ditahan di dalam layar) + klik untuk membuka window
	local startPos, startOffset, startAbs, moved
	Drag(button, function(pos)
		if cfg.Draggable == false then
			return
		end
		local d = pos - startPos
		if d.Magnitude > 6 then
			moved = true
		end
		if moved then
			local viewport = window.Gui.AbsoluteSize
			local size = button.AbsoluteSize
			local topLeft = Vector2.new(
				math.clamp(startAbs.X + d.X, 0, math.max(0, viewport.X - size.X)),
				math.clamp(startAbs.Y + d.Y, 0, math.max(0, viewport.Y - size.Y))
			)
			local delta = topLeft - startAbs
			local position = UDim2.new(
				startOffset.X.Scale,
				startOffset.X.Offset + delta.X,
				startOffset.Y.Scale,
				startOffset.Y.Offset + delta.Y
			)
			button.Position = position
			window._openPosition = position
		end
	end, function(pos)
		startPos = pos
		startOffset = button.Position
		startAbs = button.AbsolutePosition
		moved = false
		pressing = true
		refresh(0.1)
	end, function()
		pressing = false
		refresh(0.15)
		if not moved then
			window:Show()
		end
	end)

	self.OpenButton = button
	return button
end

-- ---------- Config game: <Folder>/<Nama Game> Config.lua ----------
-- Hanya element yang punya Flag yang ikut disimpan.
function WindowClass:GetConfigPath()
	return self.ConfigManager.GameConfig:GetPath()
end

function WindowClass:SaveConfig()
	return self.ConfigManager.GameConfig:Save()
end

-- return: ok, jumlah pengaturan yang ketemu di UI (atau pesan error)
function WindowClass:LoadConfig()
	return self.ConfigManager.GameConfig:Load()
end

function WindowClass:DeleteConfig()
	return self.ConfigManager.GameConfig:Delete()
end

function WindowClass:HasConfig()
	return FSAvailable() and isfile(self:GetConfigPath())
end

-- simpan otomatis tiap `interval` detik, hanya kalau ada yang berubah
function WindowClass:SetAutoSave(enabled, interval)
	self.AutoSave = enabled and true or false
	if interval then
		self.AutoSaveInterval = math.max(1, tonumber(interval) or 5)
	end
	if self.AutoSave and not self._autoSaving then
		self._autoSaving = true
		task.spawn(function()
			while not self.Destroyed do
				task.wait(self.AutoSaveInterval)
				if self.AutoSave and self._configReady and not self.Destroyed then
					self:_AutoSaveStep()
				end
			end
		end)
	end
end

function WindowClass:_AutoSaveStep()
	local config = self.ConfigManager.GameConfig
	local data = config:_Collect()
	if next(data) == nil then
		return
	end
	if config._lastCollected and SameValue(config._lastCollected, data) then
		return
	end
	config:Save()
end

-- auto load: baca file config sekali, terapkan ke element yang sudah ada, dan ke element
-- yang dibuat belakangan (lihat Finish) selama `seconds` detik pertama.
function WindowClass:_PrimeConfig(seconds)
	local config = self.ConfigManager.GameConfig
	if self.AutoLoad and FSAvailable() then
		local path = config:GetPath()
		if not self.Destroyed and isfile(path) then
			local okRead, content = pcall(readfile, path)
			if okRead then
				local okJson, data = pcall(function()
					return HttpService:JSONDecode(content)
				end)
				if okJson and type(data) == "table" then
					self._pendingConfig = data
					config:_Apply(data, true)
					task.delay(seconds, function()
						if self._pendingConfig == data then
							self._pendingConfig = nil
						end
					end)
				end
			end
		end
	end
	self._configReady = true
end

