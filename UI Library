local function ParentFolder(path)
	return tostring(path):match("^(.*)[/\\][^/\\]*$")
end

local function GameConfigPath(window)
	return window.Folder .. "/" .. GetGameName() .. ConfigFileSuffix
end

function ConfigClass:Register(flag, element)
	self._extra[flag] = element
	return element
end

function ConfigClass:_Collect()
	local data = {}
	for flag, element in pairs(self.Window.Flags) do
		if element.Get then
			data[flag] = Encode(element:Get())
		end
	end
	for flag, element in pairs(self._extra) do
		if element.Get then
			data[flag] = Encode(element:Get())
		end
	end

	-- Metadata window disimpan bersama config, bukan sebagai Flag element.
	-- Saat fullscreen, simpan ukuran/posisi normal agar sesi berikutnya tidak ikut fullscreen.
	local window = self.Window
	local frame = window and window.Frame
	if frame and frame.Parent then
		local size = frame.Size
		local position = frame.Position
		if window.Fullscreen and window._restore then
			size = window._restore.Size or size
			position = window._restore.Position or position
		end
		local viewport = window.Gui and window.Gui.AbsoluteSize or ViewportSize()
		local width = size.X.Scale * viewport.X + size.X.Offset
		local height = size.Y.Scale * viewport.Y + size.Y.Offset
		data.__window = {
			Width = math.floor(width + 0.5),
			Height = math.floor(height + 0.5),
			Position = {
				XScale = position.X.Scale,
				XOffset = position.X.Offset,
				YScale = position.Y.Scale,
				YOffset = position.Y.Offset,
			},
			UIScale = window._baseScale or 1,
		}
	end
	return data
end

-- consume = true -> flag yang ketemu dihapus dari data (dipakai untuk auto load)
-- return: jumlah flag yang ketemu di UI
function ConfigClass:_Apply(data, consume)
	local matched = 0

	-- Key khusus tidak boleh diperlakukan sebagai Flag milik element.
	local windowState = data.__window
	if type(windowState) == "table" and self.Window and self.Window._ApplySavedState then
		if self.Window:_ApplySavedState(windowState) then
			matched = matched + 1
		end
		if consume then
			data.__window = nil
		end
	end

	for flag, raw in pairs(data) do
		if flag ~= "__window" then
			local element = self._extra[flag] or self.Window.Flags[flag]
			if ApplyValue(element, raw) then
				matched = matched + 1
				if consume then
					data[flag] = nil
				end
			end
		end
	end
	return matched
end

function ConfigClass:GetPath()
	if self.PathResolver then
		local ok, path = pcall(self.PathResolver)
		if ok and type(path) == "string" then
			return path
		end
	end
	return self.Path
end

-- Export/Import jalan di mana saja (termasuk Studio), Save/Load butuh filesystem executor
function ConfigClass:Export()
	return HttpService:JSONEncode(self:_Collect())
end

function ConfigClass:Import(json)
	local ok, data = pcall(function()
		return HttpService:JSONDecode(json)
	end)
	if not ok or type(data) ~= "table" then
		return false, "JSON tidak valid"
	end
	local matched = self:_Apply(data)
	self._lastCollected = self:_Collect()
	return true, matched
end

function ConfigClass:Save()
	if not FSAvailable() then
		return false, "Filesystem tidak tersedia di environment ini"
	end
	local path = self:GetPath()
	EnsureFolder(ParentFolder(path) or self.Manager.Path)
	local collected = self:_Collect()
	local data = collected
	-- gabung dengan isi file lama supaya flag yang belum dibuat (atau sudah dihapus) tidak hilang
	if self.KeepUnknown and isfile(path) then
		local okRead, old = pcall(function()
			return HttpService:JSONDecode(readfile(path))
		end)
		if okRead and type(old) == "table" then
			data = {}
			for flag, value in pairs(old) do
				data[flag] = value
			end
			for flag, value in pairs(collected) do
				data[flag] = value
			end
		end
	end
	local okEncode, json = pcall(function()
		return HttpService:JSONEncode(data)
	end)
	if not okEncode then
		return false, json
	end
	local ok, err = pcall(writefile, path, json)
	if ok then
		self._lastCollected = collected
	end
	return ok, err
end

function ConfigClass:Load()
	if not FSAvailable() then
		return false, "Filesystem tidak tersedia di environment ini"
	end
	local path = self:GetPath()
	if not isfile(path) then
		return false, "File config belum ada"
	end
	local ok, content = pcall(readfile, path)
	if not ok then
		return false, content
	end
	return self:Import(content)
end

function ConfigClass:Delete()
	local path = self:GetPath()
	if FSAvailable() and type(delfile) == "function" and isfile(path) then
		pcall(delfile, path)
		self._lastCollected = nil
		return true
	end
	return false
end

local function NewConfigManager(window)
	local manager = {
		Window = window,
		Path = window.Folder .. "/configs",
		Configs = {},
	}
	-- config utama per game: <Folder>/<Nama Game> Config.lua
	manager.GameConfig = setmetatable({
		Name = "Game",
		Window = window,
		Manager = manager,
		Path = window.Folder .. "/Config.lua",
		PathResolver = function()
			return GameConfigPath(window)
		end,
		KeepUnknown = true,
		_extra = {},
	}, ConfigClass)
	function manager:CreateConfig(name)
		name = tostring(name or "default"):gsub("[^%w_%-]", "_")
		local config = setmetatable({
			Name = name,
			Window = window,
			Manager = manager,
			Path = manager.Path .. "/" .. name .. ".json",
			_extra = {},
		}, ConfigClass)
		manager.Configs[name] = config
		return config
	end
	function manager:GetConfig(name)
		return manager.Configs[name]
	end
	function manager:AllConfigs()
		local names = {}
		if type(listfiles) == "function" and type(isfolder) == "function" and isfolder(manager.Path) then
			local ok, files = pcall(listfiles, manager.Path)
			if ok then
				for _, file in ipairs(files) do
					local name = tostring(file):match("([^/\\]+)%.json$")
					if name then
						names[#names + 1] = name
					end
				end
			end
		end
		return names
	end
	return manager
end

-- ============================================================
-- Tombol varian (Primary / Secondary / Tertiary / Danger)
-- dipakai Dialog, Popup, dan tombol di Paragraph
-- ============================================================

local Variants = {
	Primary = { bg = "Text", base = 0, hover = 0.12, fg = "Dialog" },
	Secondary = { bg = "Text", base = 0.9, hover = 0.84, fg = "Text" },
	Tertiary = { bg = "Text", base = 1, hover = 0.94, fg = "Text", stroke = true },
	Danger = { bg = "Danger", base = 0, hover = 0.12, fg = "White" },
}

local function VariantButton(parent, def, height, order)
	local style = Variants[def.Variant or "Secondary"] or Variants.Secondary
	local button = New("TextButton", {
		Size = UDim2.fromOffset(0, height),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = style.base,
		LayoutOrder = order or 1,
		ZIndex = 82,
		Theme = { BackgroundColor3 = style.bg },
		Parent = parent,
	})
	Corner(button, 9)
	Pad(button, 0, 14, 0, 14)
	List(button, 6, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	if style.stroke then
		Stroke(button, "Outline", 1, 0.8)
	end
	local icon = MakeIcon(button, def.Icon, 16, style.fg, true)
	if icon then
		icon.LayoutOrder = 1
		icon.ZIndex = 83
	end
	Text(button, def.Title or "OK", {
		Size = UDim2.fromOffset(0, height),
		AutomaticSize = Enum.AutomaticSize.X,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 2,
		ZIndex = 83,
		Theme = { TextColor3 = style.fg },
	})
	button.MouseEnter:Connect(function()
		Tween(button, { BackgroundTransparency = style.hover }, 0.12)
	end)
	button.MouseLeave:Connect(function()
		Tween(button, { BackgroundTransparency = style.base }, 0.12)
	end)
	return button
end

-- ============================================================
-- Dialog / Popup
-- host = Frame yang ditutupi overlay (window atau ScreenGui)
-- ============================================================

local function OpenDialog(host, cfg, radius, afterClose)
	cfg = cfg or {}
	local overlay = New("TextButton", {
		Name = "Dialog",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 80,
		Parent = host,
	})
	if radius then
		Corner(overlay, radius)
	end
	Tween(overlay, { BackgroundTransparency = 0.45 }, 0.2)

	local hostWidth = host.AbsoluteSize.X
	if hostWidth < 1 then
		hostWidth = ViewportSize().X
	end
	local width = math.min(cfg.Width or 320, hostWidth - 32)

	local card = New("Frame", {
		Name = "Card",
		Active = true,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(width, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 81,
		Theme = { BackgroundColor3 = "Dialog" },
		Parent = overlay,
	})
	Corner(card, 14)
	Stroke(card, "Outline", 1, 0.88)
	local scale = New("UIScale", { Scale = 0.9, Parent = card })
	Tween(scale, { Scale = 1 }, 0.25, Enum.EasingStyle.Back)

	local inner = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 82,
		Parent = card,
	})
	Pad(inner, 18)
	List(inner, 12)

	local head = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 24),
		LayoutOrder = 1,
		ZIndex = 82,
		Parent = inner,
	})
	List(head, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local icon = MakeIcon(head, cfg.Icon, 22, "Text", true)
	if icon then
		icon.LayoutOrder = 1
		icon.ZIndex = 83
	end
	Text(head, cfg.Title or "Dialog", {
		Size = UDim2.new(1, icon and -30 or 0, 1, 0),
		TextSize = 18,
		TextTruncate = Enum.TextTruncate.AtEnd,
		LayoutOrder = 2,
		ZIndex = 83,
	})

	if cfg.Content and cfg.Content ~= "" then
		Text(inner, cfg.Content, {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			Weight = "Regular",
			TextSize = 14,
			RichText = true,
			TextTransparency = 0.35,
			LayoutOrder = 2,
			ZIndex = 83,
		})
	end

	local buttonRow = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 38),
		LayoutOrder = 3,
		ZIndex = 82,
		Parent = inner,
	})
	List(buttonRow, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)

	local dialog = {}
	local closed = false
	function dialog:Close()
		if closed then
			return
		end
		closed = true
		Tween(overlay, { BackgroundTransparency = 1 }, 0.15)
		Tween(scale, { Scale = 0.92 }, 0.15)
		task.delay(0.16, function()
			overlay:Destroy()
			if afterClose then
				afterClose()
			end
		end)
	end

	local buttons = cfg.Buttons
	if not buttons or #buttons == 0 then
		buttons = { { Title = "OK", Variant = "Primary" } }
	end
	local count = #buttons
	for i, def in ipairs(buttons) do
		if def.Variant == nil then
			def.Variant = (i == count) and "Primary" or "Secondary"
		end
		local button = VariantButton(buttonRow, def, 38, i)
		button.AutomaticSize = Enum.AutomaticSize.None
		button.Size = UDim2.new(1 / count, -(8 * (count - 1)) / count, 1, 0)
		button.MouseButton1Click:Connect(function()
			Fire(def.Callback)
			if def.Keep ~= true then
				dialog:Close()
			end
		end)
	end

	if cfg.Dismissible then
		overlay.MouseButton1Click:Connect(function()
			dialog:Close()
		end)
	end
	return dialog
end

