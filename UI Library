function NexCat:CreateWindow(cfg)
	cfg = cfg or {}
	if cfg.Theme and self.Themes[cfg.Theme] then
		self:SetTheme(cfg.Theme)
	end

	local topbarCfg = type(cfg.Topbar) == "table" and cfg.Topbar or {}
	local topHeight = topbarCfg.Height or 52
	local mac = topbarCfg.ButtonsType == "Mac"
	local radius = cfg.Radius or 16

	local window = setmetatable({
		_title = tostring(cfg.Title or "NexCat"),
		Author = cfg.Author,
		AllowTitleEdit = cfg.AllowTitleEdit == true,
		Flags = {},
		Tabs = {},
		Opened = true,
		Destroyed = false,
		Fullscreen = false,
		Transparent = cfg.Transparent == true,
		Folder = cfg.Folder or "NexCat",
		ToggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift,
		Radius = radius,
		ElementRadius = cfg.NewElements and 15 or 12,
		TopbarButtons = {},
		_conns = {},
		_elements = {},
		_tags = {},
		_openCallbacks = {},
		_closeCallbacks = {},
		_destroyCallbacks = {},
		_iconName = cfg.Icon or "nexcat",
		_openEnabled = true,
		_baseScale = 1,
	}, WindowClass)
	window.ConfigManager = NewConfigManager(window)
	window.AutoLoad = cfg.AutoLoad ~= false
	window.AutoSave = false
	window.AutoSaveInterval = math.max(1, tonumber(cfg.AutoSaveInterval) or 5)
	window._configReady = false
	local viewport = ViewportSize()
	local size = cfg.Size or UDim2.fromOffset(580, 460)
	local minSize = cfg.MinSize or Vector2.new(560, 350)
	local maxSize = cfg.MaxSize or Vector2.new(850, 560)
	local maxW = math.max(160, math.min(maxSize.X, math.max(160, viewport.X - 24)))
	local maxH = math.max(180, math.min(maxSize.Y, math.max(180, viewport.Y - 24)))
	local minW = math.min(minSize.X, maxW)
	local minH = math.min(minSize.Y, maxH)
	local requestedWidth = size.X.Scale * viewport.X + size.X.Offset
	local requestedHeight = size.Y.Scale * viewport.Y + size.Y.Offset
	local width = math.floor(math.clamp(requestedWidth, minW, maxW) + 0.5)
	local height = math.floor(math.clamp(requestedHeight, minH, maxH) + 0.5)
	local sideWidth = math.min(cfg.SideBarWidth or 200, math.floor(width * 0.34))
	window._sizeLimits = {
		MinWidth = minW,
		MinHeight = minH,
		MaxWidth = maxSize.X,
		MaxHeight = maxSize.Y,
	}

	local gui = NewGui("NexCat", 100)
	window.Gui = gui

	local main = New("Frame", {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(width, height),
		BackgroundTransparency = window.Transparent and NexCat.TransparencyValue or 0,
		Theme = { BackgroundColor3 = "Background" },
		Parent = gui,
	})
	Corner(main, radius)
	Stroke(main, "Outline", 1, 0.9)
	window.Frame = main
	window._scale = New("UIScale", { Scale = 0.9, Parent = main })
	Tween(window._scale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)

	-- ---------- Topbar ----------
	local top = New("Frame", {
		Name = "Topbar",
		Size = UDim2.new(1, 0, 0, topHeight),
		BackgroundTransparency = 1,
		Parent = main,
	})
	local dragHandle = New("TextButton", {
		Name = "DragHandle",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = top,
	})
	New("Frame", {
		Name = "Line",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 1),
		BorderSizePixel = 0,
		BackgroundTransparency = 0.92,
		Theme = { BackgroundColor3 = "Outline" },
		Parent = top,
	})

	local titleLeft = mac and 90 or 18
	local titleHolder = New("Frame", {
		Name = "Title",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(titleLeft, 0),
		Size = UDim2.new(1, -(titleLeft + 140), 1, 0),
		Parent = top,
	})
	List(titleHolder, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	window._titleHolder = titleHolder

	local titleIcon = MakeIcon(titleHolder, cfg.Icon or "nexcat", cfg.IconSize or 22, "Text", cfg.IconThemed)
	if titleIcon then
		titleIcon.LayoutOrder = 1
	end
	window._titleLabel = Text(titleHolder, window.Title, {
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		TextSize = 16,
		LayoutOrder = 2,
	})
	window._authorLabel = Text(titleHolder, tostring(cfg.Author or ""), {
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		Weight = "Regular",
		TextSize = 13,
		TextTransparency = 0.4,
		Visible = cfg.Author ~= nil and cfg.Author ~= "",
		LayoutOrder = 3,
	})

	local controls = New("Frame", {
		Name = "Controls",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 0),
		Size = UDim2.fromOffset(0, topHeight),
		AutomaticSize = Enum.AutomaticSize.X,
		ZIndex = 3,
		Parent = top,
	})
	List(controls, 4, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)

	-- judul menyesuaikan lebar tombol topbar yang ditambah user
	local function layoutTitle()
		titleHolder.Size = UDim2.new(1, -(titleLeft + controls.AbsoluteSize.X + 24), 1, 0)
	end
	controls:GetPropertyChangedSignal("AbsoluteSize"):Connect(layoutTitle)

	local function ControlButton(order)
		local b = New("TextButton", {
			Size = UDim2.fromOffset(32, 32),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = order,
			ZIndex = 3,
			Theme = { BackgroundColor3 = "Text" },
			Parent = controls,
		})
		Corner(b, 9)
		b.MouseEnter:Connect(function()
			Tween(b, { BackgroundTransparency = 0.92 }, 0.12)
		end)
		b.MouseLeave:Connect(function()
			Tween(b, { BackgroundTransparency = 1 }, 0.12)
		end)
		return b
	end
	window._makeControl = ControlButton

	local function requestClose()
		if cfg.CloseConfirm == false then
			window:Destroy()
		else
			window:Dialog({
				Title = "Tutup window?",
				Content = "Interface ini akan dihapus dari layar.",
				Buttons = {
					{ Title = "Batal", Variant = "Secondary" },
					{
						Title = "Tutup",
						Variant = "Danger",
						Callback = function()
							window:Destroy()
						end,
					},
				},
			})
		end
	end

	if mac then
		local dots = New("Frame", {
			Name = "MacButtons",
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(18, 0),
			Size = UDim2.new(0, 58, 1, 0),
			ZIndex = 3,
			Parent = top,
		})
		List(dots, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
		local function dot(color, order, action)
			local d = New("TextButton", {
				Size = UDim2.fromOffset(14, 14),
				BackgroundColor3 = color,
				Text = "",
				AutoButtonColor = false,
				LayoutOrder = order,
				ZIndex = 4,
				Parent = dots,
			})
			Corner(d, 7)
			d.MouseButton1Click:Connect(action)
		end
		dot(Color3.fromRGB(255, 95, 87), 1, requestClose)
		dot(Color3.fromRGB(254, 188, 46), 2, function()
			window:Hide()
		end)
		dot(Color3.fromRGB(40, 200, 64), 3, function()
			window:ToggleFullscreen()
		end)
	else
		local minimize = ControlButton(997)
		local minLine = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(12, 2),
			BorderSizePixel = 0,
			Theme = { BackgroundColor3 = "Icon" },
			Parent = minimize,
		})
		Corner(minLine, 1)
		minimize.MouseButton1Click:Connect(function()
			window:Hide()
		end)

		local fullscreen = ControlButton(998)
		local fullBox = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(12, 12),
			BackgroundTransparency = 1,
			Parent = fullscreen,
		})
		Corner(fullBox, 3)
		Stroke(fullBox, "Icon", 1.6, 0)
		fullscreen.MouseButton1Click:Connect(function()
			window:ToggleFullscreen()
		end)

		local close = ControlButton(999)
		CloseGlyph(close, 14, "Icon")
		close.MouseButton1Click:Connect(requestClose)
	end
	layoutTitle()

	-- geser window
	local dragStart, dragOrigin
	if cfg.Draggable ~= false then
		Drag(dragHandle, function(pos)
			if window.Fullscreen then
				return
			end
			local d = pos - dragStart
			local vp = gui.AbsoluteSize
			local x = math.clamp(dragOrigin.X.Offset + d.X, -vp.X / 2, vp.X / 2)
			local y = math.clamp(dragOrigin.Y.Offset + d.Y, -vp.Y / 2, vp.Y / 2)
			main.Position = UDim2.new(dragOrigin.X.Scale, x, dragOrigin.Y.Scale, y)
		end, function(pos)
			dragStart = pos
			dragOrigin = main.Position
			window:_ClosePopup()
		end)
	end

	-- ---------- Body ----------
	local body = New("Frame", {
		Name = "Body",
		Position = UDim2.fromOffset(0, topHeight + 1),
		Size = UDim2.new(1, 0, 1, -(topHeight + 1)),
		BackgroundTransparency = 1,
		Parent = main,
	})

	local sidebar = New("Frame", {
		Name = "Sidebar",
		Size = UDim2.new(0, sideWidth, 1, 0),
		BackgroundTransparency = 1,
		Parent = body,
	})
	if cfg.HidePanelBackground == true then
		New("Frame", {
			Name = "Divider",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0),
			Size = UDim2.new(0, 1, 1, 0),
			BorderSizePixel = 0,
			BackgroundTransparency = 0.92,
			Theme = { BackgroundColor3 = "Outline" },
			Parent = sidebar,
		})
	end
	local sideInner = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = sidebar,
	})
	Pad(sideInner, 10, 4, 10, 10)
	List(sideInner, 8)

	local reserved = 0
	if cfg.HideSearchBar ~= true then
		reserved = reserved + 42
		local searchHolder = New("Frame", {
			Name = "Search",
			Size = UDim2.new(1, 0, 0, 34),
			LayoutOrder = 1,
			Parent = sideInner,
		})
		FieldStyle(searchHolder, 10)
		SearchGlyph(searchHolder, "Icon")
		local searchBox = New("TextBox", {
			Position = UDim2.fromOffset(32, 0),
			Size = UDim2.new(1, -40, 1, 0),
			BackgroundTransparency = 1,
			Text = "",
			PlaceholderText = "Cari tab...",
			ClearTextOnFocus = false,
			Font = FontOf("Regular"),
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			Theme = { TextColor3 = "Text", PlaceholderColor3 = "Placeholder" },
			Parent = searchHolder,
		})
		searchBox:GetPropertyChangedSignal("Text"):Connect(function()
			local q = searchBox.Text:lower()
			for _, tab in ipairs(window.Tabs) do
				tab.Button.Visible = q == "" or tab.Title:lower():find(q, 1, true) ~= nil
			end
		end)
	end

	local userCfg = cfg.User
	if userCfg == true then
		userCfg = {}
	end
	if type(userCfg) == "table" and userCfg.Enabled == false then
		userCfg = nil
	end
	if userCfg then
		reserved = reserved + 56
	end

	local tabList = New("ScrollingFrame", {
		Name = "Tabs",
		Size = UDim2.new(1, 0, 1, -reserved),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = cfg.ScrollBarEnabled and 2 or 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		LayoutOrder = 2,
		Parent = sideInner,
	})
	List(tabList, 4)
	window._tabList = tabList

	if userCfg then
		local card = New("Frame", {
			Name = "User",
			Size = UDim2.new(1, 0, 0, 48),
			LayoutOrder = 3,
			Parent = sideInner,
		})
		FieldStyle(card, 12)
		local avatar = New("ImageLabel", {
			Position = UDim2.fromOffset(7, 7),
			Size = UDim2.fromOffset(34, 34),
			Theme = { BackgroundColor3 = "Button" },
			Parent = card,
		})
		Corner(avatar, 17)
		local anonymous = userCfg.Anonymous == true
		local display = anonymous and "Guest" or (LocalPlayer and LocalPlayer.DisplayName or "Player")
		local username = anonymous and "@hidden" or (LocalPlayer and "@" .. LocalPlayer.Name or "")
		Text(card, display, {
			Position = UDim2.fromOffset(48, 6),
			Size = UDim2.new(1, -54, 0, 18),
			TextSize = 14,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		Text(card, username, {
			Position = UDim2.fromOffset(48, 24),
			Size = UDim2.new(1, -54, 0, 16),
			TextSize = 12,
			Weight = "Regular",
			TextTransparency = 0.4,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		if not anonymous and LocalPlayer then
			task.spawn(function()
				local ok, image = pcall(function()
					return Players:GetUserThumbnailAsync(
						LocalPlayer.UserId,
						Enum.ThumbnailType.HeadShot,
						Enum.ThumbnailSize.Size100x100
					)
				end)
				if ok and avatar.Parent then
					avatar.Image = image
				end
			end)
		end
		if type(userCfg.Callback) == "function" then
			local click = New("TextButton", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Text = "",
				ZIndex = 5,
				Parent = card,
			})
			click.MouseButton1Click:Connect(function()
				Fire(userCfg.Callback)
			end)
		end
	end

	-- panel konten (kotak sedikit lebih terang di kanan sidebar, seperti WindUI)
	local panel = New("Frame", {
		Name = "Content",
		Position = UDim2.fromOffset(sideWidth, 0),
		Size = UDim2.new(1, -(sideWidth + 8), 1, -8),
		BackgroundTransparency = cfg.HidePanelBackground == true and 1 or PanelTransparency,
		ClipsDescendants = true,
		Theme = { BackgroundColor3 = "Text" },
		Parent = body,
	})
	Corner(panel, math.max(radius - 6, 8))
	if cfg.HidePanelBackground ~= true then
		Stroke(panel, "Outline", 1, 0.94)
	end
	window._content = panel
	window._panel = panel

	-- ---------- Resize ----------
	if cfg.Resizable ~= false then
		local grip = New("TextButton", {
			Name = "ResizeGrip",
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.fromScale(1, 1),
			Size = UDim2.fromOffset(20, 20),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 20,
			Parent = main,
		})
		window._grip = grip
		for _, spec in ipairs({ { 9, 14 }, { 13, 8 } }) do
			local line = New("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(spec[1] + 1, spec[1] + 1),
				Size = UDim2.fromOffset(spec[2], 1),
				Rotation = -45,
				BorderSizePixel = 0,
				BackgroundTransparency = 0.3,
				ZIndex = 21,
				Theme = { BackgroundColor3 = "Icon" },
				Parent = grip,
			})
		end
		local startPos, startSize, startPosition
		Drag(grip, function(pos)
			local d = pos - startPos
			local vp = gui.AbsoluteSize
			local nw = math.clamp(startSize.X + d.X, minW, math.max(minW, math.min(maxSize.X, vp.X - 20)))
			local nh = math.clamp(startSize.Y + d.Y, minH, math.max(minH, math.min(maxSize.Y, vp.Y - 20)))
			main.Size = UDim2.fromOffset(nw, nh)
			main.Position = UDim2.new(
				startPosition.X.Scale,
				startPosition.X.Offset + (nw - startSize.X) / 2,
				startPosition.Y.Scale,
				startPosition.Y.Offset + (nh - startSize.Y) / 2
			)
		end, function(pos)
			startPos = pos
			startSize = Vector2.new(main.Size.X.Offset, main.Size.Y.Offset)
			startPosition = main.Position
			window:_ClosePopup()
		end)
	end

	-- ---------- Toggle key + open button ----------
	window:_Connect(UserInputService.InputBegan, function(input, processed)
		if not processed and window.ToggleKey and input.KeyCode == window.ToggleKey then
			window:Toggle()
		end
	end)

	local openCfg = type(cfg.OpenButton) == "table" and cfg.OpenButton or {}
	if cfg.OpenButton == false then
		openCfg.Enabled = false
	end
	window:EditOpenButton(openCfg)

	-- simpan sekali lagi saat window ditutup (kalau Auto Save aktif)
	window:OnClose(function()
		if window.AutoSave and window._configReady then
			window:_AutoSaveStep()
		end
	end)
	if cfg.AutoSave == true then
		window:SetAutoSave(true)
	end
	task.spawn(function()
		window:_PrimeConfig(tonumber(cfg.AutoLoadTime) or 20)
	end)

	NexCat.Windows[#NexCat.Windows + 1] = window
	return window
end

function NexCat:Destroy()
	for i = #self.Windows, 1, -1 do
		self.Windows[i]:Destroy()
	end
	if self._notifGui then
		self._notifGui:Destroy()
		self._notifGui = nil
	end
end

return NexCat
